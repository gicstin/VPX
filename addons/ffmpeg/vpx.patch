+bool VideoDecoder::_build_tempo(double p_tempo, int p_channels, int p_filter) {
+	tempo_graph = avfilter_graph_alloc();
+	char layout[64];
+	av_channel_layout_describe(&output_ch_layout, layout, sizeof(layout));
+	const String source_args = vformat("time_base=1/%d:sample_rate=%d:sample_fmt=flt:channel_layout=%s", output_sample_rate, output_sample_rate, String(layout));
+	PackedStringArray chain;
+	if (Math::abs(p_tempo - 1.0) > 0.001) {
+		chain.push_back(vformat("atempo=%f", p_tempo));
+	}
+	if (p_filter == 1) {
+		chain.push_back("acompressor=threshold=0.125:ratio=3:attack=10:release=300:makeup=2.5:knee=4");
+		chain.push_back("alimiter=limit=0.95:level=0");
+	} else if (p_filter == 2) {
+		chain.push_back("acompressor=threshold=0.03:ratio=8:attack=5:release=250:makeup=6:knee=6");
+		chain.push_back("alimiter=limit=0.9:level=0");
+	}
+	chain.push_back("aformat=sample_fmts=flt");
+	const String chain_text = String(",").join(chain);
+	const AVFilter *abuffer = avfilter_get_by_name("abuffer");
+	const AVFilter *abuffersink = avfilter_get_by_name("abuffersink");
+	bool ok = tempo_graph != nullptr && abuffer != nullptr && abuffersink != nullptr;
+	ok = ok && avfilter_graph_create_filter(&tempo_source, abuffer, "in", source_args.utf8().get_data(), nullptr, tempo_graph) >= 0;
+	ok = ok && avfilter_graph_create_filter(&tempo_sink, abuffersink, "out", nullptr, nullptr, tempo_graph) >= 0;
+	if (ok) {
+		AVFilterInOut *outputs = avfilter_inout_alloc();
+		AVFilterInOut *inputs = avfilter_inout_alloc();
+		outputs->name = av_strdup("in");
+		outputs->filter_ctx = tempo_source;
+		outputs->pad_idx = 0;
+		outputs->next = nullptr;
+		inputs->name = av_strdup("out");
+		inputs->filter_ctx = tempo_sink;
+		inputs->pad_idx = 0;
+		inputs->next = nullptr;
+		ok = avfilter_graph_parse_ptr(tempo_graph, chain_text.utf8().get_data(), &inputs, &outputs, nullptr) >= 0;
+		avfilter_inout_free(&inputs);
+		avfilter_inout_free(&outputs);
+	}
+	ok = ok && avfilter_graph_config(tempo_graph, nullptr) >= 0;
+	if (!ok) {
+		print_line(vformat("Audio filter chain '%s' unavailable for %d channels", chain_text, p_channels));
+		_free_tempo();
+		return false;
+	}
+	print_line(vformat("Audio filter chain: %s", chain_text));
+	tempo_frame = av_frame_alloc();
+	return true;
+}
