@@ -0,0 +1,624 @@
+#include "vpx_spatial_audio.h"
+
+#ifdef GDEXTENSION
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+static constexpr float HEAD_RADIUS = 0.0875f;
+static constexpr float SOUND_SPEED = 343.0f;
+static constexpr float SHADOW_MIN_ANGLE = 2.618f;
+static constexpr float PI_F = 3.14159265f;
+static constexpr float LFE_GAIN = 0.35f;
+static constexpr float AMBISONIC_DIRECTIVITY = 1.73f;
+static constexpr float REAR_CUTOFF = 3000.0f;
+static constexpr float REAR_DEPTH = 0.5f;
+static constexpr float VOICE_LOW = 200.0f;
+static constexpr float VOICE_HIGH = 5000.0f;
+static constexpr float LIMIT_KNEE = 0.8f;
+static constexpr float BROADBAND_ILD = 0.3f;
+
+float VpxSpatialAudio::Biquad::run(float p_x) {
+	const float y = b0 * p_x + z1;
+	z1 = b1 * p_x - a1 * y + z2;
+	z2 = b2 * p_x - a2 * y;
+	return y;
+}
+
+void VpxSpatialAudio::Biquad::set_lowpass(float p_frequency, float p_rate, float p_q) {
+	const float w = 2.0f * PI_F * p_frequency / p_rate;
+	const float alpha = std::sin(w) / (2.0f * p_q);
+	const float cosw = std::cos(w);
+	const float a0 = 1.0f + alpha;
+	b0 = (1.0f - cosw) * 0.5f / a0;
+	b1 = (1.0f - cosw) / a0;
+	b2 = b0;
+	a1 = -2.0f * cosw / a0;
+	a2 = (1.0f - alpha) / a0;
+}
+
+void VpxSpatialAudio::Biquad::set_highpass(float p_frequency, float p_rate, float p_q) {
+	const float w = 2.0f * PI_F * p_frequency / p_rate;
+	const float alpha = std::sin(w) / (2.0f * p_q);
+	const float cosw = std::cos(w);
+	const float a0 = 1.0f + alpha;
+	b0 = (1.0f + cosw) * 0.5f / a0;
+	b1 = -(1.0f + cosw) / a0;
+	b2 = b0;
+	a1 = -2.0f * cosw / a0;
+	a2 = (1.0f - alpha) / a0;
+}
+
+Vector3 VpxSpatialAudio::_direction(float p_azimuth_deg, float p_elevation_deg) {
+	const float az = p_azimuth_deg * PI_F / 180.0f;
+	const float el = p_elevation_deg * PI_F / 180.0f;
+	return Vector3(-std::sin(az) * std::cos(el), std::sin(el), -std::cos(az) * std::cos(el));
+}
+
+bool VpxSpatialAudio::_channel_direction(AVChannel p_channel, float &r_azimuth, float &r_elevation, bool &r_lfe) {
+	r_azimuth = 0.0f;
+	r_elevation = 0.0f;
+	r_lfe = false;
+	switch (p_channel) {
+		case AV_CHAN_FRONT_LEFT:
+		case AV_CHAN_STEREO_LEFT:
+			r_azimuth = 30.0f;
+			return true;
+		case AV_CHAN_FRONT_RIGHT:
+		case AV_CHAN_STEREO_RIGHT:
+			r_azimuth = -30.0f;
+			return true;
+		case AV_CHAN_FRONT_CENTER:
+			return true;
+		case AV_CHAN_LOW_FREQUENCY:
+		case AV_CHAN_LOW_FREQUENCY_2:
+			r_lfe = true;
+			return true;
+		case AV_CHAN_BACK_LEFT:
+			r_azimuth = 145.0f;
+			return true;
+		case AV_CHAN_BACK_RIGHT:
+			r_azimuth = -145.0f;
+			return true;
+		case AV_CHAN_FRONT_LEFT_OF_CENTER:
+			r_azimuth = 15.0f;
+			return true;
+		case AV_CHAN_FRONT_RIGHT_OF_CENTER:
+			r_azimuth = -15.0f;
+			return true;
+		case AV_CHAN_BACK_CENTER:
+			r_azimuth = 180.0f;
+			return true;
+		case AV_CHAN_SIDE_LEFT:
+			r_azimuth = 100.0f;
+			return true;
+		case AV_CHAN_SIDE_RIGHT:
+			r_azimuth = -100.0f;
+			return true;
+		case AV_CHAN_SIDE_SURROUND_LEFT:
+		case AV_CHAN_SURROUND_DIRECT_LEFT:
+			r_azimuth = 90.0f;
+			return true;
+		case AV_CHAN_SIDE_SURROUND_RIGHT:
+		case AV_CHAN_SURROUND_DIRECT_RIGHT:
+			r_azimuth = -90.0f;
+			return true;
+		case AV_CHAN_WIDE_LEFT:
+			r_azimuth = 60.0f;
+			return true;
+		case AV_CHAN_WIDE_RIGHT:
+			r_azimuth = -60.0f;
+			return true;
+		case AV_CHAN_TOP_CENTER:
+			r_elevation = 90.0f;
+			return true;
+		case AV_CHAN_TOP_FRONT_LEFT:
+			r_azimuth = 30.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_FRONT_CENTER:
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_FRONT_RIGHT:
+			r_azimuth = -30.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_BACK_LEFT:
+			r_azimuth = 145.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_BACK_CENTER:
+			r_azimuth = 180.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_BACK_RIGHT:
+			r_azimuth = -145.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_SIDE_LEFT:
+			r_azimuth = 90.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_SIDE_RIGHT:
+			r_azimuth = -90.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_SURROUND_LEFT:
+			r_azimuth = 110.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_TOP_SURROUND_RIGHT:
+			r_azimuth = -110.0f;
+			r_elevation = 45.0f;
+			return true;
+		case AV_CHAN_BOTTOM_FRONT_CENTER:
+			r_elevation = -30.0f;
+			return true;
+		case AV_CHAN_BOTTOM_FRONT_LEFT:
+			r_azimuth = 30.0f;
+			r_elevation = -30.0f;
+			return true;
+		case AV_CHAN_BOTTOM_FRONT_RIGHT:
+			r_azimuth = -30.0f;
+			r_elevation = -30.0f;
+			return true;
+		case AV_CHAN_BINAURAL_LEFT:
+			r_azimuth = 90.0f;
+			return false;
+		case AV_CHAN_BINAURAL_RIGHT:
+			r_azimuth = -90.0f;
+			return false;
+		default:
+			return false;
+	}
+}
+
+void VpxSpatialAudio::configure(const AVChannelLayout &p_layout, int p_sample_rate) {
+	input_channels = p_layout.nb_channels;
+	sample_rate = p_sample_rate > 0 ? p_sample_rate : 48000;
+	tau_k = HEAD_RADIUS * (float)sample_rate / SOUND_SPEED;
+	rear_coefficient = 1.0f - std::exp(-2.0f * PI_F * REAR_CUTOFF / (float)sample_rate);
+	char name[128] = {};
+	av_channel_layout_describe(&p_layout, name, sizeof(name));
+	layout_name = String(name);
+	for (int i = 0; i < 2; i++) {
+		voice_high[i].set_highpass(VOICE_LOW, (float)sample_rate, 0.707f);
+		voice_low[i].set_lowpass(VOICE_HIGH, (float)sample_rate, 0.707f);
+		voice_high[i].reset();
+		voice_low[i].reset();
+	}
+	_build_sources(p_layout);
+	listener_primed = false;
+	_update_mode();
+}
+
+void VpxSpatialAudio::_build_sources(const AVChannelLayout &p_layout) {
+	sources.clear();
+	ambisonic = false;
+	ambisonic_w = ambisonic_y = ambisonic_z = ambisonic_x = -1;
+	if (p_layout.order == AV_CHANNEL_ORDER_AMBISONIC || p_layout.order == AV_CHANNEL_ORDER_CUSTOM) {
+		for (int i = 0; i < p_layout.nb_channels; i++) {
+			const AVChannel channel = av_channel_layout_channel_from_index(&p_layout, i);
+			if (channel < AV_CHAN_AMBISONIC_BASE || channel > AV_CHAN_AMBISONIC_END) {
+				continue;
+			}
+			switch (channel - AV_CHAN_AMBISONIC_BASE) {
+				case 0:
+					ambisonic_w = i;
+					break;
+				case 1:
+					ambisonic_y = i;
+					break;
+				case 2:
+					ambisonic_z = i;
+					break;
+				case 3:
+					ambisonic_x = i;
+					break;
+				default:
+					break;
+			}
+		}
+		ambisonic = ambisonic_w >= 0 && ambisonic_y >= 0 && ambisonic_z >= 0 && ambisonic_x >= 0;
+	}
+	if (ambisonic) {
+		const float c = 1.0f / std::sqrt(3.0f);
+		for (int i = 0; i < AMBISONIC_SPEAKERS; i++) {
+			Source source;
+			source.direction = Vector3((i & 1) ? c : -c, (i & 2) ? c : -c, (i & 4) ? c : -c);
+			sources.push_back(source);
+		}
+		for (int i = 0; i < p_layout.nb_channels; i++) {
+			const AVChannel channel = av_channel_layout_channel_from_index(&p_layout, i);
+			if (channel >= AV_CHAN_AMBISONIC_BASE && channel <= AV_CHAN_AMBISONIC_END) {
+				continue;
+			}
+			Source head_locked;
+			head_locked.channel = i;
+			head_locked.lfe = true;
+			float azimuth = 0.0f;
+			float elevation = 0.0f;
+			bool lfe = false;
+			_channel_direction(channel, azimuth, elevation, lfe);
+			head_locked.left_gain = azimuth > 1.0f ? 1.0f : (azimuth < -1.0f ? 0.0f : 0.707f);
+			head_locked.right_gain = azimuth < -1.0f ? 1.0f : (azimuth > 1.0f ? 0.0f : 0.707f);
+			sources.push_back(head_locked);
+		}
+		return;
+	}
+	AVChannelLayout layout = {};
+	if (p_layout.order == AV_CHANNEL_ORDER_UNSPEC) {
+		av_channel_layout_default(&layout, p_layout.nb_channels);
+	} else {
+		av_channel_layout_copy(&layout, &p_layout);
+	}
+	float left_sum = 0.0f;
+	int spatial_count = 0;
+	for (int i = 0; i < layout.nb_channels; i++) {
+		const AVChannel channel = av_channel_layout_channel_from_index(&layout, i);
+		Source source;
+		source.channel = i;
+		float azimuth = 0.0f;
+		float elevation = 0.0f;
+		bool lfe = false;
+		if (!_channel_direction(channel, azimuth, elevation, lfe) && layout.nb_channels == 2) {
+			azimuth = i == 0 ? 30.0f : -30.0f;
+		}
+		source.lfe = lfe;
+		source.center = !lfe && std::fabs(azimuth) < 1.0f && elevation < 1.0f;
+		source.direction = _direction(azimuth, elevation);
+		const float rear = std::fabs(azimuth) > 91.0f ? 0.707f : 1.0f;
+		if (lfe) {
+			source.left_gain = LFE_GAIN;
+			source.right_gain = LFE_GAIN;
+		} else if (azimuth > 1.0f) {
+			source.left_gain = rear;
+		} else if (azimuth < -1.0f) {
+			source.right_gain = rear;
+		} else {
+			source.left_gain = 0.707f;
+			source.right_gain = 0.707f;
+		}
+		if (elevation > 1.0f) {
+			source.left_gain *= 0.707f;
+			source.right_gain *= 0.707f;
+		}
+		if (!lfe) {
+			left_sum += source.left_gain;
+			spatial_count++;
+		}
+		sources.push_back(source);
+	}
+	av_channel_layout_uninit(&layout);
+	scale = spatial_count > 2 ? 1.41f / std::max(left_sum, 1.0f) : 1.0f;
+}
+
+void VpxSpatialAudio::_update_mode() {
+	if (ambisonic) {
+		mode = spatial ? BINAURAL_AMBISONIC : AMBISONIC_STEREO;
+	} else if (input_channels <= 2) {
+		mode = PASSTHROUGH;
+	} else {
+		mode = spatial ? BINAURAL_SURROUND : DOWNMIX;
+	}
+}
+
+void VpxSpatialAudio::set_spatial(bool p_spatial) {
+	if (spatial == p_spatial) {
+		return;
+	}
+	spatial = p_spatial;
+	for (Source &source : sources) {
+		source.primed = false;
+	}
+	listener_primed = false;
+	_update_mode();
+}
+
+String VpxSpatialAudio::describe() const {
+	switch (mode) {
+		case BINAURAL_SURROUND:
+			return layout_name + String::utf8(" → binaural, head tracked");
+		case BINAURAL_AMBISONIC:
+			return String::utf8("ambisonic → binaural, head tracked");
+		case AMBISONIC_STEREO:
+			return String::utf8("ambisonic → stereo");
+		case DOWNMIX:
+			return layout_name + String::utf8(" → stereo");
+		default:
+			return layout_name;
+	}
+}
+
+VpxSpatialAudio::EarParams VpxSpatialAudio::_ear_params(const Vector3 &p_head_direction, int p_ear) const {
+	const Vector3 axis(p_ear == 0 ? -1.0f : 1.0f, 0.0f, 0.0f);
+	const float cos_theta = CLAMP((float)p_head_direction.dot(axis), -1.0f, 1.0f);
+	const float theta = std::acos(cos_theta);
+	EarParams params;
+	const float travel = theta < PI_F * 0.5f ? 1.0f - cos_theta : 1.0f + (theta - PI_F * 0.5f);
+	params.delay = (float)sample_rate * HEAD_RADIUS / SOUND_SPEED * travel;
+	params.alpha = std::max(0.1f, 0.75f + 0.65f * std::cos(std::min(theta, PI_F) * PI_F / SHADOW_MIN_ANGLE));
+	params.gain = 1.0f + BROADBAND_ILD * cos_theta;
+	return params;
+}
+
+float VpxSpatialAudio::_render_source(Source &p_source, float p_input, const EarParams p_from[2], const EarParams p_to[2], float p_back_from, float p_back_to, float p_t, float &r_right) {
+	const float back = p_back_from + (p_back_to - p_back_from) * p_t;
+	p_source.rear_state += rear_coefficient * (p_input - p_source.rear_state);
+	const float input = p_input + back * REAR_DEPTH * (p_source.rear_state - p_input);
+	p_source.ring[p_source.ring_pos] = input;
+	float out[2];
+	const float denominator = 1.0f + tau_k;
+	const float a1 = (1.0f - tau_k) / denominator;
+	for (int ear = 0; ear < 2; ear++) {
+		const float delay = p_from[ear].delay + (p_to[ear].delay - p_from[ear].delay) * p_t;
+		const float alpha = p_from[ear].alpha + (p_to[ear].alpha - p_from[ear].alpha) * p_t;
+		const float gain = p_from[ear].gain + (p_to[ear].gain - p_from[ear].gain) * p_t;
+		const int whole = (int)delay;
+		const float fraction = delay - (float)whole;
+		const int index_a = (p_source.ring_pos - whole + RING_SIZE * 2) % RING_SIZE;
+		const int index_b = (index_a - 1 + RING_SIZE) % RING_SIZE;
+		const float delayed = p_source.ring[index_a] + (p_source.ring[index_b] - p_source.ring[index_a]) * fraction;
+		const float b0 = (1.0f + alpha * tau_k) / denominator;
+		const float b1 = (1.0f - alpha * tau_k) / denominator;
+		const float y = b0 * delayed + b1 * p_source.shadow_x1[ear] - a1 * p_source.shadow_y1[ear];
+		p_source.shadow_x1[ear] = delayed;
+		p_source.shadow_y1[ear] = y;
+		out[ear] = y * gain;
+	}
+	p_source.ring_pos = (p_source.ring_pos + 1) % RING_SIZE;
+	r_right = out[1];
+	return out[0];
+}
+
+float VpxSpatialAudio::_voice(int p_channel, float p_mid) {
+	return voice_low[p_channel].run(voice_high[p_channel].run(p_mid));
+}
+
+float VpxSpatialAudio::_limit(float p_x) {
+	const float magnitude = std::fabs(p_x);
+	if (magnitude <= LIMIT_KNEE) {
+		return p_x;
+	}
+	const float headroom = 1.0f - LIMIT_KNEE;
+	const float limited = LIMIT_KNEE + headroom * std::tanh((magnitude - LIMIT_KNEE) / headroom);
+	return p_x < 0.0f ? -limited : limited;
+}
+
+void VpxSpatialAudio::process(const float *p_in, int p_frames, PackedFloat32Array &r_out) {
+	const int out_channels = get_output_channels();
+	r_out.resize((int64_t)p_frames * out_channels);
+	if (p_frames <= 0 || input_channels <= 0) {
+		return;
+	}
+	float *out = r_out.ptrw();
+	switch (mode) {
+		case PASSTHROUGH:
+			_process_passthrough(p_in, p_frames, out);
+			break;
+		case DOWNMIX:
+			_process_downmix(p_in, p_frames, out);
+			break;
+		case BINAURAL_SURROUND:
+			_process_binaural_surround(p_in, p_frames, out);
+			break;
+		case BINAURAL_AMBISONIC:
+			_process_binaural_ambisonic(p_in, p_frames, out);
+			break;
+		case AMBISONIC_STEREO:
+			_process_ambisonic_stereo(p_in, p_frames, out);
+			break;
+	}
+	_apply_seek_fade(out, p_frames, out_channels);
+}
+
+void VpxSpatialAudio::note_seek() {
+	for (Source &source : sources) {
+		memset(source.ring, 0, sizeof(source.ring));
+		source.ring_pos = 0;
+		source.shadow_x1[0] = source.shadow_x1[1] = 0.0f;
+		source.shadow_y1[0] = source.shadow_y1[1] = 0.0f;
+		source.rear_state = 0.0f;
+		source.primed = false;
+	}
+	for (int i = 0; i < 2; i++) {
+		voice_high[i].reset();
+		voice_low[i].reset();
+	}
+	listener_primed = false;
+	seek_fade_total = std::max(1, sample_rate / 33);
+	seek_fade_left = seek_fade_total;
+}
+
+void VpxSpatialAudio::_apply_seek_fade(float *p_out, int p_frames, int p_channels) {
+	if (seek_fade_left <= 0 || p_out == nullptr || p_frames <= 0 || p_channels <= 0) {
+		return;
+	}
+	for (int i = 0; i < p_frames; i++) {
+		const float gain = 1.0f - (float)seek_fade_left / (float)seek_fade_total;
+		for (int c = 0; c < p_channels; c++) {
+			p_out[i * p_channels + c] *= gain;
+		}
+		if (--seek_fade_left <= 0) {
+			return;
+		}
+	}
+}
+
+void VpxSpatialAudio::_process_passthrough(const float *p_in, int p_frames, float *p_out) {
+	if (input_channels == 1) {
+		for (int i = 0; i < p_frames; i++) {
+			const float sample = dialogue <= 0.001f ? p_in[i] : _limit(p_in[i] + dialogue * _voice(0, p_in[i]));
+			p_out[i * 2] = sample;
+			p_out[i * 2 + 1] = sample;
+		}
+		return;
+	}
+	if (dialogue <= 0.001f) {
+		memcpy(p_out, p_in, sizeof(float) * p_frames * 2);
+		return;
+	}
+	const float side_gain = 1.0f - 0.3f * dialogue;
+	for (int i = 0; i < p_frames; i++) {
+		const float left = p_in[i * 2];
+		const float right = p_in[i * 2 + 1];
+		float mid = (left + right) * 0.5f;
+		const float side = (left - right) * 0.5f * side_gain;
+		mid += dialogue * _voice(0, mid);
+		p_out[i * 2] = _limit((mid + side) * 0.85f);
+		p_out[i * 2 + 1] = _limit((mid - side) * 0.85f);
+	}
+}
+
+void VpxSpatialAudio::_process_downmix(const float *p_in, int p_frames, float *p_out) {
+	const float center_boost = 1.0f + dialogue;
+	const float other_cut = 1.0f - 0.3f * dialogue;
+	for (int i = 0; i < p_frames; i++) {
+		const float *frame = p_in + (int64_t)i * input_channels;
+		float left = 0.0f;
+		float right = 0.0f;
+		for (const Source &source : sources) {
+			const float gain = source.center ? center_boost : other_cut;
+			const float sample = frame[source.channel] * gain;
+			left += sample * source.left_gain;
+			right += sample * source.right_gain;
+		}
+		p_out[i * 2] = _limit(left * scale);
+		p_out[i * 2 + 1] = _limit(right * scale);
+	}
+}
+
+void VpxSpatialAudio::_process_binaural_surround(const float *p_in, int p_frames, float *p_out) {
+	const Basis from_listener = listener_primed ? applied_listener : listener;
+	const Basis to_listener = listener;
+	applied_listener = listener;
+	listener_primed = true;
+	const Basis from_inverse = from_listener.transposed();
+	const Basis to_inverse = to_listener.transposed();
+	const float center_boost = 1.0f + dialogue;
+	const float other_cut = 1.0f - 0.3f * dialogue;
+	int spatial_count = 0;
+	for (const Source &source : sources) {
+		spatial_count += source.lfe ? 0 : 1;
+	}
+	const float binaural_scale = 1.41f / (0.5f * (float)spatial_count + 0.5f);
+	struct Plan {
+		EarParams from[2];
+		EarParams to[2];
+		float back_from = 0.0f;
+		float back_to = 0.0f;
+	};
+	std::vector<Plan> plans(sources.size());
+	for (size_t s = 0; s < sources.size(); s++) {
+		Source &source = sources[s];
+		if (source.lfe) {
+			continue;
+		}
+		const Vector3 head_to = to_inverse.xform(source.direction).normalized();
+		const Vector3 head_from = source.primed ? from_inverse.xform(source.direction).normalized() : head_to;
+		for (int ear = 0; ear < 2; ear++) {
+			plans[s].from[ear] = _ear_params(head_from, ear);
+			plans[s].to[ear] = _ear_params(head_to, ear);
+		}
+		plans[s].back_from = CLAMP((float)head_from.z, 0.0f, 1.0f);
+		plans[s].back_to = CLAMP((float)head_to.z, 0.0f, 1.0f);
+		source.primed = true;
+	}
+	const float inverse_frames = 1.0f / (float)p_frames;
+	for (int i = 0; i < p_frames; i++) {
+		const float *frame = p_in + (int64_t)i * input_channels;
+		const float t = (float)(i + 1) * inverse_frames;
+		float left = 0.0f;
+		float right = 0.0f;
+		for (size_t s = 0; s < sources.size(); s++) {
+			Source &source = sources[s];
+			const float sample = frame[source.channel];
+			if (source.lfe) {
+				left += sample * LFE_GAIN;
+				right += sample * LFE_GAIN;
+				continue;
+			}
+			const float gain = source.center ? center_boost : other_cut;
+			float ear_right = 0.0f;
+			const float ear_left = _render_source(source, sample * gain, plans[s].from, plans[s].to, plans[s].back_from, plans[s].back_to, t, ear_right);
+			left += ear_left;
+			right += ear_right;
+		}
+		p_out[i * 2] = _limit(left * binaural_scale);
+		p_out[i * 2 + 1] = _limit(right * binaural_scale);
+	}
+}
+
+void VpxSpatialAudio::_process_binaural_ambisonic(const float *p_in, int p_frames, float *p_out) {
+	const Basis from_listener = listener_primed ? applied_listener : listener;
+	const Basis to_listener = listener;
+	applied_listener = listener;
+	listener_primed = true;
+	struct Plan {
+		EarParams ears[2];
+		float back = 0.0f;
+		Vector3 from_axis;
+		Vector3 to_axis;
+	};
+	std::vector<Plan> plans(sources.size());
+	for (size_t s = 0; s < sources.size(); s++) {
+		const Source &source = sources[s];
+		if (source.lfe) {
+			continue;
+		}
+		for (int ear = 0; ear < 2; ear++) {
+			plans[s].ears[ear] = _ear_params(source.direction, ear);
+		}
+		plans[s].back = CLAMP((float)source.direction.z, 0.0f, 1.0f);
+		plans[s].from_axis = from_listener.xform(source.direction);
+		plans[s].to_axis = to_listener.xform(source.direction);
+	}
+	const float speaker_scale = 1.0f / (float)AMBISONIC_SPEAKERS;
+	const float inverse_frames = 1.0f / (float)p_frames;
+	for (int i = 0; i < p_frames; i++) {
+		const float *frame = p_in + (int64_t)i * input_channels;
+		const float t = (float)(i + 1) * inverse_frames;
+		const float w = frame[ambisonic_w];
+		const Vector3 field(-frame[ambisonic_y], frame[ambisonic_z], -frame[ambisonic_x]);
+		float left = 0.0f;
+		float right = 0.0f;
+		for (size_t s = 0; s < sources.size(); s++) {
+			Source &source = sources[s];
+			if (source.lfe) {
+				const float sample = frame[source.channel];
+				left += sample * source.left_gain;
+				right += sample * source.right_gain;
+				continue;
+			}
+			const Vector3 axis = plans[s].from_axis + (plans[s].to_axis - plans[s].from_axis) * t;
+			const float feed = (w + AMBISONIC_DIRECTIVITY * (float)axis.dot(field)) * speaker_scale;
+			float ear_right = 0.0f;
+			const float ear_left = _render_source(source, feed, plans[s].ears, plans[s].ears, plans[s].back, plans[s].back, t, ear_right);
+			left += ear_left;
+			right += ear_right;
+		}
+		p_out[i * 2] = _limit(left * 1.2f);
+		p_out[i * 2 + 1] = _limit(right * 1.2f);
+	}
+}
+
+void VpxSpatialAudio::_process_ambisonic_stereo(const float *p_in, int p_frames, float *p_out) {
+	for (int i = 0; i < p_frames; i++) {
+		const float *frame = p_in + (int64_t)i * input_channels;
+		const float w = frame[ambisonic_w];
+		const float y = frame[ambisonic_y];
+		float left = 0.5f * (w + y);
+		float right = 0.5f * (w - y);
+		for (const Source &source : sources) {
+			if (source.lfe) {
+				left += frame[source.channel] * source.left_gain;
+				right += frame[source.channel] * source.right_gain;
+			}
+		}
+		p_out[i * 2] = _limit(left);
+		p_out[i * 2 + 1] = _limit(right);
+	}
+}
+
+#endif
