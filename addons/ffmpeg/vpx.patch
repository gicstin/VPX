+static const char *const PANORAMA_MIP_SHADER = R"(
+#version 450
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(r8, set = 0, binding = 0) uniform restrict readonly image2D src_image;
+layout(r8, set = 0, binding = 1) uniform restrict writeonly image2D dst_image;
+layout(push_constant, std430) uniform Params {
+	ivec4 sizes;
+	ivec4 axis;
+} params;
+const float PI = 3.14159265358979;
+const float LOBES = 3.0;
+const int TAPS = %d;
+float lanczos(float x) {
+	x = abs(x);
+	if (x < 1e-5) {
+		return 1.0;
+	}
+	if (x >= LOBES) {
+		return 0.0;
+	}
+	float px = PI * x;
+	return LOBES * sin(px) * sin(px / LOBES) / (px * px);
+}
+void main() {
+	ivec2 p = ivec2(gl_GlobalInvocationID.xy) + ivec2(0, params.axis.y);
+	ivec2 src_size = params.sizes.xy;
+	ivec2 dst_size = params.sizes.zw;
+	if (p.x >= dst_size.x || p.y >= dst_size.y) {
+		return;
+	}
+	bool horizontal = params.axis.x == 0;
+	float ratio = horizontal ? float(src_size.x) / float(dst_size.x) : float(src_size.y) / float(dst_size.y);
+	float center = (float(horizontal ? p.x : p.y) + 0.5) * ratio;
+	int first = int(floor(center - 0.5)) - (TAPS / 2 - 1);
+	int last = (horizontal ? src_size.x : src_size.y) - 1;
+	float sum = 0.0;
+	float weight = 0.0;
+	for (int i = 0; i < TAPS; i++) {
+		int s = first + i;
+		float w = lanczos((float(s) + 0.5 - center) / ratio);
+		ivec2 coord = horizontal ? ivec2(clamp(s, 0, last), p.y) : ivec2(p.x, clamp(s, 0, last));
+		sum += w * imageLoad(src_image, coord).r;
+		weight += w;
+	}
+	imageStore(dst_image, p, vec4(clamp(sum / weight, 0.0, 1.0)));
+}
+)";
+
+static const int64_t DEFAULT_MIP_BUDGET = 300000000;
