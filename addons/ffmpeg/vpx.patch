+int64_t VideoDecoder::_keyframe_ts_for_seek(int64_t p_target_ts, bool p_forward) const {
+	if (video_stream == nullptr) {
+		return p_target_ts;
+	}
+	const int flags = p_forward ? 0 : AVSEEK_FLAG_BACKWARD;
+	const int idx = av_index_search_timestamp(video_stream, p_target_ts, flags);
+	if (idx >= 0) {
+		const AVIndexEntry *entry = avformat_index_get_entry(video_stream, idx);
+		if (entry != nullptr) {
+			if (!p_forward && entry->timestamp <= p_target_ts) {
+				return entry->timestamp;
+			}
+			if (p_forward && entry->timestamp >= p_target_ts && (entry->timestamp - p_target_ts) * video_time_base_in_seconds * 1000.0 <= 1000.0) {
+				return entry->timestamp;
+			}
+		}
+	}
+	if (p_forward) {
+		const int previous = av_index_search_timestamp(video_stream, p_target_ts, AVSEEK_FLAG_BACKWARD);
+		if (previous >= 0) {
+			const AVIndexEntry *entry = avformat_index_get_entry(video_stream, previous);
+			if (entry != nullptr && entry->timestamp <= p_target_ts) {
+				return entry->timestamp;
+			}
+		}
+	}
+	return p_target_ts;
+}
+
+void VideoDecoder::_setup_seek_accelerator() {
+	if (hw_active || seek_codec != nullptr || !_path_uses_native_io(file_path) || video_stream == nullptr) {
+		return;
+	}
+	CharString path_utf8 = file_path.utf8();
+	AVDictionary *opts = _input_options();
+	const int open_result = avformat_open_input(&seek_fmt, path_utf8.get_data(), nullptr, &opts);
+	av_dict_free(&opts);
+	if (open_result < 0) {
+		seek_fmt = nullptr;
+		return;
+	}
+	if (avformat_find_stream_info(seek_fmt, nullptr) < 0) {
+		_free_seek_accelerator();
+		return;
+	}
+	seek_stream_index = video_stream->index;
+	if (seek_stream_index < 0 || seek_stream_index >= (int)seek_fmt->nb_streams) {
+		_free_seek_accelerator();
+		return;
+	}
+	const AVCodec *decoder = avcodec_find_decoder(seek_fmt->streams[seek_stream_index]->codecpar->codec_id);
+	if (decoder == nullptr) {
+		_free_seek_accelerator();
+		return;
+	}
+	bool can_vaapi = false;
+	for (int i = 0;; i++) {
+		const AVCodecHWConfig *config = avcodec_get_hw_config(decoder, i);
+		if (config == nullptr) {
+			break;
+		}
+		if ((config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && config->device_type == AV_HWDEVICE_TYPE_VAAPI) {
+			can_vaapi = true;
+			break;
+		}
+	}
+	if (!can_vaapi) {
+		_free_seek_accelerator();
+		return;
+	}
+	if (av_hwdevice_ctx_create(&seek_hw, AV_HWDEVICE_TYPE_VAAPI, nullptr, nullptr, 0) < 0) {
+		seek_hw = nullptr;
+		_free_seek_accelerator();
+		return;
+	}
+	seek_codec = avcodec_alloc_context3(decoder);
+	if (seek_codec == nullptr) {
+		_free_seek_accelerator();
+		return;
+	}
+	if (avcodec_parameters_to_context(seek_codec, seek_fmt->streams[seek_stream_index]->codecpar) < 0) {
+		_free_seek_accelerator();
+		return;
+	}
+	seek_codec->pkt_timebase = seek_fmt->streams[seek_stream_index]->time_base;
+	seek_codec->hw_device_ctx = av_buffer_ref(seek_hw);
+	seek_codec->get_format = hw_get_format;
+	seek_codec->extra_hw_frames = 4;
+	seek_codec->thread_count = 1;
+	seek_codec->flags |= AV_CODEC_FLAG_LOW_DELAY;
+	seek_codec->hwaccel_flags = AV_HWACCEL_FLAG_IGNORE_LEVEL;
+	if (avcodec_open2(seek_codec, decoder, nullptr) < 0) {
+		_free_seek_accelerator();
+		return;
+	}
+	print_line("VAAPI seek accelerator ready");
+}
+
+void VideoDecoder::_free_seek_accelerator() {
+	if (seek_codec != nullptr) {
+		avcodec_free_context(&seek_codec);
+	}
+	if (seek_hw != nullptr) {
+		av_buffer_unref(&seek_hw);
+	}
+	if (seek_fmt != nullptr) {
+		avformat_close_input(&seek_fmt);
+	}
+	seek_stream_index = -1;
+}
