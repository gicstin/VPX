+Ref<DecodedFrame> VideoDecoder::_decode_seek_keyframe(int64_t p_seek_ts, bool p_forward) {
+	if (seek_codec == nullptr || seek_fmt == nullptr) {
+		return Ref<DecodedFrame>();
+	}
+	avcodec_flush_buffers(seek_codec);
+	const int seek_flags = p_forward ? 0 : AVSEEK_FLAG_BACKWARD;
+	int seek_result = av_seek_frame(seek_fmt, seek_stream_index, p_seek_ts, seek_flags);
+	if (seek_result < 0) {
+		const int64_t min_ts = p_forward ? p_seek_ts : INT64_MIN;
+		const int64_t max_ts = p_forward ? INT64_MAX : p_seek_ts;
+		seek_result = avformat_seek_file(seek_fmt, seek_stream_index, min_ts, p_seek_ts, max_ts, 0);
+	}
+	if (seek_result < 0) {
+		return Ref<DecodedFrame>();
+	}
+	AVPacket *packet = av_packet_alloc();
+	AVFrame *frame = av_frame_alloc();
+	Ref<DecodedFrame> out;
+	const AVStream *st = seek_fmt->streams[seek_stream_index];
+	const int64_t start_ts = st->start_time != AV_NOPTS_VALUE ? st->start_time : 0;
+	const double tb = st->time_base.num / (double)st->time_base.den;
+	for (int i = 0; i < 128 && !out.is_valid(); i++) {
+		if (av_read_frame(seek_fmt, packet) < 0) {
+			break;
+		}
+		if (packet->stream_index != seek_stream_index) {
+			av_packet_unref(packet);
+			continue;
+		}
+		if (avcodec_send_packet(seek_codec, packet) < 0) {
+			av_packet_unref(packet);
+			continue;
+		}
+		av_packet_unref(packet);
+		while (avcodec_receive_frame(seek_codec, frame) == 0) {
+			int64_t ts = frame->best_effort_timestamp != AV_NOPTS_VALUE ? frame->best_effort_timestamp : frame->pts;
+			double frame_time = (ts - start_ts) * tb * 1000.0;
+			if (frame->hw_frames_ctx != nullptr) {
+				out = _transfer_hw_frame_direct(frame_time, frame);
+			}
+			av_frame_unref(frame);
+			if (out.is_valid()) {
+				break;
+			}
+		}
+	}
+	av_packet_free(&packet);
+	av_frame_free(&frame);
+	return out;
+}
+
+void VideoDecoder::_cache_put(const Ref<DecodedFrame> &p_frame) {
+	if (!p_frame.is_valid() || p_frame->is_dmabuf()) {
+		return;
+	}
+	const double t = p_frame->get_time();
+	for (int i = 0; i < kf_cache.size(); i++) {
+		if (Math::abs(kf_cache[i]->get_time() - t) < 750.0) {
+			return;
+		}
+	}
+	p_frame->materialize_strips();
+	p_frame->set_retain_planes(true);
+	kf_cache.push_back(p_frame);
+	while (kf_cache.size() > 8) {
+		Ref<DecodedFrame> old = kf_cache[0];
+		kf_cache.remove_at(0);
+		old->set_retain_planes(false);
+		return_frame(old);
+	}
+}
+
+Ref<DecodedFrame> VideoDecoder::_cache_get(double p_time_msec) const {
+	Ref<DecodedFrame> best;
+	double best_dist = 750.0;
+	for (int i = 0; i < kf_cache.size(); i++) {
+		const double dist = Math::abs(kf_cache[i]->get_time() - p_time_msec);
+		if (dist < best_dist) {
+			best_dist = dist;
+			best = kf_cache[i];
+		}
+	}
+	return best;
+}
