+bool VideoDecoder::_open_audio_stream(int p_index) {
+	if (audio_codec_context != nullptr) {
+		avcodec_free_context(&audio_codec_context);
+	}
+	has_audio = false;
+	audio_stream = nullptr;
+	audio_index.store(-1);
+	AVFormatContext *context = _audio_context();
+	if (p_index < 0 || context == nullptr || p_index >= (int)context->nb_streams) {
+		return p_index < 0;
+	}
+	AVStream *stream = context->streams[p_index];
+	if (stream->codecpar->codec_type != AVMEDIA_TYPE_AUDIO) {
+		return false;
+	}
+	const AVCodec *codec = avcodec_find_decoder(stream->codecpar->codec_id);
+	if (codec == nullptr) {
+		print_line(vformat("No decoder for audio stream %d (%s)", p_index, avcodec_get_name(stream->codecpar->codec_id)));
+		return false;
+	}
+	audio_codec_context = avcodec_alloc_context3(codec);
+	ERR_FAIL_COND_V_MSG(audio_codec_context == nullptr, false, vformat("Couldn't allocate audio codec context: %s", codec->name));
+	audio_codec_context->pkt_timebase = stream->time_base;
+	if (avcodec_parameters_to_context(audio_codec_context, stream->codecpar) < 0 || avcodec_open2(audio_codec_context, codec, nullptr) < 0) {
+		print_line(vformat("Couldn't open audio codec %s for stream %d", codec->name, p_index));
+		avcodec_free_context(&audio_codec_context);
+		return false;
+	}
+	if (output_sample_rate == 0) {
+		output_sample_rate = MIN(audio_codec_context->sample_rate, 96000);
+	}
+	av_channel_layout_uninit(&output_ch_layout);
+	if (audio_codec_context->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC) {
+		av_channel_layout_default(&output_ch_layout, audio_codec_context->ch_layout.nb_channels);
+	} else {
+		av_channel_layout_copy(&output_ch_layout, &audio_codec_context->ch_layout);
+	}
+	swr_free(&swr_context);
+	av_channel_layout_uninit(&swr_in_layout);
+	swr_in_format = -1;
+	swr_in_rate = 0;
+	audio_stream = stream;
+	audio_time_base_in_seconds = stream->time_base.num / (double)stream->time_base.den;
+	has_audio = true;
+	audio_index.store(p_index);
+	return true;
+}
