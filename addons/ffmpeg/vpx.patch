+
+bool VideoDecoder::_hw_decoder_exists() const {
+	const AVCodec *decoder = forced_video_codec;
+	if (!decoder && video_stream != nullptr) {
+		decoder = avcodec_find_decoder(video_stream->codecpar->codec_id);
+	}
+	if (decoder == nullptr) {
+		return false;
+	}
+	for (int i = 0;; i++) {
+		const AVCodecHWConfig *config = avcodec_get_hw_config(decoder, i);
+		if (config == nullptr) {
+			return false;
+		}
+		if (!(config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX)) {
+			continue;
+		}
+		if (config->device_type == AV_HWDEVICE_TYPE_VAAPI || config->device_type == AV_HWDEVICE_TYPE_VULKAN) {
+			return true;
+		}
+	}
+}
+
+void VideoDecoder::_switch_decode_backend(bool p_to_software) {
+	if (video_stream == nullptr) {
+		return;
+	}
+	const double resume_msec = MAX(playback_clock_msec.get(), last_decoded_frame_time.get());
+	force_software = p_to_software;
+	force_hardware = !p_to_software;
+	hw_active = false;
+	dmabuf_import = false;
+	dmabuf_reported = false;
+	saturated_since_usec = 0;
+
+	AVCodecParameters codec_params = *video_stream->codecpar;
+	const AVCodec *decoder = forced_video_codec;
+	if (!decoder) {
+		decoder = avcodec_find_decoder(video_stream->codecpar->codec_id);
+	}
+	if (decoder == nullptr) {
+		return;
+	}
+	if (video_codec_context != nullptr) {
+		pending_hw_frames.clear();
+		avcodec_free_context(&video_codec_context);
+	}
+	video_codec_context = avcodec_alloc_context3(decoder);
+	if (video_codec_context == nullptr) {
+		decoder_state = DecoderState::FAULTED;
+		return;
+	}
+	video_codec_context->pkt_timebase = video_stream->time_base;
+	if (avcodec_parameters_to_context(video_codec_context, &codec_params) < 0) {
+		decoder_state = DecoderState::FAULTED;
+		return;
+	}
+	video_codec_context->thread_count = vpx_software_thread_count();
+	video_codec_context->thread_type = FF_THREAD_FRAME | FF_THREAD_SLICE;
+#ifdef GDEXTENSION
+	video_codec_context->opaque = this;
+	video_codec_context->get_buffer2 = &VideoDecoder::_get_buffer2;
+#endif
+	_setup_hw_decoding(decoder);
+	if (hw_active) {
+		video_codec_context->thread_count = 1;
+	}
+	if (vpx_open_codec_low_priority(video_codec_context, decoder, _codec_options()) < 0) {
+		decoder_state = DecoderState::FAULTED;
+		return;
+	}
+	multiview_pending.unref();
+	multiview_pending_view = -1;
+	print_line(vformat("[VPX] switching to %s decoding: the current decoder cannot keep up", p_to_software ? "software" : "hardware"));
+	_apply_adaptive_tier(0);
+	tier_hold_usec[1] = 10000000ull;
+	tier_hold_usec[2] = 10000000ull;
+	tier_hold_until_usec[1] = 0;
+	tier_hold_until_usec[2] = 0;
+	lag_ema = 0.0;
+	seek(resume_msec);
+}
+
+bool VideoDecoder::_hw_decoding_wanted() const {
+	OS *os = OS::get_singleton();
+	if (force_software) {
+		return false;
+	}
+	if (os->has_environment("VPX_SOFTWARE_DECODE")) {
+		return false;
+	}
+	String mode = os->get_environment("VPX_DECODE").to_lower();
+	if (mode == "sw" || mode == "software") {
+		return false;
+	}
+	if (mode == "hw" || mode == "hardware") {
+		return true;
+	}
+	if (force_hardware) {
+		return true;
+	}
+	if (!os->has_environment("VPX_HW_MAX_PIXEL_RATE")) {
+		return true;
+	}
+	const double max_pixel_rate = os->get_environment("VPX_HW_MAX_PIXEL_RATE").to_float();
+	double fps = av_q2d(video_stream->avg_frame_rate);
+	if (fps <= 0.0) {
+		fps = av_q2d(video_stream->r_frame_rate);
+	}
+	if (fps <= 0.0) {
+		fps = 30.0;
+	}
+	double pixel_rate = double(video_stream->codecpar->width) * double(video_stream->codecpar->height) * fps;
+	if (pixel_rate > max_pixel_rate) {
+		print_line(vformat("Pixel rate %.0f exceeds hardware limit %.0f, using software decoding", pixel_rate, max_pixel_rate));
+		return false;
+	}
+	return true;
+}
+
+void VideoDecoder::_apply_adaptive_tier(int p_tier) {
+	if (video_codec_context == nullptr) {
+		return;
+	}
+	video_codec_context->skip_loop_filter = (AVDiscard)_loop_filter_discard();
+	video_codec_context->skip_frame = AVDISCARD_DEFAULT;
+	drop_ratio = p_tier >= 2 ? 0.25 : 0.0;
+	drop_accum = 0.0;
+	drop_window_lag = lag_ema;
+	drop_window_usec = 0;
+	drop_idle_since_usec = 0;
+	idle_window_usec = 0;
+	busy_window_usec = 0;
+	adaptive_tier.store(p_tier);
+	tier_applied_usec = vpx_ticks_usec();
+	lag_ema_at_settle = lag_ema;
+	late_frames = 0;
+	healthy_frames = 0;
+	severe_late_frames = 0;
+	tight_frames = 0;
+	window_frames = 0;
+}
+
+void VideoDecoder::_update_adaptive_tier(double p_frame_time) {
+	const double clock = playback_clock_msec.get();
+	const double fps = get_frame_rate();
+	const double period = 1000.0 / (fps > 1.0 ? fps : 60.0);
+	if (clock <= period) {
+		return;
+	}
+	const double lag = clock - p_frame_time;
+	lag_ema += (lag - lag_ema) * 0.05;
+	late_frames = lag_ema > -period ? late_frames + 1 : 0;
+	healthy_frames = lag_ema < -period * 4.0 ? healthy_frames + 1 : 0;
+	if (lag > MAX(period * 4.0, 100.0)) {
+		severe_late_frames++;
+	}
+	if (lag > -period) {
+		tight_frames++;
+	}
+	if (++window_frames >= 300) {
+		window_frames = 0;
+		severe_late_frames = 0;
+		tight_frames = 0;
+	}
+	const uint64_t now = vpx_ticks_usec();
+	const int tier = adaptive_tier.load();
+	if (tier >= 2) {
+		_update_drop_ratio(period, now);
+	}
+	const uint64_t settle_usec = tier_trial ? 2000000ull : 8000000ull;
+	const bool settled = now >= tier_applied_usec + settle_usec;
+	if (now >= tier_applied_usec + settle_usec / 2 && lag_ema_at_settle == 0.0) {
+		lag_ema_at_settle = lag_ema;
+	}
+	const bool drops_stopped = tier < 2 || (drop_ratio <= 0.0 && drop_idle_since_usec != 0 && now - drop_idle_since_usec >= 3000000ull);
+	bool escalate = false;
+	if (tier == 0) {
+		escalate = late_frames >= 30 || severe_late_frames >= 5 || tight_frames >= 60;
+	} else if (tier == 1) {
+		const bool recovering = lag_ema < lag_ema_at_settle - period * 2.0;
+		escalate = settled && late_frames >= 30 && lag_ema > period * 3.0 && !recovering;
+	}
+	if (escalate) {
+		const int next = tier + 1;
+		if (tier_left_usec[next] != 0 && now - tier_left_usec[next] < 30000000ull) {
+			tier_hold_usec[next] = MIN(tier_hold_usec[next] * 2, (uint64_t)300000000ull);
+		}
+		tier_hold_until_usec[next] = now + tier_hold_usec[next];
+		_apply_adaptive_tier(next);
+		lag_ema_at_settle = 0.0;
+		tier_trial = false;
+		print_line(vformat("[VPX] decoder %.0f ms behind: %s for at least %d s", lag_ema, next == 1 ? (loop_filter_skip_invisible ? "skipping the loop filter" : "skipping the loop filter on non-reference frames") : "dropping non-reference frames", (int)(tier_hold_usec[next] / 1000000ull)));
+	} else if (tier > 0 && drops_stopped && healthy_frames >= (int)(fps * 5.0) && now >= tier_hold_until_usec[tier] && (tier == 2 || tier_hold_usec[1] <= 20000000ull)) {
+		tier_left_usec[tier] = now;
+		_apply_adaptive_tier(tier - 1);
+		lag_ema_at_settle = 0.0;
+		tier_trial = true;
+		print_line(vformat("[VPX] decoder has headroom, %s", tier - 1 == 0 ? "decoding at full quality again" : "decoding all frames again"));
+	}
+}
+
+void VideoDecoder::_update_drop_ratio(double p_period, uint64_t p_now) {
+	if (drop_window_usec == 0) {
+		drop_window_usec = p_now;
+		return;
+	}
+	if (p_now - drop_window_usec < 750000ull) {
+		return;
+	}
+	const uint64_t measured = idle_window_usec + busy_window_usec;
+	const double idle_share = measured > 0 ? (double)idle_window_usec / (double)measured : 1.0;
+	idle_window_usec = 0;
+	busy_window_usec = 0;
+	drop_window_usec = p_now;
+	const bool recovering = lag_ema < p_period * 12.0 && lag_ema < drop_window_lag - p_period * 2.0;
+	drop_window_lag = lag_ema;
+	const double max_ratio = MAX(droppable_share * 0.95, 0.05);
+	const bool falling_behind = lag_ema > -p_period && !recovering;
+	if (falling_behind && lag_ema > p_period * 12.0 && drop_ratio < max_ratio * 0.6) {
+		drop_ratio = MIN(drop_ratio + 0.06, max_ratio * 0.6);
+	} else if (falling_behind) {
+		drop_ratio = MIN(drop_ratio + 0.02, max_ratio);
+	} else if (lag_ema < -p_period * 10.0 && idle_share > 0.10) {
+		drop_ratio = MAX(drop_ratio - 0.03, 0.0);
+	} else if (lag_ema < -p_period * 4.0) {
+		drop_ratio = MAX(drop_ratio - 0.01, 0.0);
+	}
+	if (drop_ratio > 0.0) {
+		drop_idle_since_usec = 0;
+	} else if (drop_idle_since_usec == 0) {
+		drop_idle_since_usec = p_now;
+	}
+	if (drop_ratio >= max_ratio - 0.001 && lag_ema > p_period * 12.0) {
+		if (saturated_since_usec == 0) {
+			saturated_since_usec = p_now;
+		} else if (p_now - saturated_since_usec > 5000000ull) {
+			const bool to_software = hw_active;
+			(to_software ? hardware_saturated : software_saturated) = true;
+			if (!(to_software ? software_saturated : hardware_saturated) && (to_software || _hw_decoder_exists()) && !multiview) {
+				saturated_since_usec = p_now;
+				backend_switch_request.set(to_software ? 1 : 2);
+			}
+		}
+	} else {
+		saturated_since_usec = 0;
+	}
+}
+
+void VideoDecoder::_report_stats() {
+	uint64_t now = vpx_ticks_usec();
+	if (stat_last_report_usec == 0) {
+		stat_last_report_usec = now;
+	}
+	if (now - stat_last_report_usec < 5000000 || stat_frames == 0) {
+		return;
+	}
+	double elapsed_s = (now - stat_last_report_usec) / 1000000.0;
+	decoded_frames_mutex->lock();
+	int pending = decoded_frames.size();
+	decoded_frames_mutex->unlock();
+	print_line(vformat("[VPX] decode %.1f fps | per frame: hw transfer %.2f ms, sw convert %.2f ms, unwrap %.2f ms | pending %d | tier %d | drop %.2f | lag %.0f ms",
+			stat_frames / elapsed_s, stat_transfer_usec / 1000.0 / stat_frames, stat_convert_usec / 1000.0 / stat_frames, stat_unwrap_usec / 1000.0 / stat_frames, pending, adaptive_tier.load(), drop_ratio, playback_clock_msec.get() - last_decoded_frame_time.get()));
+	stat_frames = 0;
+	stat_transfer_usec = 0;
+	stat_convert_usec = 0;
+	stat_unwrap_usec = 0;
+	stat_last_report_usec = now;
+}
+
+void VideoDecoder::_setup_hw_decoding(const AVCodec *p_decoder) {
+	if (!_hw_decoding_wanted()) {
+		return;
+	}
+	const bool zero_copy = _zero_copy_available();
+	AVHWDeviceType preferred[2] = { AV_HWDEVICE_TYPE_VULKAN, AV_HWDEVICE_TYPE_VAAPI };
+	if (zero_copy) {
+		preferred[0] = AV_HWDEVICE_TYPE_VAAPI;
+		preferred[1] = AV_HWDEVICE_TYPE_VULKAN;
+	}
+	const bool vulkan_disabled = OS::get_singleton()->has_environment("VPX_NO_VULKAN_DECODE");
+	for (AVHWDeviceType type : preferred) {
+		if (type == AV_HWDEVICE_TYPE_VULKAN && vulkan_disabled) {
+			continue;
+		}
+		bool supported = false;
+		for (int i = 0;; i++) {
+			const AVCodecHWConfig *config = avcodec_get_hw_config(p_decoder, i);
+			if (config == nullptr) {
+				break;
+			}
+			if ((config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && config->device_type == type) {
+				supported = true;
+				break;
+			}
+		}
+		if (!supported) {
+			continue;
+		}
+		if (hw_device_ctx != nullptr && hw_device_type != type) {
+			av_buffer_unref(&hw_device_ctx);
+		}
+		if (hw_device_ctx == nullptr) {
+			int create_result = av_hwdevice_ctx_create(&hw_device_ctx, type, nullptr, nullptr, 0);
+			if (create_result < 0) {
+				hw_device_ctx = nullptr;
+				print_line(vformat("%s unavailable: %s", av_hwdevice_get_type_name(type), ffmpeg_get_error_message(create_result)));
+				continue;
+			}
+			hw_device_type = type;
+		}
+		video_codec_context->hw_device_ctx = av_buffer_ref(hw_device_ctx);
+		video_codec_context->get_format = hw_get_format;
+		video_codec_context->extra_hw_frames = 8;
+		video_codec_context->hwaccel_flags = AV_HWACCEL_FLAG_IGNORE_LEVEL;
+		hw_active = true;
+		dmabuf_import = zero_copy && type == AV_HWDEVICE_TYPE_VAAPI;
+		if (dmabuf_import) {
+			const int64_t frame_bytes = MAX((int64_t)video_stream->codecpar->width * video_stream->codecpar->height * 3 / 2, (int64_t)1);
+			video_codec_context->extra_hw_frames = (int)CLAMP((int64_t)1024 * 1024 * 1024 / frame_bytes, (int64_t)10, (int64_t)24);
+		}
+		print_line(vformat("Using %s hardware decoding%s", av_hwdevice_get_type_name(type), dmabuf_import ? " (zero copy)" : ""));
+		return;
+	}
+	print_line("No hardware decoder available, using software decoding");
+}
+
+Ref<FFmpegFrame> VideoDecoder::_transfer_hw_frame(Ref<FFmpegFrame> p_frame) {
+	ZoneScopedN("Video decoder hw transfer");
+	Ref<FFmpegFrame> sw_frame;
+	sw_frame.instantiate();
+	AVFrame *dst = sw_frame->get_frame();
+	AVPixelFormat *formats = nullptr;
+	if (av_hwframe_transfer_get_formats(p_frame->get_frame()->hw_frames_ctx, AV_HWFRAME_TRANSFER_DIRECTION_FROM, &formats, 0) >= 0 && formats != nullptr) {
+		dst->format = formats[0];
+		dst->width = p_frame->get_frame()->width;
+		dst->height = p_frame->get_frame()->height;
+		av_freep(&formats);
+#ifdef GDEXTENSION
+		if (!_alloc_pinned_frame(dst, (dst->width + 63) / 64 * 64, (dst->height + 63) / 64 * 64)) {
+			dst->format = -1;
+			dst->width = 0;
+			dst->height = 0;
+		}
+#else
+		dst->format = -1;
+		dst->width = 0;
+		dst->height = 0;
+#endif
 	}
+	int transfer_result = av_hwframe_transfer_data(dst, p_frame->get_frame(), 0);
+	if (transfer_result < 0) {
+		print_line(vformat("Failed to transfer hardware frame: %s", ffmpeg_get_error_message(transfer_result)));
+		return Ref<FFmpegFrame>();
+	}
+	av_frame_copy_props(dst, p_frame->get_frame());
+	return sw_frame;
 }
 
