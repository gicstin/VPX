-	return yuv_images[p_plane_idx];
+#ifdef GDEXTENSION
+VpxPinnedBuffer *DecodedFrame::get_pinned_buffer() const {
+	if (!pinned_frame.is_valid() || pinned_frame->get_frame()->buf[0] == nullptr) {
+		return nullptr;
+	}
+	return (VpxPinnedBuffer *)av_buffer_get_opaque(pinned_frame->get_frame()->buf[0]);
+}
+#endif
+
+void DecodedFrame::materialize_strips() {
+	if (!pinned_frame.is_valid()) {
+		return;
+	}
+	const AVFrame *av_frame = pinned_frame->get_frame();
+	const int strip_bytes = 2 << 20;
+	for (int plane_i = 0; plane_i < pinned_plane_count; plane_i++) {
+		const int semiplanar_factor = (format == FFmpegFrameFormat::NV12 || format == FFmpegFrameFormat::P016) && plane_i == 1 ? 2 : 1;
+		const int row_bytes = (plane_i == 0 || plane_i == 3 ? frame_size.x : (frame_size.x + 1) / 2) * bytes_per_sample * semiplanar_factor;
+		const int rows = pinned_rows[plane_i];
+		const int strip_count = MAX(1, (int)(((int64_t)row_bytes * rows + strip_bytes - 1) / strip_bytes));
+		const int strip_rows = (rows + strip_count - 1) / strip_count;
+		Vector<PackedByteArray> strips;
+		for (int strip_i = 0; strip_i < strip_count; strip_i++) {
+			PackedByteArray strip;
+			strip.resize((int64_t)row_bytes * strip_rows);
+			const int first_row = strip_i * strip_rows;
+			const int strip_row_count = MIN(strip_rows, rows - first_row);
+			for (int y = 0; y < strip_row_count; y++) {
+				memcpy(strip.ptrw() + (size_t)y * row_bytes, av_frame->data[plane_i] + (size_t)(first_row + y) * av_frame->linesize[plane_i], row_bytes);
+			}
+			strips.push_back(strip);
+		}
+		set_yuv_strips(plane_i, strips, strip_rows);
+	}
+	clear_pinned();
+}
+
+int64_t DecodedFrame::get_yuv_bytes() const {
+	int64_t total = 0;
+	if (pinned_frame.is_valid()) {
+		for (int i = 0; i < pinned_plane_count; i++) {
+			total += (int64_t)pinned_linesizes[i] * pinned_rows[i];
+		}
+		return total;
+	}
+	for (size_t plane = 0; plane < std::size(yuv_strips); plane++) {
+		for (const PackedByteArray &strip : yuv_strips[plane]) {
+			total += strip.size();
+		}
+	}
+	return total;
 }
 
