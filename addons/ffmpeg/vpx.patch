+	static const int PLANE_COUNT = 3;
+	static const int CUBE_FACES = 6;
+	static const int GUTTER = 128;
+	static const int ALIGN = 256;
+	static const int MIN_TILES = 2;
+	static const int PRIME_FRAMES = 3;
+	static const int MIP_TAPS = 14;
+
+	struct PlaneGeometry {
+		int width = 0;
+		int height = 0;
+		int tile_width = 0;
+		int core = 0;
+		int gutter = 0;
+	};
+
+	struct LayerStore {
