+			image = Image::create_from_data(frame->width, frame->height, false, Image::FORMAT_RGBA8, bytes);
+		}
+		av_frame_free(&frame);
+		avcodec_free_context(&ctx);
+		if (image.is_valid() && image->get_width() > 0) {
+			return image;
+		}
+	}
+	return blank;
+}
