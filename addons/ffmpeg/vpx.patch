+
+static void *vpx_vulkan_library = nullptr;
+
+bool VpxVulkanDevice::disabled_by_environment() {
+	return OS::get_singleton()->has_environment("VPX_NO_GPU_UPLOAD");
+}
+
+template <typename T>
+static bool vpx_load_device_proc(const VpxVulkanDevice &p_vk, T &r_proc, const char *p_name) {
+	r_proc = (T)p_vk.vkGetDeviceProcAddr(p_vk.device, p_name);
+	if (r_proc == nullptr) {
+		r_proc = (T)p_vk.vkGetInstanceProcAddr(p_vk.instance, p_name);
+	}
+	return r_proc != nullptr;
+}
+
+template <typename T>
+static bool vpx_load_instance_proc(const VpxVulkanDevice &p_vk, T &r_proc, const char *p_name) {
+	r_proc = (T)p_vk.vkGetInstanceProcAddr(p_vk.instance, p_name);
+	return r_proc != nullptr;
+}
+
+static std::mutex vpx_device_mutex;
+static std::weak_ptr<VpxVulkanDevice> vpx_cached_device;
+static std::shared_ptr<VpxVulkanDevice> vpx_device_keepalive;
+
+static std::atomic<bool> vpx_dmabuf_broken{ false };
+
+bool vpx_dmabuf_import_broken() {
+	return vpx_dmabuf_broken.load();
+}
+
+void vpx_mark_dmabuf_import_broken() {
+	vpx_dmabuf_broken.store(true);
+}
+
+bool VpxVulkanDevice::dmabuf_import_supported() {
+	if (vpx_dmabuf_broken.load() || OS::get_singleton()->has_environment("VPX_NO_ZERO_COPY")) {
+		return false;
+	}
+	RenderingServer *server = RenderingServer::get_singleton();
+	std::shared_ptr<VpxVulkanDevice> vk = server != nullptr ? from_rendering_device(server->get_rendering_device()) : nullptr;
+	return vk && vk->dmabuf_import;
+}
+
+std::shared_ptr<VpxVulkanDevice> VpxVulkanDevice::from_rendering_device(RenderingDevice *p_rd) {
+	if (p_rd == nullptr || disabled_by_environment()) {
+		return nullptr;
+	}
+	std::lock_guard<std::mutex> device_lock(vpx_device_mutex);
+	if (std::shared_ptr<VpxVulkanDevice> cached = vpx_cached_device.lock()) {
+		return cached;
+	}
+#if !defined(__linux__) && !defined(_WIN32)
+	return nullptr;
+#endif
+	const String driver = ProjectSettings::get_singleton()->get_setting_with_override("rendering/rendering_device/driver");
+	if (!driver.is_empty() && !driver.to_lower().contains("vulkan")) {
+		print_line("GPU upload disabled: rendering driver is not Vulkan");
+		return nullptr;
+	}
+	auto vk = std::make_shared<VpxVulkanDevice>();
+	vk->device = (VkDevice)p_rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_VULKAN_DEVICE, RID(), 0);
+	vk->physical_device = (VkPhysicalDevice)p_rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_VULKAN_PHYSICAL_DEVICE, RID(), 0);
+	vk->instance = (VkInstance)p_rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_VULKAN_INSTANCE, RID(), 0);
+	vk->queue = (VkQueue)p_rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_VULKAN_QUEUE, RID(), 0);
+	vk->queue_family = (uint32_t)p_rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_VULKAN_QUEUE_FAMILY_INDEX, RID(), 0);
+	if (vk->device == VK_NULL_HANDLE || vk->physical_device == VK_NULL_HANDLE || vk->instance == VK_NULL_HANDLE || vk->queue == VK_NULL_HANDLE) {
+		print_line("GPU upload disabled: rendering device handles unavailable");
+		return nullptr;
+	}
+	if (vpx_vulkan_library == nullptr) {
+		vpx_vulkan_library = vpx_dynlib_open_vulkan();
+	}
+	if (vpx_vulkan_library == nullptr) {
+		print_line("GPU upload disabled: libvulkan not found");
+		return nullptr;
+	}
+	vk->vkGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)vpx_dynlib_symbol(vpx_vulkan_library, "vkGetInstanceProcAddr");
+	if (vk->vkGetInstanceProcAddr == nullptr) {
+		print_line("GPU upload disabled: vkGetInstanceProcAddr missing");
+		return nullptr;
+	}
+	bool ok = vpx_load_instance_proc(*vk, vk->vkGetDeviceProcAddr, "vkGetDeviceProcAddr");
+	ok = ok && vpx_load_instance_proc(*vk, vk->vkGetPhysicalDeviceMemoryProperties, "vkGetPhysicalDeviceMemoryProperties");
+	ok = ok && vpx_load_instance_proc(*vk, vk->vkGetPhysicalDeviceFormatProperties, "vkGetPhysicalDeviceFormatProperties");
+	ok = ok && vpx_load_instance_proc(*vk, vk->vkGetPhysicalDeviceProperties, "vkGetPhysicalDeviceProperties");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCreateBuffer, "vkCreateBuffer");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkDestroyBuffer, "vkDestroyBuffer");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkGetBufferMemoryRequirements, "vkGetBufferMemoryRequirements");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkAllocateMemory, "vkAllocateMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkFreeMemory, "vkFreeMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkBindBufferMemory, "vkBindBufferMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkMapMemory, "vkMapMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkUnmapMemory, "vkUnmapMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkFlushMappedMemoryRanges, "vkFlushMappedMemoryRanges");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCreateImage, "vkCreateImage");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkDestroyImage, "vkDestroyImage");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkGetImageMemoryRequirements, "vkGetImageMemoryRequirements");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkBindImageMemory, "vkBindImageMemory");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCreateCommandPool, "vkCreateCommandPool");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkDestroyCommandPool, "vkDestroyCommandPool");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkAllocateCommandBuffers, "vkAllocateCommandBuffers");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkResetCommandBuffer, "vkResetCommandBuffer");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkBeginCommandBuffer, "vkBeginCommandBuffer");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkEndCommandBuffer, "vkEndCommandBuffer");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCmdPipelineBarrier, "vkCmdPipelineBarrier");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCmdCopyBufferToImage, "vkCmdCopyBufferToImage");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkCreateFence, "vkCreateFence");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkDestroyFence, "vkDestroyFence");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkResetFences, "vkResetFences");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkGetFenceStatus, "vkGetFenceStatus");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkWaitForFences, "vkWaitForFences");
+	ok = ok && vpx_load_device_proc(*vk, vk->vkQueueSubmit, "vkQueueSubmit");
+	if (!ok) {
+		print_line("GPU upload disabled: Vulkan entry points missing");
+		return nullptr;
+	}
+	vk->copy_queue = vk->queue;
+	vk->copy_queue_family = vk->queue_family;
+	vpx_load_device_proc(*vk, vk->vkGetDeviceQueue, "vkGetDeviceQueue");
+	vpx_load_instance_proc(*vk, vk->vkGetPhysicalDeviceQueueFamilyProperties, "vkGetPhysicalDeviceQueueFamilyProperties");
+	if (vk->vkGetDeviceQueue != nullptr && vk->vkGetPhysicalDeviceQueueFamilyProperties != nullptr && !OS::get_singleton()->has_environment("VPX_NO_ASYNC_COPY")) {
+		uint32_t family_count = 0;
+		vk->vkGetPhysicalDeviceQueueFamilyProperties(vk->physical_device, &family_count, nullptr);
+		std::vector<VkQueueFamilyProperties> families(family_count);
+		vk->vkGetPhysicalDeviceQueueFamilyProperties(vk->physical_device, &family_count, families.data());
+		for (uint32_t family = 0; family < family_count; family++) {
+			const VkQueueFlags flags = families[family].queueFlags;
+			if (family == vk->queue_family || (flags & VK_QUEUE_GRAPHICS_BIT) || !(flags & (VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT))) {
+				continue;
+			}
+			VkQueue candidate = VK_NULL_HANDLE;
+			vk->vkGetDeviceQueue(vk->device, family, 0, &candidate);
+			if (candidate != VK_NULL_HANDLE) {
+				vk->copy_queue = candidate;
+				vk->copy_queue_family = family;
+				break;
+			}
+		}
+	}
+	print_line(vk->copy_queue_family != vk->queue_family ? vformat("GPU upload: async copies on queue family %d", (int)vk->copy_queue_family) : String("GPU upload: copies share the graphics queue"));
+
+	vpx_load_device_proc(*vk, vk->vkGetMemoryFdPropertiesKHR, "vkGetMemoryFdPropertiesKHR");
+	vpx_load_instance_proc(*vk, vk->vkGetPhysicalDeviceFormatProperties2, "vkGetPhysicalDeviceFormatProperties2");
+	vpx_load_device_proc(*vk, vk->vkGetImageDrmFormatModifierPropertiesEXT, "vkGetImageDrmFormatModifierPropertiesEXT");
+	std::vector<uint64_t> probe_modifiers;
+	vk->dmabuf_import = vk->vkGetMemoryFdPropertiesKHR != nullptr && vk->vkGetPhysicalDeviceFormatProperties2 != nullptr &&
+			vk->drm_modifiers_for(VK_FORMAT_R16_UNORM, probe_modifiers);
+	if (!vk->dmabuf_import) {
+		print_line("zero copy unavailable: this Vulkan device cannot import dma-buf images");
+	}
+
+	VkPhysicalDeviceProperties props = {};
+	vk->vkGetPhysicalDeviceProperties(vk->physical_device, &props);
+	vk->non_coherent_atom_size = MAX((VkDeviceSize)1, props.limits.nonCoherentAtomSize);
+
+	VkPhysicalDeviceMemoryProperties mem = {};
+	vk->vkGetPhysicalDeviceMemoryProperties(vk->physical_device, &mem);
+	const VkMemoryPropertyFlags host = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+	for (uint32_t i = 0; i < mem.memoryTypeCount; i++) {
+		const VkMemoryPropertyFlags flags = mem.memoryTypes[i].propertyFlags;
+		const bool device_local = flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+		if ((flags & host) == host && !device_local) {
+			if ((flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) && vk->host_cached_memory_type == UINT32_MAX) {
+				vk->host_cached_memory_type = i;
+			}
+			if (vk->host_memory_type == UINT32_MAX) {
+				vk->host_memory_type = i;
+			}
+		}
+	}
+	if (vk->host_cached_memory_type == UINT32_MAX) {
+		for (uint32_t i = 0; i < mem.memoryTypeCount; i++) {
+			const VkMemoryPropertyFlags flags = mem.memoryTypes[i].propertyFlags;
+			if ((flags & host) == host && (flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) {
+				vk->host_cached_memory_type = i;
+				break;
+			}
+		}
+	}
+	if (vk->host_cached_memory_type == UINT32_MAX) {
+		print_line("GPU upload disabled: no host-cached memory type");
+		return nullptr;
+	}
+	vpx_cached_device = vk;
+	vpx_device_keepalive = vk;
+	return vk;
+}
+
+uint32_t VpxVulkanDevice::find_memory_type(uint32_t p_type_bits, VkMemoryPropertyFlags p_required, VkMemoryPropertyFlags p_preferred) const {
+	VkPhysicalDeviceMemoryProperties mem = {};
+	vkGetPhysicalDeviceMemoryProperties(physical_device, &mem);
+	uint32_t fallback = UINT32_MAX;
+	for (uint32_t i = 0; i < mem.memoryTypeCount; i++) {
+		if (!(p_type_bits & (1u << i))) {
+			continue;
+		}
+		const VkMemoryPropertyFlags flags = mem.memoryTypes[i].propertyFlags;
+		if ((flags & p_required) != p_required) {
+			continue;
+		}
+		if ((flags & p_preferred) == p_preferred) {
+			return i;
+		}
+		if (fallback == UINT32_MAX) {
+			fallback = i;
+		}
+	}
+	return fallback;
+}
+
+struct VpxRetiredImage {
+	std::shared_ptr<VpxVulkanDevice> vk;
+	VkImage image;
+	VkDeviceMemory memory;
+	uint64_t retired_frame;
+};
+
+static std::mutex vpx_retired_mutex;
+static std::vector<VpxRetiredImage> vpx_retired_images;
+static const uint64_t VPX_RETIRED_IMAGE_FRAMES = 8;
+
+void vpx_retire_image(const std::shared_ptr<VpxVulkanDevice> &p_vk, VkImage p_image, VkDeviceMemory p_memory) {
+	if (!p_vk || (p_image == VK_NULL_HANDLE && p_memory == VK_NULL_HANDLE)) {
+		return;
+	}
+	std::lock_guard<std::mutex> lock(vpx_retired_mutex);
+	vpx_retired_images.push_back({ p_vk, p_image, p_memory, (uint64_t)Engine::get_singleton()->get_frames_drawn() });
+}
+
+void vpx_purge_retired_images(bool p_all) {
+	const uint64_t now = (uint64_t)Engine::get_singleton()->get_frames_drawn();
+	std::lock_guard<std::mutex> lock(vpx_retired_mutex);
+	for (size_t i = 0; i < vpx_retired_images.size();) {
+		VpxRetiredImage &retired = vpx_retired_images[i];
+		if (p_all || now >= retired.retired_frame + VPX_RETIRED_IMAGE_FRAMES) {
+			if (retired.image != VK_NULL_HANDLE) {
+				retired.vk->vkDestroyImage(retired.vk->device, retired.image, nullptr);
+			}
+			if (retired.memory != VK_NULL_HANDLE) {
+				retired.vk->vkFreeMemory(retired.vk->device, retired.memory, nullptr);
+			}
+			vpx_retired_images[i] = vpx_retired_images.back();
+			vpx_retired_images.pop_back();
+		} else {
+			i++;
+		}
+	}
+}
+
+bool VpxVulkanDevice::drm_modifiers_for(VkFormat p_format, std::vector<uint64_t> &r_modifiers) const {
+	r_modifiers.clear();
+	if (vkGetPhysicalDeviceFormatProperties2 == nullptr) {
+		return false;
+	}
+	VkDrmFormatModifierPropertiesListEXT list = {};
+	list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+	VkFormatProperties2 props = {};
+	props.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+	props.pNext = &list;
+	vkGetPhysicalDeviceFormatProperties2(physical_device, p_format, &props);
+	if (list.drmFormatModifierCount == 0) {
+		return false;
+	}
+	std::vector<VkDrmFormatModifierPropertiesEXT> entries(list.drmFormatModifierCount);
+	list.pDrmFormatModifierProperties = entries.data();
+	vkGetPhysicalDeviceFormatProperties2(physical_device, p_format, &props);
+	const VkFormatFeatureFlags needed = VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+	for (const VkDrmFormatModifierPropertiesEXT &entry : entries) {
+		if ((entry.drmFormatModifierTilingFeatures & needed) == needed) {
+			r_modifiers.push_back(entry.drmFormatModifier);
+		}
+	}
+	return !r_modifiers.empty();
+}
+
+bool VpxVulkanDevice::linear_format_supported(VkFormat p_format) const {
+	VkFormatProperties props = {};
+	vkGetPhysicalDeviceFormatProperties(physical_device, p_format, &props);
+	const VkFormatFeatureFlags needed = VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+	return (props.linearTilingFeatures & needed) == needed;
+}
+
+void VpxPinnedBuffer::flush() const {
+	if (coherent || !vk) {
+		return;
+	}
+	VkMappedMemoryRange range = {};
+	range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+	range.memory = memory;
+	range.offset = 0;
+	range.size = VK_WHOLE_SIZE;
+	vk->vkFlushMappedMemoryRanges(vk->device, 1, &range);
+}
+
+void VpxPinnedBuffer::release() {
+	std::shared_ptr<VpxPinnedPool> owner = pool.lock();
+	if (owner) {
+		owner->recycle(this);
+	} else {
+		delete this;
+	}
+}
+
+VpxPinnedBuffer::~VpxPinnedBuffer() {
+	if (!vk) {
+		return;
+	}
+	if (mapped != nullptr) {
+		vk->vkUnmapMemory(vk->device, memory);
+	}
+	if (buffer != VK_NULL_HANDLE) {
+		vk->vkDestroyBuffer(vk->device, buffer, nullptr);
+	}
+	if (memory != VK_NULL_HANDLE) {
+		vk->vkFreeMemory(vk->device, memory, nullptr);
+	}
+}
+
+VpxPinnedPool::VpxPinnedPool(const std::shared_ptr<VpxVulkanDevice> &p_vk) :
+		vk(p_vk) {
+	VkPhysicalDeviceMemoryProperties mem = {};
+	vk->vkGetPhysicalDeviceMemoryProperties(vk->physical_device, &mem);
+	const uint32_t heap = mem.memoryTypes[vk->host_cached_memory_type].heapIndex;
+	max_bytes = (int64_t)(mem.memoryHeaps[heap].size / 2);
+	if (OS::get_singleton()->has_environment("VPX_PINNED_MAX_MB")) {
+		max_bytes = (int64_t)OS::get_singleton()->get_environment("VPX_PINNED_MAX_MB").to_int() << 20;
+	}
+}
+
+VpxPinnedPool::~VpxPinnedPool() {
+	std::lock_guard<std::mutex> lock(mutex);
+	for (VpxPinnedBuffer *buffer : free_buffers) {
+		delete buffer;
+	}
+	free_buffers.clear();
+}
+
+VpxPinnedBuffer *VpxPinnedPool::acquire(VkDeviceSize p_size) {
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		for (size_t i = 0; i < free_buffers.size(); i++) {
+			if (free_buffers[i]->size == p_size) {
+				VpxPinnedBuffer *buffer = free_buffers[i];
+				free_buffers[i] = free_buffers.back();
+				free_buffers.pop_back();
+				live_buffers.insert(buffer);
+				live_count.fetch_add(1);
+				return buffer;
+			}
+		}
+		while (!free_buffers.empty()) {
+			VpxPinnedBuffer *stale = free_buffers.back();
+			free_buffers.pop_back();
+			live_bytes.fetch_sub((int64_t)stale->size);
+			delete stale;
+		}
+		if (live_bytes.load() + (int64_t)p_size > max_bytes) {
+			return nullptr;
+		}
+	}
+
+	VpxPinnedBuffer *buffer = new VpxPinnedBuffer();
+	buffer->vk = vk;
+	buffer->pool = weak_from_this();
+	buffer->size = p_size;
+
+	VkBufferCreateInfo buffer_info = {};
+	buffer_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+	buffer_info.size = p_size;
+	buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	buffer_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	if (vk->vkCreateBuffer(vk->device, &buffer_info, nullptr, &buffer->buffer) != VK_SUCCESS) {
+		delete buffer;
+		return nullptr;
+	}
+	VkMemoryRequirements requirements = {};
+	vk->vkGetBufferMemoryRequirements(vk->device, buffer->buffer, &requirements);
+	uint32_t memory_type = vk->find_memory_type(requirements.memoryTypeBits,
+			VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+			VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+	if (memory_type == UINT32_MAX) {
+		delete buffer;
+		return nullptr;
+	}
+	VkPhysicalDeviceMemoryProperties mem = {};
+	vk->vkGetPhysicalDeviceMemoryProperties(vk->physical_device, &mem);
+	buffer->coherent = mem.memoryTypes[memory_type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+
+	VkMemoryAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+	alloc_info.allocationSize = requirements.size;
+	alloc_info.memoryTypeIndex = memory_type;
+	if (vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &buffer->memory) != VK_SUCCESS) {
+		buffer->memory = VK_NULL_HANDLE;
+		delete buffer;
+		return nullptr;
+	}
+	if (vk->vkBindBufferMemory(vk->device, buffer->buffer, buffer->memory, 0) != VK_SUCCESS) {
+		delete buffer;
+		return nullptr;
+	}
+	void *mapped = nullptr;
+	if (vk->vkMapMemory(vk->device, buffer->memory, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS) {
+		delete buffer;
+		return nullptr;
+	}
+	buffer->mapped = (uint8_t *)mapped;
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		live_buffers.insert(buffer);
+		live_count.fetch_add(1);
+		live_bytes.fetch_add((int64_t)p_size);
+	}
+	return buffer;
+}
+
+void VpxPinnedPool::recycle(VpxPinnedBuffer *p_buffer) {
+	std::lock_guard<std::mutex> lock(mutex);
+	live_buffers.erase(p_buffer);
+	live_count.fetch_sub(1);
+	free_buffers.push_back(p_buffer);
+}
+
+bool VpxPinnedPool::owns(const void *p_buffer) {
+	if (p_buffer == nullptr) {
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(mutex);
+	return live_buffers.count((const VpxPinnedBuffer *)p_buffer) > 0;
+}
