+void VideoPlaneUploader::_upload_internal() {
+	ZoneScopedN("Video plane upload");
+	const bool debug_stats = OS::get_singleton()->has_environment("VPX_DEBUG");
+	const uint64_t call_start = debug_stats ? vpx_ticks_usec() : 0;
+	RD *rd = RS::get_singleton()->get_rendering_device();
+	const bool abandon = abandon_upload.exchange(false);
+#ifdef GDEXTENSION
+	if (abandon) {
+		_finish_gpu_inflight(true, false);
+	} else if (!uploading.is_valid()) {
+		_finish_gpu_inflight(false, true);
+	}
+#endif
+	if (abandon && uploading.is_valid()) {
+#ifdef GDEXTENSION
+		if (gpu_in_flight && gpu) {
+			gpu->wait(uploading_slot);
+			gpu_in_flight = false;
+		}
+#endif
+		queue_mutex->lock();
+		finished.push_back(uploading);
+		uploading.unref();
+		queued_count.store(queue.size());
+		queue_mutex->unlock();
+	}
+	const int64_t budget = budget_bytes.load();
+	int64_t uploaded = 0;
+	bool worked = false;
+	while (true) {
+#ifdef GDEXTENSION
+		if (!uploading.is_valid() && ((int)gpu_inflight.size() >= GPU_MAX_IN_FLIGHT || (gpu && gpu->is_valid() && gpu->acquire_slot(Engine::get_singleton()->get_frames_drawn()) < 0))) {
+			break;
+		}
+#endif
+		if (!uploading.is_valid() && !_begin_next_frame()) {
+			break;
+		}
+#ifdef GDEXTENSION
+		if (uploading->is_dmabuf()) {
+			_finish_frame();
+			stat_gpu_frames++;
+			worked = true;
+			continue;
+		}
+		if (gpu_in_flight) {
+			GpuInFlight entry;
+			entry.frame = uploading;
+			entry.set = uploading_set;
+			entry.slot = uploading_slot;
+			for (int i = 0; i < PLANE_COUNT; i++) {
+				entry.specs[i] = uploading_specs[i];
+			}
+			gpu_inflight.push_back(entry);
+			inflight_count.store(gpu_inflight.size());
+			uploading.unref();
+			gpu_in_flight = false;
+			queue_mutex->lock();
+			queued_count.store(queue.size());
+			queue_mutex->unlock();
+			worked = true;
+			continue;
+		}
+#endif
+		PlaneTexture *set = planes[uploading_set];
+		bool paused_for_budget = false;
+		while (uploading_plane < PLANE_COUNT) {
+			const PlaneSpec &spec = uploading_specs[uploading_plane];
+			if (!spec.used || !set[uploading_plane].mip_rid.is_valid() || uploading_strip >= spec.strips) {
+				uploading_plane++;
+				uploading_strip = 0;
+				continue;
+			}
+			if (uploaded >= budget) {
+				paused_for_budget = true;
+				break;
+			}
+			const Vector<PackedByteArray> &strips = uploading->get_yuv_strips(uploading_plane);
+			const PackedByteArray &data = strips[uploading_strip];
+			const int64_t expected = (int64_t)spec.size.x * spec.strip_rows * uploading->get_bytes_per_sample() * (spec.format & 1 ? 2 : 1);
+			if (data.size() == expected) {
+				const uint64_t update_start = debug_stats ? vpx_ticks_usec() : 0;
+				rd->texture_update(set[uploading_plane].upload_rid, uploading_strip, data);
+				if (debug_stats) {
+					stat_upload_usec += vpx_ticks_usec() - update_start;
+				}
+			} else {
+				ERR_PRINT(vformat("Plane %d strip %d size mismatch: %d != %d", uploading_plane, uploading_strip, (int)data.size(), (int)expected));
+			}
+			uploaded += data.size();
+			uploading_strip++;
+			worked = true;
+		}
+		if (paused_for_budget) {
+			break;
+		}
+		_finish_frame();
+		worked = true;
+	}
+	if (debug_stats && worked) {
+		stat_total_usec += vpx_ticks_usec() - call_start;
+		stat_calls++;
+		if (stat_frames >= 300) {
+#ifdef GDEXTENSION
+			print_line(vformat("[VPX] upload: %.2f ms per call (%.1f calls per frame), texture_update %.2f ms per frame, gpu dma frames %d (submit %.2f ms per frame)", stat_total_usec / 1000.0 / MAX(stat_calls, (uint64_t)1), (double)stat_calls / stat_frames, stat_upload_usec / 1000.0 / stat_frames, (int)stat_gpu_frames, stat_gpu_submit_usec / 1000.0 / MAX(stat_gpu_frames, (uint64_t)1)));
+			stat_gpu_frames = 0;
+			stat_gpu_submit_usec = 0;
+#else
+			print_line(vformat("[VPX] upload: %.2f ms per call (%.1f calls per frame), texture_update %.2f ms per frame", stat_total_usec / 1000.0 / MAX(stat_calls, (uint64_t)1), (double)stat_calls / stat_frames, stat_upload_usec / 1000.0 / stat_frames));
+#endif
+			stat_upload_usec = 0;
+			stat_total_usec = 0;
+			stat_calls = 0;
+			stat_frames = 0;
+		}
+	}
 }
 
