+#ifdef GDEXTENSION
+
+#include "vpx_vulkan.h"
+#include "gdextension_build/gdex_print.h"
+
+#include <godot_cpp/classes/engine.hpp>
+#include <godot_cpp/classes/os.hpp>
+#include <godot_cpp/classes/project_settings.hpp>
