+#ifndef VPX_SUBTITLES_H
+#define VPX_SUBTITLES_H
+
+#ifdef GDEXTENSION
+
+#include <godot_cpp/classes/image.hpp>
+#include <godot_cpp/classes/ref_counted.hpp>
+#include <godot_cpp/variant/array.hpp>
+#include <godot_cpp/variant/dictionary.hpp>
+#include <godot_cpp/variant/rect2.hpp>
+#include <godot_cpp/variant/string.hpp>
+
+extern "C" {
+#include "libavcodec/avcodec.h"
+#include "libavformat/avformat.h"
+}
+
+#include <mutex>
+#include <vector>
+
+using namespace godot;
+
+class VPXSubtitles : public RefCounted {
+	GDCLASS(VPXSubtitles, RefCounted);
+
+public:
+	static constexpr double OPEN_END_MSEC = 1.0e9;
+	static constexpr int MAX_BITMAP_EVENTS = 48;
+	static constexpr int KEEP_BITMAP_EVENTS = 32;
+
+	struct Event {
+		int id = 0;
+		double start = 0.0;
+		double end = 0.0;
+		String text;
+		bool ass = false;
+		Ref<Image> image;
+		Rect2 rect;
+	};
+
+private:
+	mutable std::mutex mutex;
+	std::vector<Event> events;
+	int next_id = 1;
+	String codec_name;
+	String error;
+
+	void _insert(Event &p_event);
+	void _close_open(double p_start);
+	void _prune_bitmaps(double p_clock);
+	static Dictionary _to_dictionary(const Event &p_event);
+
+protected:
+	static void _bind_methods();
+
+public:
+	void clear();
+	void add_subtitle(const AVSubtitle &p_subtitle, double p_base_msec, int p_canvas_width, int p_canvas_height, double p_clock_msec);
+	void set_codec_name(const String &p_name) { codec_name = p_name; }
+
+	bool load_file(const String &p_path);
+	Array get_active(double p_time_msec) const;
+	Array get_events() const;
+	int get_event_count() const;
+	String get_codec_name() const { return codec_name; }
+	String get_error() const { return error; }
+
+	static Dictionary stream_info(const AVStream *p_stream);
+	static PackedByteArray normalize_text_encoding(const PackedByteArray &p_bytes);
+};
+
+#endif
+
+#endif
