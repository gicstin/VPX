+void DecodedFrame::set_pinned(const Ref<FFmpegFrame> &p_frame, int p_plane_count, const int64_t *p_offsets, const int *p_linesizes, const int *p_rows) {
+	pinned_frame = p_frame;
+	pinned_plane_count = p_plane_count;
+	for (int i = 0; i < 4; i++) {
+		pinned_offsets[i] = i < p_plane_count ? p_offsets[i] : 0;
+		pinned_linesizes[i] = i < p_plane_count ? p_linesizes[i] : 0;
+		pinned_rows[i] = i < p_plane_count ? p_rows[i] : 0;
+	}
+}
+
+void DecodedFrame::set_dmabuf(const Ref<FFmpegFrame> &p_drm, const Ref<FFmpegFrame> &p_source, int p_plane_count) {
+	drm_frame = p_drm;
+	drm_source = p_source;
+	drm_plane_count = p_plane_count;
+}
+
+void DecodedFrame::clear_dmabuf() {
+	drm_frame.unref();
