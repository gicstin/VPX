+
+void VideoDecoder::_check_frame_metadata(const AVFrame *p_frame) {
+	metadata_mutex->lock();
+	const AVDictionaryEntry *stereo_mode = av_dict_get(p_frame->metadata, "stereo_mode", nullptr, 0);
+	if (stereo_mode != nullptr && !stream_metadata.has("stereo_mode")) {
+		stream_metadata["stereo_mode"] = String::utf8(stereo_mode->value);
+	}
+	const AVFrameSideData *spherical = av_frame_get_side_data(p_frame, AV_FRAME_DATA_SPHERICAL);
+	if (spherical != nullptr && spherical->size >= sizeof(AVSphericalMapping) && !stream_metadata.has("spherical")) {
+		stream_metadata["spherical"] = vpx_spherical_to_dictionary((const AVSphericalMapping *)spherical->data);
+	}
+	const AVFrameSideData *stereo = av_frame_get_side_data(p_frame, AV_FRAME_DATA_STEREO3D);
+	if (stereo != nullptr && stereo->size >= sizeof(AVStereo3D) && !stream_metadata.has("stereo3d") && av_frame_get_side_data(p_frame, AV_FRAME_DATA_VIEW_ID) == nullptr) {
+		const AVStereo3D *packing = (const AVStereo3D *)stereo->data;
+		if (packing->type != AV_STEREO3D_2D) {
+			stream_metadata["stereo3d"] = vpx_stereo_to_dictionary(packing);
+		}
+	}
+	metadata_mutex->unlock();
+}
+
+Dictionary VideoDecoder::get_stream_metadata() const {
+	metadata_mutex->lock();
+	Dictionary copy = stream_metadata.duplicate(true);
+	metadata_mutex->unlock();
+	return copy;
+}
