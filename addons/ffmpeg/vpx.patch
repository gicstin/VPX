+Dictionary FFmpegVideoStreamPlayback::get_frame_info() const {
+	Dictionary info;
+	if (!decoder.is_valid()) {
+		return info;
+	}
+	const VideoColorInfo color = decoder->get_color_info();
+	const Vector2i size = decoder->get_size();
+	FFmpegFrameFormat format = decoder->get_frame_format();
+	if (uploader.is_valid() && uploader->get_frame_serial() > 0) {
+		format = uploader->get_last_format();
+	}
+	info["width"] = size.x;
+	info["height"] = size.y;
+	info["frame_rate"] = decoder->get_frame_rate();
+	info["hardware"] = decoder->is_hardware_decoding();
+	info["format"] = (int)format;
+	info["semiplanar"] = format == FFmpegFrameFormat::NV12 || format == FFmpegFrameFormat::P016;
+	info["has_alpha"] = format == FFmpegFrameFormat::YUVA420P;
+	info["bytes_per_sample"] = uploader.is_valid() ? uploader->get_last_bytes_per_sample() : 1;
+	info["sample_scale"] = uploader.is_valid() ? uploader->get_last_sample_scale() : 1.0f;
+	info["color_space"] = color.space;
+	info["color_range"] = color.range;
+	info["color_transfer"] = color.transfer;
+	info["color_primaries"] = color.primaries;
+	info["chroma_location"] = color.chroma_location;
+	info["frame_serial"] = get_frame_serial();
+	info["adaptive_tier"] = decoder->get_adaptive_tier();
+	return info;
+}
