+#ifndef VPX_SPATIAL_AUDIO_H
+#define VPX_SPATIAL_AUDIO_H
+
+#ifdef GDEXTENSION
+
+#include <godot_cpp/variant/basis.hpp>
+#include <godot_cpp/variant/packed_float32_array.hpp>
+#include <godot_cpp/variant/string.hpp>
+#include <godot_cpp/variant/vector3.hpp>
+
+extern "C" {
+#include "libavutil/channel_layout.h"
+}
+
+#include <vector>
+
+using namespace godot;
+
+class VpxSpatialAudio {
+public:
+	enum Mode {
+		PASSTHROUGH,
+		DOWNMIX,
+		BINAURAL_SURROUND,
+		BINAURAL_AMBISONIC,
+		AMBISONIC_STEREO,
+	};
+
+	static constexpr int RING_SIZE = 128;
+	static constexpr int AMBISONIC_SPEAKERS = 8;
+
+private:
+	struct Biquad {
+		float b0 = 1.0f;
+		float b1 = 0.0f;
+		float b2 = 0.0f;
+		float a1 = 0.0f;
+		float a2 = 0.0f;
+		float z1 = 0.0f;
+		float z2 = 0.0f;
+		float run(float p_x);
+		void set_lowpass(float p_frequency, float p_rate, float p_q);
+		void set_highpass(float p_frequency, float p_rate, float p_q);
+		void reset() { z1 = z2 = 0.0f; }
+	};
+
+	struct EarParams {
+		float delay = 0.0f;
+		float alpha = 1.0f;
+		float gain = 1.0f;
+	};
+
+	struct Source {
+		int channel = -1;
+		Vector3 direction;
+		float gain = 1.0f;
+		bool lfe = false;
+		bool center = false;
+		float left_gain = 0.0f;
+		float right_gain = 0.0f;
+		EarParams ears[2];
+		float back = 0.0f;
+		float ring[RING_SIZE] = {};
+		int ring_pos = 0;
+		float shadow_x1[2] = { 0.0f, 0.0f };
+		float shadow_y1[2] = { 0.0f, 0.0f };
+		float rear_state = 0.0f;
+		bool primed = false;
+	};
+
+	Mode mode = PASSTHROUGH;
+	int input_channels = 0;
+	int sample_rate = 48000;
+	bool ambisonic = false;
+	bool spatial = true;
+	float dialogue = 0.0f;
+	float scale = 1.0f;
+	float tau_k = 12.0f;
+	float rear_coefficient = 0.3f;
+	String layout_name;
+	std::vector<Source> sources;
+	Basis listener;
+	Basis applied_listener;
+	bool listener_primed = false;
+	Biquad voice_high[2];
+	Biquad voice_low[2];
+	int ambisonic_w = 0;
+	int ambisonic_y = 1;
+	int ambisonic_z = 2;
+	int ambisonic_x = 3;
+	int seek_fade_left = 0;
+	int seek_fade_total = 0;
+
+	void _update_mode();
+	void _build_sources(const AVChannelLayout &p_layout);
+	static bool _channel_direction(AVChannel p_channel, float &r_azimuth, float &r_elevation, bool &r_lfe);
+	static Vector3 _direction(float p_azimuth_deg, float p_elevation_deg);
+	EarParams _ear_params(const Vector3 &p_head_direction, int p_ear) const;
+	float _render_source(Source &p_source, float p_input, const EarParams p_from[2], const EarParams p_to[2], float p_back_from, float p_back_to, float p_t, float &r_right);
+	float _voice(int p_channel, float p_mid);
+	static float _limit(float p_x);
+	void _apply_seek_fade(float *p_out, int p_frames, int p_channels);
+
+	void _process_passthrough(const float *p_in, int p_frames, float *p_out);
+	void _process_downmix(const float *p_in, int p_frames, float *p_out);
+	void _process_binaural_surround(const float *p_in, int p_frames, float *p_out);
+	void _process_binaural_ambisonic(const float *p_in, int p_frames, float *p_out);
+	void _process_ambisonic_stereo(const float *p_in, int p_frames, float *p_out);
+
+public:
