+#include <godot_cpp/classes/engine.hpp>
+
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <io.h>
+#define dup _dup
+#define close _close
+#else
+#include <unistd.h>
+#endif
+
+extern "C" {
+#include "libavutil/hwcontext_drm.h"
+}
+
+static const uint64_t IMPORT_IDLE_FRAMES = 600;
+
+VpxDmabufImport::VpxDmabufImport(const std::shared_ptr<VpxVulkanDevice> &p_vk, RenderingDevice *p_rd) :
+		vk(p_vk), rd(p_rd) {
+	if (!vk || rd == nullptr || !vk->dmabuf_import) {
+		failed = true;
+	}
+}
+
+VpxDmabufImport::~VpxDmabufImport() {
+	for (auto &entry : cache) {
+		_release(entry.second);
+	}
+	cache.clear();
+}
+
+void VpxDmabufImport::_release(Planes &p_planes) {
+	for (int i = 0; i < PLANE_COUNT; i++) {
+		if (p_planes.rid[i].is_valid()) {
+			rd->free_rid(p_planes.rid[i]);
+			p_planes.rid[i] = RID();
+		}
+		vpx_retire_image(vk, p_planes.image[i], p_planes.memory[i]);
+		p_planes.image[i] = VK_NULL_HANDLE;
+		p_planes.memory[i] = VK_NULL_HANDLE;
+	}
+	p_planes.count = 0;
+}
+
+bool VpxDmabufImport::_import_plane(Planes &p_planes, int p_index, int p_fd, uint64_t p_modifier, uint64_t p_offset,
+		uint64_t p_pitch, const Vector2i &p_size, VkFormat p_format, RenderingDevice::DataFormat p_rd_format) {
+	VkSubresourceLayout plane_layout = {};
+	plane_layout.offset = (VkDeviceSize)p_offset;
+	plane_layout.rowPitch = (VkDeviceSize)p_pitch;
+
+	VkImageDrmFormatModifierExplicitCreateInfoEXT modifier_info = {};
+	modifier_info.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT;
+	modifier_info.drmFormatModifier = p_modifier;
+	modifier_info.drmFormatModifierPlaneCount = 1;
+	modifier_info.pPlaneLayouts = &plane_layout;
+
+	VkExternalMemoryImageCreateInfo external_info = {};
+	external_info.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+	external_info.pNext = &modifier_info;
+	external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+
+	VkImageCreateInfo image_info = {};
+	image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	image_info.pNext = &external_info;
+	image_info.imageType = VK_IMAGE_TYPE_2D;
+	image_info.format = p_format;
+	image_info.extent = { (uint32_t)p_size.x, (uint32_t)p_size.y, 1 };
+	image_info.mipLevels = 1;
+	image_info.arrayLayers = 1;
+	image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+	image_info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+	image_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+	image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	if (vk->vkCreateImage(vk->device, &image_info, nullptr, &p_planes.image[p_index]) != VK_SUCCESS) {
+		p_planes.image[p_index] = VK_NULL_HANDLE;
+		print_line("zero-copy: image creation failed");
+		return false;
+	}
+
+	const int fd = dup(p_fd);
+	if (fd < 0) {
+		print_line("zero-copy: dma-buf dup failed");
+		return false;
+	}
+	VkMemoryFdPropertiesKHR fd_props = {};
+	fd_props.sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR;
+	if (vk->vkGetMemoryFdPropertiesKHR(vk->device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fd_props) != VK_SUCCESS) {
+		close(fd);
+		print_line("zero-copy: dma-buf memory properties unavailable");
+		return false;
+	}
+	VkMemoryRequirements requirements = {};
+	vk->vkGetImageMemoryRequirements(vk->device, p_planes.image[p_index], &requirements);
+	const uint32_t memory_type = vk->find_memory_type(requirements.memoryTypeBits & fd_props.memoryTypeBits, 0, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+	if (memory_type == UINT32_MAX) {
+		close(fd);
+		print_line("zero-copy: no memory type for imported dma-buf");
+		return false;
+	}
+
+	VkMemoryDedicatedAllocateInfo dedicated = {};
+	dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+	dedicated.image = p_planes.image[p_index];
+
+	VkImportMemoryFdInfoKHR import_info = {};
+	import_info.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR;
+	import_info.pNext = &dedicated;
+	import_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+	import_info.fd = fd;
+
+	VkMemoryAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+	alloc_info.pNext = &import_info;
+	alloc_info.allocationSize = requirements.size;
+	alloc_info.memoryTypeIndex = memory_type;
+	if (vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &p_planes.memory[p_index]) != VK_SUCCESS) {
+		close(fd);
+		p_planes.memory[p_index] = VK_NULL_HANDLE;
+		print_line("zero-copy: dma-buf import failed");
+		return false;
+	}
+	if (vk->vkBindImageMemory(vk->device, p_planes.image[p_index], p_planes.memory[p_index], 0) != VK_SUCCESS) {
+		print_line("zero-copy: bind of imported image failed");
+		return false;
+	}
+	const uint64_t usage = RenderingDevice::TEXTURE_USAGE_SAMPLING_BIT | RenderingDevice::TEXTURE_USAGE_CAN_COPY_FROM_BIT;
+	p_planes.rid[p_index] = rd->texture_create_from_extension(RenderingDevice::TEXTURE_TYPE_2D, p_rd_format,
+			RenderingDevice::TEXTURE_SAMPLES_1, usage, (uint64_t)p_planes.image[p_index], p_size.x, p_size.y, 1, 1);
+	if (!p_planes.rid[p_index].is_valid()) {
+		print_line("zero-copy: texture_create_from_extension failed");
+		return false;
+	}
+	return true;
+}
+
+VpxDmabufImport::Planes *VpxDmabufImport::acquire(const AVDRMFrameDescriptor *p_desc, const Vector2i p_sizes[PLANE_COUNT],
+		const VkFormat p_formats[PLANE_COUNT], const RenderingDevice::DataFormat p_rd_formats[PLANE_COUNT], int p_plane_count) {
+	if (!is_valid() || p_desc == nullptr || p_plane_count <= 0 || p_desc->nb_layers < p_plane_count) {
+		return nullptr;
+	}
+	struct stat info = {};
+	if (fstat(p_desc->objects[0].fd, &info) != 0) {
+		return nullptr;
+	}
+	const uint64_t key = (uint64_t)info.st_ino;
+	auto existing = cache.find(key);
+	if (existing != cache.end() && existing->second.count == p_plane_count) {
+		existing->second.touched_frame = (uint64_t)Engine::get_singleton()->get_frames_drawn();
+		return &existing->second;
+	}
+	if (existing != cache.end()) {
+		_release(existing->second);
+		cache.erase(existing);
+	}
+
+	Planes planes;
+	bool ok = true;
+	for (int i = 0; i < p_plane_count && ok; i++) {
+		const AVDRMLayerDescriptor &layer = p_desc->layers[i];
+		if (layer.nb_planes != 1) {
+			ok = false;
+			break;
+		}
+		const AVDRMPlaneDescriptor &plane = layer.planes[0];
+		const AVDRMObjectDescriptor &object = p_desc->objects[plane.object_index];
+		ok = _import_plane(planes, i, object.fd, object.format_modifier, plane.offset, plane.pitch,
+				p_sizes[i], p_formats[i], p_rd_formats[i]);
+	}
+	if (!ok) {
+		_release(planes);
+		failed = true;
+		vpx_mark_dmabuf_import_broken();
+		return nullptr;
+	}
+	planes.count = p_plane_count;
+	planes.touched_frame = (uint64_t)Engine::get_singleton()->get_frames_drawn();
+	auto inserted = cache.emplace(key, planes);
+	return &inserted.first->second;
+}
+
+void VpxDmabufImport::trim() {
+	if (cache.empty()) {
+		return;
+	}
+	const uint64_t now = (uint64_t)Engine::get_singleton()->get_frames_drawn();
+	for (auto it = cache.begin(); it != cache.end();) {
+		if (now >= it->second.touched_frame + IMPORT_IDLE_FRAMES) {
+			_release(it->second);
+			it = cache.erase(it);
+		} else {
+			++it;
+		}
+	}
+}
+
+#endif // GDEXTENSION
diff --git a/vpx_dmabuf.h b/vpx_dmabuf.h
new file mode 100644
index 0000000..9e224ca
--- /dev/null
+++ b/vpx_dmabuf.h
@@ -0,0 +1,52 @@
+#ifndef VPX_DMABUF_H
+#define VPX_DMABUF_H
+
+#ifdef GDEXTENSION
+
+#include "vpx_vulkan.h"
+
+#include <godot_cpp/classes/rendering_device.hpp>
+#include <godot_cpp/variant/rid.hpp>
+#include <godot_cpp/variant/vector2i.hpp>
+
+#include <unordered_map>
+
+using namespace godot;
+
+struct AVDRMFrameDescriptor;
+
+class VpxDmabufImport {
+public:
+	static const int PLANE_COUNT = 4;
+
+	struct Planes {
+		VkImage image[PLANE_COUNT] = { VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE };
+		VkDeviceMemory memory[PLANE_COUNT] = { VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE };
+		RID rid[PLANE_COUNT];
+		int count = 0;
+		uint64_t touched_frame = 0;
+		bool primed = false;
+	};
+
+	VpxDmabufImport(const std::shared_ptr<VpxVulkanDevice> &p_vk, RenderingDevice *p_rd);
+	~VpxDmabufImport();
+
+	bool is_valid() const { return vk && vk->dmabuf_import && rd != nullptr && !failed; }
+	Planes *acquire(const AVDRMFrameDescriptor *p_desc, const Vector2i p_sizes[PLANE_COUNT],
+			const VkFormat p_formats[PLANE_COUNT], const RenderingDevice::DataFormat p_rd_formats[PLANE_COUNT],
+			int p_plane_count);
+	void trim();
+
+private:
+	std::shared_ptr<VpxVulkanDevice> vk;
+	RenderingDevice *rd = nullptr;
+	std::unordered_map<uint64_t, Planes> cache;
+	bool failed = false;
+
+	void _release(Planes &p_planes);
+	bool _import_plane(Planes &p_planes, int p_index, int p_fd, uint64_t p_modifier, uint64_t p_offset,
+			uint64_t p_pitch, const Vector2i &p_size, VkFormat p_format, RenderingDevice::DataFormat p_rd_format);
+};
+
+#endif // GDEXTENSION
+#endif // VPX_DMABUF_H
diff --git a/vpx_dynlib.cpp b/vpx_dynlib.cpp
new file mode 100644
