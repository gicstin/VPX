+double FFmpegVideoStreamPlayback::_vsync_step(double p_delta) {
+	double step = p_delta * 1000.0;
+	if (display_rate <= 1.0) {
+		return step;
+	}
+	const double tick = 1000.0 / display_rate;
+	const double ticks = Math::round(step / tick);
+	if (ticks < 1.0 || ticks > 4.0) {
+		vsync_error_msec = 0.0;
+		return step;
+	}
+	vsync_error_msec += step - ticks * tick;
+	step = ticks * tick;
+	if (Math::abs(vsync_error_msec) > tick * 4.0) {
+		step += vsync_error_msec;
+		vsync_error_msec = 0.0;
+		return step;
+	}
+	const double correction = vsync_error_msec * 0.02;
+	vsync_error_msec -= correction;
+	return step + correction;
+}
+
+double FFmpegVideoStreamPlayback::_display_delta(double p_delta) const {
+	return display_rate > 1.0 ? MIN(p_delta, 1.0 / display_rate) : p_delta;
