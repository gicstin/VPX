+#ifndef VPX_GPU_UPLOAD_H
+#define VPX_GPU_UPLOAD_H
+
+#ifdef GDEXTENSION
+
+#include "vpx_vulkan.h"
+
+#include <godot_cpp/classes/rendering_device.hpp>
+#include <godot_cpp/variant/rid.hpp>
+#include <godot_cpp/variant/vector2i.hpp>
+
+using namespace godot;
+
+struct VpxPlaneCopy {
+	VkBuffer buffer = VK_NULL_HANDLE;
+	VkDeviceSize offset = 0;
+	uint32_t row_length_texels = 0;
+	uint32_t rows = 0;
+};
+
+class VpxGpuUpload {
+public:
+	static const int PLANE_COUNT = 4;
+	static const int SET_COUNT = 6;
+	static const uint64_t REUSE_FRAMES = 3;
+
+	struct ExternalPlane {
+		VkImage image = VK_NULL_HANDLE;
+		VkDeviceMemory memory = VK_NULL_HANDLE;
+		RID rid;
+		Vector2i size;
+		VkFormat format = VK_FORMAT_UNDEFINED;
+		bool written = false;
+		bool primed = false;
+	};
+
+private:
+	std::shared_ptr<VpxVulkanDevice> vk;
+	RenderingDevice *rd = nullptr;
+	ExternalPlane planes[SET_COUNT][PLANE_COUNT];
+	VkCommandPool command_pool = VK_NULL_HANDLE;
+	VkCommandBuffer command_buffers[SET_COUNT] = {};
+	VkFence fences[SET_COUNT] = {};
+	bool in_flight[SET_COUNT] = {};
+	uint64_t published_frame[SET_COUNT] = {};
+	bool published[SET_COUNT] = {};
+	bool failed = false;
+
+	void _free_plane(ExternalPlane &p_plane);
+	bool _ensure_plane(ExternalPlane &p_plane, const Vector2i &p_size, VkFormat p_format, RenderingDevice::DataFormat p_rd_format);
+
+public:
+	bool is_valid() const { return vk && !failed; }
+	bool ensure_planes(int p_set, const Vector2i p_sizes[PLANE_COUNT], const VkFormat p_formats[PLANE_COUNT], const RenderingDevice::DataFormat p_rd_formats[PLANE_COUNT], const bool p_used[PLANE_COUNT]);
+	bool submit_copy(int p_set, const VpxPlaneCopy p_copies[PLANE_COUNT], const bool p_used[PLANE_COUNT]);
+	bool is_in_flight(int p_set) const { return in_flight[p_set]; }
+	int acquire_slot(uint64_t p_frame) const;
+	void mark_published(int p_set, uint64_t p_frame) {
+		published[p_set] = true;
+		published_frame[p_set] = p_frame;
+	}
+	bool poll(int p_set);
+	void wait(int p_set);
+	RID get_plane_rid(int p_set, int p_plane) const { return planes[p_set][p_plane].rid; }
+	bool take_needs_priming(int p_set, int p_plane) {
+		ExternalPlane &plane = planes[p_set][p_plane];
+		const bool needs = !plane.primed;
+		plane.primed = true;
+		return needs;
+	}
+
+	VpxGpuUpload(const std::shared_ptr<VpxVulkanDevice> &p_vk, RenderingDevice *p_rd);
+	~VpxGpuUpload();
+};
+
+#endif // GDEXTENSION
+#endif // VPX_GPU_UPLOAD_H
