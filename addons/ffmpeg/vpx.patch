+void VideoDecoder::_probe_multiview() {
+	if (video_codec_context == nullptr || video_codec_context->codec_id != AV_CODEC_ID_HEVC) {
+		return;
+	}
+	unsigned int count = 0;
+	if (av_opt_get_array_size(video_codec_context, "view_ids_available", AV_OPT_SEARCH_CHILDREN, &count) < 0 || count < 2) {
+		return;
+	}
+	std::vector<unsigned int> ids(count);
+	std::vector<unsigned int> positions(count);
+	av_opt_get_array(video_codec_context, "view_ids_available", AV_OPT_SEARCH_CHILDREN, 0, count, AV_OPT_TYPE_UINT, ids.data());
+	unsigned int position_count = 0;
+	if (av_opt_get_array_size(video_codec_context, "view_pos_available", AV_OPT_SEARCH_CHILDREN, &position_count) >= 0 && position_count == count) {
+		av_opt_get_array(video_codec_context, "view_pos_available", AV_OPT_SEARCH_CHILDREN, 0, count, AV_OPT_TYPE_UINT, positions.data());
+		for (unsigned int i = 0; i < count; i++) {
+			if (positions[i] == AV_STEREO3D_VIEW_LEFT) {
+				multiview_left_id = (int)ids[i];
+			}
+		}
+	} else {
+		multiview_left_id = (int)ids[0];
+	}
+	if (hw_active && !multiview_probe_done) {
+		multiview_probe_done = true;
+		print_line(vformat("MV-HEVC stream with %d views: switching to software decoding to decode both eyes", (int)count));
+		backend_switch_request.set(1);
+	}
+}
+
+bool VideoDecoder::_handle_multiview(Ref<FFmpegFrame> &r_frame, double &r_frame_time) {
+	const AVFrameSideData *view_data = av_frame_get_side_data(r_frame->get_frame(), AV_FRAME_DATA_VIEW_ID);
+	if (view_data == nullptr || view_data->size < (int)sizeof(int)) {
+		return true;
+	}
+	const int view = *(const int *)view_data->data;
+	if (!multiview) {
+		multiview = true;
+		_probe_multiview();
+		_free_seek_accelerator();
+		metadata_mutex->lock();
+		stream_metadata["multiview"] = true;
+		stream_metadata.erase("stereo3d");
+		metadata_mutex->unlock();
+		print_line(vformat("MV-HEVC: decoding both views, left view id %d", multiview_left_id));
+	}
+	const AVFrameSideData *stereo = av_frame_get_side_data(r_frame->get_frame(), AV_FRAME_DATA_STEREO3D);
+	if (stereo != nullptr && ((const AVStereo3D *)stereo->data)->view == AV_STEREO3D_VIEW_LEFT) {
+		multiview_left_id = view;
+	}
+	if (!multiview_pending.is_valid() || view == multiview_pending_view || Math::abs(multiview_pending_time - r_frame_time) > 0.5) {
+		multiview_pending = r_frame;
+		multiview_pending_time = r_frame_time;
+		multiview_pending_view = view;
+		return false;
+	}
+	const bool pending_left = multiview_pending_view == multiview_left_id;
+	Ref<FFmpegFrame> combined = _combine_views(pending_left ? multiview_pending : r_frame, pending_left ? r_frame : multiview_pending);
+	multiview_pending.unref();
+	multiview_pending_view = -1;
+	if (!combined.is_valid()) {
+		return true;
+	}
+	r_frame = combined;
+	return true;
+}
+
+Ref<FFmpegFrame> VideoDecoder::_combine_views(const Ref<FFmpegFrame> &p_left, const Ref<FFmpegFrame> &p_right) {
+	const AVFrame *left = p_left->get_frame();
+	const AVFrame *right = p_right->get_frame();
+	if (left->format != right->format || left->width != right->width || left->height != right->height) {
+		return Ref<FFmpegFrame>();
+	}
+	Ref<FFmpegFrame> out;
+	out.instantiate();
+	AVFrame *dst = out->get_frame();
+	dst->format = left->format;
+	dst->width = left->width * 2;
+	dst->height = left->height;
+	bool allocated = false;
+#ifdef GDEXTENSION
+	allocated = _alloc_pinned_frame(dst, FFALIGN(dst->width, 64), FFALIGN(dst->height, 2));
+#endif
+	if (!allocated && av_frame_get_buffer(dst, 64) < 0) {
+		return Ref<FFmpegFrame>();
+	}
+	const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get((AVPixelFormat)left->format);
+	const int planes = av_pix_fmt_count_planes((AVPixelFormat)left->format);
+	for (int plane = 0; plane < planes; plane++) {
+		const int bytes = av_image_get_linesize((AVPixelFormat)left->format, left->width, plane);
+		const int rows = (plane == 1 || plane == 2) ? AV_CEIL_RSHIFT(left->height, desc->log2_chroma_h) : left->height;
+		av_image_copy_plane(dst->data[plane], dst->linesize[plane], left->data[plane], left->linesize[plane], bytes, rows);
+		av_image_copy_plane(dst->data[plane] + bytes, dst->linesize[plane], right->data[plane], right->linesize[plane], bytes, rows);
+	}
+	av_frame_copy_props(dst, left);
+	return out;
 }
 
