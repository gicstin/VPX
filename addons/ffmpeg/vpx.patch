+static void panorama_jpeg_emit(j_common_ptr, int) {
+}
+
+static FILE *open_image_file(const String &p_path) {
+#ifdef _WIN32
+	return _wfopen(reinterpret_cast<const wchar_t *>(p_path.utf16().get_data()), L"rb");
+#else
+	return fopen(p_path.utf8().get_data(), "rb");
+#endif
+}
+
+static bool read_file(const String &p_path, std::vector<uint8_t> &r_bytes) {
+	FILE *file = open_image_file(p_path);
+	if (file == nullptr) {
+		return false;
+	}
+	fseek(file, 0, SEEK_END);
+	const long size = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	if (size <= 0) {
+		fclose(file);
+		return false;
+	}
+	r_bytes.resize(size);
+	const size_t got = fread(r_bytes.data(), 1, size, file);
+	fclose(file);
+	return got == (size_t)size;
+}
+
+struct ResampleTaps {
+	std::vector<int> first;
+	std::vector<int> count;
+	std::vector<float> weights;
+	int stride = 0;
+};
+
+static float lanczos3(float p_x) {
+	const float x = std::fabs(p_x);
+	if (x < 1e-5f) {
+		return 1.0f;
+	}
+	if (x >= 3.0f) {
+		return 0.0f;
+	}
+	const float px = (float)Math_PI * x;
+	return 3.0f * std::sin(px) * std::sin(px / 3.0f) / (px * px);
+}
+
+static ResampleTaps resample_taps(int p_src, int p_dst) {
+	ResampleTaps taps;
+	const float ratio = (float)p_src / (float)p_dst;
+	const float scale = std::max(1.0f, ratio);
+	const float radius = 3.0f * scale;
+	taps.stride = (int)std::ceil(radius * 2.0f) + 2;
+	taps.first.resize(p_dst);
+	taps.count.resize(p_dst);
+	taps.weights.assign((size_t)p_dst * taps.stride, 0.0f);
+	for (int i = 0; i < p_dst; i++) {
+		const float center = (i + 0.5f) * ratio;
+		const int first = (int)std::floor(center - radius);
+		const int last = std::min((int)std::ceil(center + radius), first + taps.stride - 1);
+		float total = 0.0f;
+		for (int s = first; s <= last; s++) {
+			total += lanczos3((s + 0.5f - center) / scale);
+		}
+		taps.first[i] = first;
+		taps.count[i] = last - first + 1;
+		for (int s = first; s <= last; s++) {
+			taps.weights[(size_t)i * taps.stride + (s - first)] = lanczos3((s + 0.5f - center) / scale) / total;
+		}
+	}
+	return taps;
+}
+
+static void resample_plane(const uint8_t *p_src, int p_src_width, int p_src_height, uint8_t *p_dst, int p_dst_width, int p_dst_height) {
+	const ResampleTaps across = resample_taps(p_src_width, p_dst_width);
+	const ResampleTaps down = resample_taps(p_src_height, p_dst_height);
+	std::vector<float> rows((size_t)p_dst_width * p_src_height);
+	for (int y = 0; y < p_src_height; y++) {
+		const uint8_t *line = p_src + (size_t)y * p_src_width;
+		float *out = rows.data() + (size_t)y * p_dst_width;
+		for (int x = 0; x < p_dst_width; x++) {
+			const float *w = across.weights.data() + (size_t)x * across.stride;
+			float sum = 0.0f;
+			for (int k = 0; k < across.count[x]; k++) {
+				sum += w[k] * line[std::clamp(across.first[x] + k, 0, p_src_width - 1)];
+			}
+			out[x] = sum;
+		}
+	}
+	for (int y = 0; y < p_dst_height; y++) {
+		const float *w = down.weights.data() + (size_t)y * down.stride;
+		uint8_t *out = p_dst + (size_t)y * p_dst_width;
+		for (int x = 0; x < p_dst_width; x++) {
+			float sum = 0.0f;
+			for (int k = 0; k < down.count[y]; k++) {
+				sum += w[k] * rows[(size_t)std::clamp(down.first[y] + k, 0, p_src_height - 1) * p_dst_width + x];
+			}
+			out[x] = (uint8_t)std::clamp((int)std::lround(sum), 0, 255);
+		}
+	}
+}
+
+static bool is_jpeg(const std::vector<uint8_t> &p_bytes) {
+	return p_bytes.size() > 3 && p_bytes[0] == 0xFF && p_bytes[1] == 0xD8 && p_bytes[2] == 0xFF;
+}
+
+static const PanoramaMipPipeline *ensure_mip_pipeline(RD *p_rd) {
+	if (panorama_mip != nullptr) {
+		return panorama_mip;
+	}
+	Ref<RDShaderSource> source;
+	source.instantiate();
+	source->set_stage_source(RD::SHADER_STAGE_COMPUTE, vformat(String(PANORAMA_MIP_SHADER), VPXPanorama::MIP_TAPS));
+	Ref<RDShaderSPIRV> spirv = p_rd->shader_compile_spirv_from_source(source);
+	const String compile_error = spirv->get_stage_compile_error(RD::SHADER_STAGE_COMPUTE);
+	ERR_FAIL_COND_V_MSG(!compile_error.is_empty(), nullptr, "Panorama mip shader: " + compile_error);
+	panorama_mip = new PanoramaMipPipeline();
+	panorama_mip->shader = p_rd->shader_create_from_spirv(spirv);
+	panorama_mip->pipeline = p_rd->compute_pipeline_create(panorama_mip->shader);
+	return panorama_mip;
+}
+
+static bool copy_queue_computes(const std::shared_ptr<VpxVulkanDevice> &p_vk) {
+	if (p_vk->vkGetPhysicalDeviceQueueFamilyProperties == nullptr) {
+		return false;
+	}
+	uint32_t count = 0;
+	p_vk->vkGetPhysicalDeviceQueueFamilyProperties(p_vk->physical_device, &count, nullptr);
+	std::vector<VkQueueFamilyProperties> families(count);
+	p_vk->vkGetPhysicalDeviceQueueFamilyProperties(p_vk->physical_device, &count, families.data());
+	return p_vk->copy_queue_family < count && (families[p_vk->copy_queue_family].queueFlags & VK_QUEUE_COMPUTE_BIT);
+}
+
+static PanoramaAsyncMips *ensure_async_mips(RD *p_rd, const std::shared_ptr<VpxVulkanDevice> &p_vk) {
+	if (panorama_async != nullptr && panorama_async->vk == p_vk) {
+		return panorama_async;
+	}
+	if (panorama_async_failed || !p_vk || OS::get_singleton()->has_environment("VPX_PANO_RD_MIPS") || !copy_queue_computes(p_vk)) {
+		return nullptr;
+	}
+	Ref<RDShaderSource> source;
+	source.instantiate();
+	source->set_stage_source(RD::SHADER_STAGE_COMPUTE, vformat(String(PANORAMA_MIP_SHADER), VPXPanorama::MIP_TAPS));
+	Ref<RDShaderSPIRV> spirv = p_rd->shader_compile_spirv_from_source(source);
+	const PackedByteArray code = spirv->get_stage_bytecode(RD::SHADER_STAGE_COMPUTE);
+	PanoramaAsyncMips *async = new PanoramaAsyncMips();
+	async->vk = p_vk;
+	bool ok = !code.is_empty() && async->load(async->vkCreateShaderModule, "vkCreateShaderModule") && async->load(async->vkDestroyShaderModule, "vkDestroyShaderModule") &&
+			async->load(async->vkCreateDescriptorSetLayout, "vkCreateDescriptorSetLayout") && async->load(async->vkDestroyDescriptorSetLayout, "vkDestroyDescriptorSetLayout") &&
+			async->load(async->vkCreatePipelineLayout, "vkCreatePipelineLayout") && async->load(async->vkDestroyPipelineLayout, "vkDestroyPipelineLayout") &&
+			async->load(async->vkCreateComputePipelines, "vkCreateComputePipelines") && async->load(async->vkDestroyPipeline, "vkDestroyPipeline") &&
+			async->load(async->vkCreateDescriptorPool, "vkCreateDescriptorPool") && async->load(async->vkDestroyDescriptorPool, "vkDestroyDescriptorPool") &&
+			async->load(async->vkAllocateDescriptorSets, "vkAllocateDescriptorSets") && async->load(async->vkUpdateDescriptorSets, "vkUpdateDescriptorSets") &&
+			async->load(async->vkCreateImageView, "vkCreateImageView") && async->load(async->vkDestroyImageView, "vkDestroyImageView") &&
+			async->load(async->vkCmdBindPipeline, "vkCmdBindPipeline") && async->load(async->vkCmdBindDescriptorSets, "vkCmdBindDescriptorSets") &&
+			async->load(async->vkCmdPushConstants, "vkCmdPushConstants") && async->load(async->vkCmdDispatch, "vkCmdDispatch");
+	if (ok) {
+		VkShaderModuleCreateInfo module_info = {};
+		module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+		module_info.codeSize = code.size();
+		module_info.pCode = reinterpret_cast<const uint32_t *>(code.ptr());
+		ok = async->vkCreateShaderModule(p_vk->device, &module_info, nullptr, &async->module) == VK_SUCCESS;
+	}
+	if (ok) {
+		VkDescriptorSetLayoutBinding bindings[2] = {};
+		for (int i = 0; i < 2; i++) {
+			bindings[i].binding = i;
+			bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+			bindings[i].descriptorCount = 1;
+			bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+		}
+		VkDescriptorSetLayoutCreateInfo set_info = {};
+		set_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+		set_info.bindingCount = 2;
+		set_info.pBindings = bindings;
+		ok = async->vkCreateDescriptorSetLayout(p_vk->device, &set_info, nullptr, &async->set_layout) == VK_SUCCESS;
+	}
+	if (ok) {
+		VkPushConstantRange range = {};
+		range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+		range.size = 32;
+		VkPipelineLayoutCreateInfo layout_info = {};
+		layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+		layout_info.setLayoutCount = 1;
+		layout_info.pSetLayouts = &async->set_layout;
+		layout_info.pushConstantRangeCount = 1;
+		layout_info.pPushConstantRanges = &range;
+		ok = async->vkCreatePipelineLayout(p_vk->device, &layout_info, nullptr, &async->pipeline_layout) == VK_SUCCESS;
+	}
+	if (ok) {
+		VkComputePipelineCreateInfo pipeline_info = {};
+		pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+		pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+		pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+		pipeline_info.stage.module = async->module;
+		pipeline_info.stage.pName = "main";
+		pipeline_info.layout = async->pipeline_layout;
+		ok = async->vkCreateComputePipelines(p_vk->device, VK_NULL_HANDLE, 1, &pipeline_info, nullptr, &async->pipeline) == VK_SUCCESS;
+	}
+	if (!ok) {
+		print_line("Panorama mips: async compute unavailable, using the render queue");
+		delete async;
+		panorama_async_failed = true;
+		return nullptr;
+	}
+	delete panorama_async;
+	panorama_async = async;
+	return panorama_async;
+}
+
+void vpx_panorama_release_shared() {
+	delete panorama_async;
+	panorama_async = nullptr;
+	if (panorama_pool != nullptr) {
+		delete panorama_pool;
+		panorama_pool = nullptr;
+	}
+	if (panorama_mip == nullptr) {
+		return;
+	}
+	RenderingServer *rs = RenderingServer::get_singleton();
+	RD *rd = rs != nullptr ? rs->get_rendering_device() : nullptr;
+	if (rd != nullptr) {
+		rd->free_rid(panorama_mip->pipeline);
+		rd->free_rid(panorama_mip->shader);
+	}
+	delete panorama_mip;
+	panorama_mip = nullptr;
+}
+
+Dictionary VPXPanorama::probe(const String &p_path) {
+	Dictionary result;
+	FILE *file = open_image_file(p_path);
+	if (file == nullptr) {
+		return result;
+	}
+	jpeg_decompress_struct info;
+	PanoramaJpegError error;
+	info.err = jpeg_std_error(&error.pub);
+	error.pub.error_exit = panorama_jpeg_error_exit;
+	error.pub.emit_message = panorama_jpeg_emit;
+	jpeg_create_decompress(&info);
+	if (setjmp(error.jump)) {
+		jpeg_destroy_decompress(&info);
+		fclose(file);
+		return result;
+	}
+	jpeg_stdio_src(&info, file);
+	jpeg_read_header(&info, TRUE);
+	result["width"] = (int)info.image_width;
+	result["height"] = (int)info.image_height;
+	result["components"] = info.num_components;
+	jpeg_destroy_decompress(&info);
+	fclose(file);
+	return result;
+}
+
+VPXPanorama::VPXPanorama() {
+}
+
+VPXPanorama::~VPXPanorama() {
+	cancel();
+	_free_transfer(true);
+	_free_mip_resources();
+	_free_gpu();
+}
+
+void VPXPanorama::_fail(const String &p_message) {
+	std::lock_guard<std::mutex> lock(mutex);
+	if (error.is_empty()) {
+		error = p_message;
+	}
+	cancelled.store(true);
+}
+
+String VPXPanorama::get_error() {
+	std::lock_guard<std::mutex> lock(mutex);
+	return error;
+}
+
+Error VPXPanorama::start(const PackedStringArray &p_paths, int p_layout, bool p_wrap) {
+	ERR_FAIL_COND_V_MSG(!workers.empty(), ERR_ALREADY_IN_USE, "VPXPanorama already started");
+	layout = p_layout == LAYOUT_CUBE ? LAYOUT_CUBE : LAYOUT_TILED;
+	ERR_FAIL_COND_V_MSG(layout == LAYOUT_CUBE && p_paths.size() != CUBE_FACES, ERR_INVALID_PARAMETER, "cube needs 6 faces");
+	ERR_FAIL_COND_V_MSG(layout == LAYOUT_TILED && p_paths.size() != 1, ERR_INVALID_PARAMETER, "tiled layout needs 1 image");
+	paths = p_paths;
+	wrap = p_wrap;
+	const String budget = OS::get_singleton()->get_environment("VPX_PANO_MIP_BUDGET");
+	mip_budget = budget.is_empty() ? DEFAULT_MIP_BUDGET : budget.to_int();
+
+	RD *rd = RenderingServer::get_singleton()->get_rendering_device();
+	image_path = rd == nullptr;
+	if (rd != nullptr) {
+		max_size = (int)rd->limit_get(RD::LIMIT_MAX_TEXTURE_SIZE_2D);
+		vk = VpxVulkanDevice::from_rendering_device(rd);
+		if (vk && vk->host_cached_memory_type != UINT32_MAX) {
+			if (panorama_pool != nullptr && !panorama_pool->matches(vk)) {
+				delete panorama_pool;
+				panorama_pool = nullptr;
+			}
+			if (panorama_pool == nullptr) {
+				panorama_pool = new PanoramaPinnedPool(vk);
+			}
+			pool = panorama_pool;
+		}
+	}
+	start_usec = panorama_usec();
+	if (layout == LAYOUT_CUBE) {
+		layers = CUBE_FACES;
+		face_sizes.assign(CUBE_FACES, Vector2i());
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			stores[p].assign(CUBE_FACES, LayerStore());
+			images[p].assign(CUBE_FACES, Ref<Image>());
+		}
+		running.store(CUBE_FACES);
+		workers.emplace_back(&VPXPanorama::_launch_cube, this);
+	} else {
+		running.store(1);
+		workers.emplace_back(&VPXPanorama::_decode_tiled, this);
+	}
+	return OK;
+}
+
+bool VPXPanorama::is_decoded() const {
+	return !workers.empty() && running.load() == 0;
+}
+
+void VPXPanorama::cancel() {
+	cancelled.store(true);
+	_join();
+}
+
+void VPXPanorama::abort() {
+	cancelled.store(true);
+}
+
+void VPXPanorama::_join() {
+	for (std::thread &worker : workers) {
+		if (worker.joinable()) {
+			worker.join();
+		}
+	}
+}
+
+void VPXPanorama::_decode_tiled() {
+	if (_decode_file(paths[0], 0) && image_path && !cancelled.load()) {
+		for (int t = 0; t < tiles; t++) {
+			_build_images(t);
+		}
+	}
+	_finish_worker();
+}
+
+void VPXPanorama::_build_images(int p_slot) {
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		LayerStore &store = stores[p][p_slot];
+		const int height = (int)(store.size / std::max(store.width, 1));
+		Ref<Image> image = Image::create_from_data(store.width, height, false, Image::FORMAT_R8, store.bytes);
+		_release_store(store);
+		if (image.is_null()) {
+			_fail("cannot build panorama image");
+			return;
+		}
+		image->generate_mipmaps();
+		images[p][p_slot] = image;
+	}
+}
+
+bool VPXPanorama::_create_image_textures() {
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		TypedArray<Image> layer_images;
+		for (int layer = 0; layer < layers; layer++) {
+			layer_images.push_back(images[p][layer]);
+		}
+		Ref<ImageTextureLayered> texture;
+		if (layout == LAYOUT_CUBE) {
+			texture = Ref<Cubemap>(memnew(Cubemap));
+		} else {
+			texture = Ref<Texture2DArray>(memnew(Texture2DArray));
+		}
+		if (texture->create_from_images(layer_images) != OK) {
+			_fail("cannot create panorama texture");
+			return false;
+		}
+		textures[p] = texture;
+		images[p].clear();
+	}
+	return true;
+}
+
+void VPXPanorama::_launch_cube() {
+	int target = 0;
+	for (int face = 0; face < CUBE_FACES && !cancelled.load(); face++) {
+		const Dictionary header = probe(paths[face]);
+		target = std::max(target, std::max((int)header.get("width", 0), (int)header.get("height", 0)));
+	}
+	cube_target = std::min(target, max_size);
+	std::vector<std::thread> faces;
+	for (int face = 0; face < CUBE_FACES; face++) {
+		faces.emplace_back(&VPXPanorama::_decode_face, this, face);
+	}
+	for (std::thread &face : faces) {
+		face.join();
+	}
+}
+
+void VPXPanorama::_decode_face(int p_face) {
+	if (_decode_file(paths[p_face], p_face) && !cancelled.load()) {
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			FaceTemp &temp = face_temps[p_face][p];
+			if (temp.pixels.empty()) {
+				continue;
+			}
+			LayerStore &store = stores[p][p_face];
+			resample_plane(temp.pixels.data(), temp.width, temp.height, store.data, store.width, (int)(store.size / std::max(store.width, 1)));
+			std::vector<uint8_t>().swap(temp.pixels);
+		}
+		if (image_path) {
+			_build_images(p_face);
+		}
+	}
+	_finish_worker();
+}
+
+void VPXPanorama::_finish_worker() {
+	const int64_t now = panorama_usec();
+	int64_t previous = decoded_at_usec.load();
+	while (now > previous && !decoded_at_usec.compare_exchange_weak(previous, now)) {
+	}
+	running.fetch_sub(1);
+}
+
+void VPXPanorama::_allocate_store(LayerStore &r_store, int p_width, int p_height) {
+	const int64_t begin = panorama_usec();
+	r_store.width = p_width;
+	r_store.size = (int64_t)p_width * p_height;
+	if (pool) {
+		r_store.pinned = pool->acquire((VkDeviceSize)r_store.size);
+	}
+	if (r_store.pinned != nullptr) {
+		r_store.data = r_store.pinned->mapped;
+	} else {
+		r_store.bytes.resize(r_store.size);
+		r_store.data = r_store.bytes.ptrw();
+	}
+	alloc_usec.fetch_add(panorama_usec() - begin);
+}
+
+void VPXPanorama::_release_store(LayerStore &r_store) {
+	if (r_store.pinned != nullptr) {
+		pool->release(r_store.pinned);
+		r_store.pinned = nullptr;
+	}
+	r_store.bytes = PackedByteArray();
+	r_store.data = nullptr;
+}
+
+void VPXPanorama::_prepare_tiles(int p_width, int p_height, const int p_ratio_x[PLANE_COUNT], const int p_ratio_y[PLANE_COUNT]) {
+	image_width = p_width;
+	image_height = p_height;
+	int count = MIN_TILES;
+	int core = 0;
+	while (true) {
+		core = ((p_width + count - 1) / count + ALIGN - 1) / ALIGN * ALIGN;
+		if (core + 2 * GUTTER <= max_size) {
+			break;
+		}
+		count++;
+	}
+	tiles = count;
+	layers = count;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		PlaneGeometry &g = geometry[p];
+		g.width = (p_width + p_ratio_x[p] - 1) / p_ratio_x[p];
+		g.height = (p_height + p_ratio_y[p] - 1) / p_ratio_y[p];
+		g.core = core / p_ratio_x[p];
+		g.gutter = GUTTER / p_ratio_x[p];
+		g.tile_width = g.core + 2 * g.gutter;
+	}
+	_allocate_owned_images();
+	geometry_ready.store(true);
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		stores[p].assign(count, LayerStore());
+		images[p].assign(count, Ref<Image>());
+		for (int t = 0; t < count; t++) {
+			_allocate_store(stores[p][t], geometry[p].tile_width, geometry[p].height);
+		}
+	}
+}
+
+void VPXPanorama::_prepare_face(int p_slot, int p_width, int p_height, const int p_ratio_x[PLANE_COUNT], const int p_ratio_y[PLANE_COUNT]) {
+	if (cube_target > 0 && (p_width != cube_target || p_height != cube_target)) {
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			FaceTemp &temp = face_temps[p_slot][p];
+			temp.width = (p_width + p_ratio_x[p] - 1) / p_ratio_x[p];
+			temp.height = (p_height + p_ratio_y[p] - 1) / p_ratio_y[p];
+			temp.pixels.resize((size_t)temp.width * temp.height);
+		}
+		p_width = cube_target;
+		p_height = cube_target;
+	}
+	bool allocate = false;
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		face_sizes[p_slot] = Vector2i(p_width, p_height);
+		if (face_size == 0) {
+			face_size = p_width;
+			image_width = p_width;
+			image_height = p_height;
+			for (int p = 0; p < PLANE_COUNT; p++) {
+				PlaneGeometry &g = geometry[p];
+				g.width = (p_width + p_ratio_x[p] - 1) / p_ratio_x[p];
+				g.height = (p_height + p_ratio_y[p] - 1) / p_ratio_y[p];
+				g.core = g.width;
+				g.gutter = 0;
+				g.tile_width = g.width;
+			}
+			allocate = true;
+		}
+	}
+	if (allocate) {
+		_allocate_owned_images();
+		geometry_ready.store(true);
+	}
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		_allocate_store(stores[p][p_slot], (p_width + p_ratio_x[p] - 1) / p_ratio_x[p], (p_height + p_ratio_y[p] - 1) / p_ratio_y[p]);
+	}
+}
+
+void VPXPanorama::_fill_neutral_chroma(int p_slot) {
+	for (int p = 1; p < PLANE_COUNT; p++) {
+		if (layout == LAYOUT_CUBE) {
+			memset(stores[p][p_slot].data, 128, stores[p][p_slot].size);
+			std::fill(face_temps[p_slot][p].pixels.begin(), face_temps[p_slot][p].pixels.end(), (uint8_t)128);
+			continue;
+		}
+		for (LayerStore &tile : stores[p]) {
+			memset(tile.data, 128, tile.size);
+		}
+	}
+}
+
+void VPXPanorama::_scatter_row(int p_plane, int p_slot, int p_row, const uint8_t *p_src) {
+	if (layout == LAYOUT_CUBE) {
+		FaceTemp &temp = face_temps[p_slot][p_plane];
+		if (!temp.pixels.empty()) {
+			memcpy(temp.pixels.data() + (size_t)p_row * temp.width, p_src, temp.width);
+			return;
+		}
+		LayerStore &store = stores[p_plane][p_slot];
+		memcpy(store.data + (int64_t)p_row * store.width, p_src, store.width);
+		return;
+	}
+	const PlaneGeometry &g = geometry[p_plane];
+	const int w = g.width;
+	for (int t = 0; t < tiles; t++) {
+		uint8_t *dst = stores[p_plane][t].data + (int64_t)p_row * g.tile_width;
+		const int start = t * g.core - g.gutter;
+		int c = 0;
+		while (c < g.tile_width) {
+			int s = start + c;
+			int n = 0;
+			if (wrap) {
+				s = ((s % w) + w) % w;
+				n = std::min(g.tile_width - c, w - s);
+				memcpy(dst + c, p_src + s, n);
+			} else if (s < 0) {
+				n = std::min(g.tile_width - c, -s);
+				memset(dst + c, p_src[0], n);
+			} else if (s >= w) {
+				n = g.tile_width - c;
+				memset(dst + c, p_src[w - 1], n);
+			} else {
+				n = std::min(g.tile_width - c, w - s);
+				memcpy(dst + c, p_src + s, n);
+			}
+			c += n;
+		}
+	}
+}
+
+bool VPXPanorama::_decode_file(const String &p_path, int p_slot) {
+	const int64_t begin = panorama_usec();
+	std::vector<uint8_t> bytes;
+	if (!read_file(p_path, bytes)) {
+		_fail("cannot read " + p_path);
+		return false;
+	}
+	const int64_t read_done = panorama_usec();
+	if (cancelled.load()) {
+		return false;
+	}
+	read_usec.fetch_add(read_done - begin);
+	const bool cube = layout == LAYOUT_CUBE;
+
+	if (!is_jpeg(bytes)) {
+		Ref<Image> image;
+		image.instantiate();
+		PackedByteArray buffer;
+		buffer.resize(bytes.size());
+		memcpy(buffer.ptrw(), bytes.data(), bytes.size());
+		std::vector<uint8_t>().swap(bytes);
+		const String ext = p_path.get_extension().to_lower();
+		Error err = ERR_FILE_UNRECOGNIZED;
+		if (ext == "png") {
+			err = image->load_png_from_buffer(buffer);
+		} else if (ext == "webp") {
+			err = image->load_webp_from_buffer(buffer);
+		} else if (ext == "bmp") {
+			err = image->load_bmp_from_buffer(buffer);
+		} else if (ext == "tga") {
+			err = image->load_tga_from_buffer(buffer);
+		}
+		if (err != OK || image->is_empty()) {
+			_fail("cannot decode " + p_path);
+			return false;
+		}
+		image->convert(Image::FORMAT_RGB8);
+		int w = image->get_width();
+		int h = image->get_height();
+		const int limit_h = max_size;
+		const int limit_w = cube ? max_size : INT32_MAX;
+		if (cube && cube_target > 0 && (w != cube_target || h != cube_target)) {
+			w = cube_target;
+			h = cube_target;
+			image->resize(w, h, Image::INTERPOLATE_LANCZOS);
+		} else if (h > limit_h || w > limit_w) {
+			const double scale = std::min((double)limit_h / h, (double)limit_w / w);
+			w = std::max(1, (int)(w * scale));
+			h = std::max(1, (int)(h * scale));
+			image->resize(w, h, Image::INTERPOLATE_LANCZOS);
+		}
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			rgb_planes = true;
+		}
+		const int ones[PLANE_COUNT] = { 1, 1, 1 };
+		if (cube) {
+			_prepare_face(p_slot, w, h, ones, ones);
+		} else {
+			_prepare_tiles(w, h, ones, ones);
+		}
+		const PackedByteArray pixels = image->get_data();
+		const uint8_t *src = pixels.ptr();
+		std::vector<uint8_t> rows[PLANE_COUNT];
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			rows[p].resize(w);
+		}
+		for (int y = 0; y < h && !cancelled.load(); y++) {
+			const uint8_t *line = src + (int64_t)y * w * 3;
+			for (int x = 0; x < w; x++) {
+				rows[0][x] = line[x * 3];
+				rows[1][x] = line[x * 3 + 1];
+				rows[2][x] = line[x * 3 + 2];
+			}
+			for (int p = 0; p < PLANE_COUNT; p++) {
+				_scatter_row(p, p_slot, y, rows[p].data());
+			}
+		}
+		decode_usec.store(std::max(decode_usec.load(), panorama_usec() - read_done));
+		return !cancelled.load();
+	}
+
+	jpeg_decompress_struct info;
+	PanoramaJpegError jerr;
+	info.err = jpeg_std_error(&jerr.pub);
+	jerr.pub.error_exit = panorama_jpeg_error_exit;
+	jerr.pub.emit_message = panorama_jpeg_emit;
+	std::vector<uint8_t> buffers[PLANE_COUNT];
+	std::vector<JSAMPROW> row_pointers[PLANE_COUNT];
+	std::vector<uint8_t> line;
+	std::vector<uint8_t> split[PLANE_COUNT];
+	jpeg_create_decompress(&info);
+	if (setjmp(jerr.jump)) {
+		jpeg_destroy_decompress(&info);
+		_fail(vformat("%s: %s", p_path, String(jerr.message)));
+		return false;
+	}
+	jpeg_mem_src(&info, bytes.data(), bytes.size());
+	jpeg_read_header(&info, TRUE);
+	info.dct_method = JDCT_ISLOW;
+
+	int denom = 1;
+	while (denom < 8 && (((int)info.image_height + denom - 1) / denom > max_size || (cube && ((int)info.image_width + denom - 1) / denom > max_size))) {
+		denom *= 2;
+	}
+
+	const bool gray = info.jpeg_color_space == JCS_GRAYSCALE && info.num_components == 1;
+	bool raw = denom == 1 && (gray || (info.jpeg_color_space == JCS_YCbCr && info.num_components == 3));
+	if (raw && !gray) {
+		const jpeg_component_info *c = info.comp_info;
+		raw = c[1].h_samp_factor == 1 && c[1].v_samp_factor == 1 && c[2].h_samp_factor == 1 && c[2].v_samp_factor == 1 && c[0].h_samp_factor <= 2 && c[0].v_samp_factor <= 2;
+	}
+
+	int ratio_x[PLANE_COUNT] = { 1, 1, 1 };
+	int ratio_y[PLANE_COUNT] = { 1, 1, 1 };
+	if (raw) {
+		info.raw_data_out = TRUE;
+		info.do_fancy_upsampling = FALSE;
+		jpeg_start_decompress(&info);
+		const int max_h = info.max_h_samp_factor;
+		const int max_v = info.max_v_samp_factor;
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			if (gray) {
+				ratio_x[p] = p == 0 ? 1 : 2;
+				ratio_y[p] = p == 0 ? 1 : 2;
+			} else {
+				ratio_x[p] = max_h / info.comp_info[p].h_samp_factor;
+				ratio_y[p] = max_v / info.comp_info[p].v_samp_factor;
+			}
+		}
+		const int width = info.output_width;
+		const int height = info.output_height;
+		if (cube) {
+			_prepare_face(p_slot, width, height, ratio_x, ratio_y);
+		} else {
+			_prepare_tiles(width, height, ratio_x, ratio_y);
+		}
+		if (gray) {
+			_fill_neutral_chroma(p_slot);
+		}
+		const int components = info.num_components;
+		const int rows_per_call = max_v * DCTSIZE;
+		JSAMPARRAY planes[PLANE_COUNT] = {};
+		int comp_rows[PLANE_COUNT] = {};
+		int comp_height[PLANE_COUNT] = {};
+		for (int c = 0; c < components; c++) {
+			const jpeg_component_info &comp = info.comp_info[c];
+			comp_rows[c] = comp.v_samp_factor * DCTSIZE;
+			const int stride = comp.width_in_blocks * DCTSIZE;
+			comp_height[c] = comp.downsampled_height;
+			buffers[c].resize((size_t)stride * comp_rows[c]);
+			row_pointers[c].resize(comp_rows[c]);
+			for (int r = 0; r < comp_rows[c]; r++) {
+				row_pointers[c][r] = buffers[c].data() + (size_t)r * stride;
+			}
+			planes[c] = row_pointers[c].data();
+		}
+		while (info.output_scanline < info.output_height) {
+			if (cancelled.load()) {
+				jpeg_abort_decompress(&info);
+				jpeg_destroy_decompress(&info);
+				return false;
+			}
+			const int base = info.output_scanline;
+			jpeg_read_raw_data(&info, planes, rows_per_call);
+			for (int c = 0; c < components; c++) {
+				const int first = base / rows_per_call * comp_rows[c];
+				for (int r = 0; r < comp_rows[c]; r++) {
+					if (first + r < comp_height[c]) {
+						_scatter_row(c, p_slot, first + r, row_pointers[c][r]);
+					}
+				}
+			}
+		}
+	} else {
+		info.out_color_space = gray ? JCS_GRAYSCALE : JCS_YCbCr;
+		info.scale_num = 1;
+		info.scale_denom = denom;
+		info.do_fancy_upsampling = TRUE;
+		jpeg_start_decompress(&info);
+		if (gray) {
+			ratio_x[1] = ratio_x[2] = 2;
+			ratio_y[1] = ratio_y[2] = 2;
+		}
+		const int width = info.output_width;
+		const int height = info.output_height;
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			scale_denom = std::max(scale_denom, denom);
+		}
+		if (cube) {
+			_prepare_face(p_slot, width, height, ratio_x, ratio_y);
+		} else {
+			_prepare_tiles(width, height, ratio_x, ratio_y);
+		}
+		if (gray) {
+			_fill_neutral_chroma(p_slot);
+		}
+		const int components = info.output_components;
+		line.resize((size_t)width * components);
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			split[p].resize(width);
+		}
+		while (info.output_scanline < info.output_height) {
+			if (cancelled.load()) {
+				jpeg_abort_decompress(&info);
+				jpeg_destroy_decompress(&info);
+				return false;
+			}
+			const int y = info.output_scanline;
+			JSAMPROW row = line.data();
+			jpeg_read_scanlines(&info, &row, 1);
+			if (gray) {
+				_scatter_row(0, p_slot, y, line.data());
+				continue;
+			}
+			for (int x = 0; x < width; x++) {
+				split[0][x] = line[x * 3];
+				split[1][x] = line[x * 3 + 1];
+				split[2][x] = line[x * 3 + 2];
+			}
+			for (int p = 0; p < PLANE_COUNT; p++) {
+				_scatter_row(p, p_slot, y, split[p].data());
+			}
+		}
+	}
+	jpeg_finish_decompress(&info);
+	jpeg_destroy_decompress(&info);
+	int64_t elapsed = panorama_usec() - read_done;
+	int64_t previous = decode_usec.load();
+	while (elapsed > previous && !decode_usec.compare_exchange_weak(previous, elapsed)) {
+	}
+	return true;
+}
+
+int VPXPanorama::poll() {
+	const int64_t begin = panorama_usec();
+	const Stage entered = stage;
+	const int status = _poll();
+	const int64_t spent = panorama_usec() - begin;
+	if (spent > slowest_poll_usec) {
+		slowest_poll_usec = spent;
+		slowest_poll_stage = (int)entered * 10 + (int)stage;
+	}
+	return status;
+}
+
+int VPXPanorama::_poll() {
+	if (stage == STAGE_READY) {
+		return STATUS_READY;
+	}
+	if (stage == STAGE_FAILED || workers.empty()) {
+		return STATUS_FAILED;
+	}
+	if (vk) {
+		vpx_purge_retired_images(false);
+	}
+	if (stage == STAGE_DECODING) {
+		if (!get_error().is_empty()) {
+			stage = STAGE_FAILED;
+			return STATUS_FAILED;
+		}
+		if (!image_path && !gpu_prepared && geometry_ready.load() && owned_state.load() != OWNED_PENDING && !_prepare_gpu()) {
+			stage = STAGE_FAILED;
+			return STATUS_FAILED;
+		}
+		if (!is_decoded()) {
+			return STATUS_LOADING;
+		}
+		_join();
+		if (!get_error().is_empty() || cancelled.load()) {
+			stage = STAGE_FAILED;
+			return STATUS_FAILED;
+		}
+		if (layout == LAYOUT_CUBE) {
+			for (int face = 1; face < CUBE_FACES; face++) {
+				if (face_sizes[face] != face_sizes[0]) {
+					_fail(vformat("cube face %d is %dx%d, expected %dx%d", face, face_sizes[face].x, face_sizes[face].y, face_sizes[0].x, face_sizes[0].y));
+					stage = STAGE_FAILED;
+					return STATUS_FAILED;
+				}
+			}
+			if (face_sizes[0].x != face_sizes[0].y) {
+				_fail("cube faces are not square");
+				stage = STAGE_FAILED;
+				return STATUS_FAILED;
+			}
+		}
+		if (image_path) {
+			const int64_t begin = panorama_usec();
+			if (!_create_image_textures()) {
+				stage = STAGE_FAILED;
+				return STATUS_FAILED;
+			}
+			upload_cpu_usec = panorama_usec() - begin;
+			mip_start_usec = begin;
+			ready_usec = panorama_usec();
+			stage = STAGE_READY;
+			return STATUS_READY;
+		}
+		if (!gpu_prepared && !_prepare_gpu()) {
+			stage = STAGE_FAILED;
+			return STATUS_FAILED;
+		}
+		if (owned_images[0] != VK_NULL_HANDLE) {
+			if ((uint64_t)Engine::get_singleton()->get_frames_drawn() < prime_frame + PRIME_FRAMES) {
+				return STATUS_LOADING;
+			}
+			if (!_submit_transfer()) {
+				_free_transfer(false);
+				if (!_upload_staged()) {
+					stage = STAGE_FAILED;
+					return STATUS_FAILED;
+				}
+				_queue_mips();
+			} else {
+				stage = STAGE_TRANSFER;
+				return STATUS_LOADING;
+			}
+		} else {
+			if (!_upload_staged()) {
+				stage = STAGE_FAILED;
+				return STATUS_FAILED;
+			}
+			_queue_mips();
+		}
+	}
+	if (stage == STAGE_TRANSFER) {
+		if (vk->vkGetFenceStatus(vk->device, fence) != VK_SUCCESS) {
+			return STATUS_LOADING;
+		}
+		transfer_in_flight = false;
+		transfer_done_usec = panorama_usec();
+		_finish_transfer();
+		if (async_mips) {
+			mip_start_usec = transfer_submit_usec;
+			_finish();
+			return STATUS_READY;
+		}
+		_queue_mips();
+	}
+	if (stage == STAGE_MIPS) {
+		_run_mips();
+		if (next_mip_job >= mip_jobs.size()) {
+			_finish();
+			return STATUS_READY;
+		}
+	}
+	return stage == STAGE_FAILED ? STATUS_FAILED : STATUS_LOADING;
+}
+
+bool VPXPanorama::_prepare_gpu() {
+	RD *rd = RenderingServer::get_singleton()->get_rendering_device();
+	ERR_FAIL_NULL_V(rd, false);
+	ERR_FAIL_NULL_V(ensure_mip_pipeline(rd), false);
+	gpu_prepared = true;
+	Ref<RDTextureView> view;
+	view.instantiate();
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		mips[p] = mip_count(geometry[p].tile_width, geometry[p].height);
+	}
+	const bool owned = owned_state.load() == OWNED_ALLOCATED && _import_owned_images();
+	if (!owned) {
+		_free_owned_images();
+		_free_scratch();
+		const Vector2i size = _scratch_size();
+		Ref<RDTextureFormat> scratch_format;
+		scratch_format.instantiate();
+		scratch_format->set_format(RD::DATA_FORMAT_R8_UNORM);
+		scratch_format->set_texture_type(RD::TEXTURE_TYPE_2D);
+		scratch_format->set_width(size.x);
+		scratch_format->set_height(size.y);
+		scratch_format->set_depth(1);
+		scratch_format->set_array_layers(1);
+		scratch_format->set_mipmaps(1);
+		scratch_format->set_usage_bits(RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT);
+		scratch = rd->texture_create(scratch_format, view);
+		if (!scratch.is_valid()) {
+			_fail("cannot create mip scratch texture");
+			return false;
+		}
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			const PlaneGeometry &g = geometry[p];
+			Ref<RDTextureFormat> format;
+			format.instantiate();
+			format->set_format(RD::DATA_FORMAT_R8_UNORM);
+			format->set_texture_type(layout == LAYOUT_CUBE ? RD::TEXTURE_TYPE_CUBE : RD::TEXTURE_TYPE_2D_ARRAY);
+			format->set_width(g.tile_width);
+			format->set_height(g.height);
+			format->set_depth(1);
+			format->set_array_layers(layers);
+			format->set_mipmaps(mips[p]);
+			format->set_usage_bits(RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT);
+			rids[p] = rd->texture_create(format, view);
+			if (!rids[p].is_valid()) {
+				_fail(vformat("cannot create %dx%dx%d texture", g.tile_width, g.height, layers));
+				return false;
+			}
+		}
+	}
+	level_views.assign(PLANE_COUNT * layers, std::vector<RID>());
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		for (int layer = 0; layer < layers; layer++) {
+			level_views[p * layers + layer].assign(mips[p], RID());
+		}
+	}
+	if (owned) {
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			rd->texture_copy(rids[p], scratch, Vector3(), Vector3(), Vector3(1, 1, 1), 0, 0, 0, 0);
+		}
+		prime_frame = (uint64_t)Engine::get_singleton()->get_frames_drawn();
+	}
+	return true;
+}
+
+void VPXPanorama::_allocate_owned_images() {
+	if (!vk || pool == nullptr) {
+		owned_state.store(OWNED_FAILED);
+		return;
+	}
+	const uint32_t families[2] = { vk->queue_family, vk->copy_queue_family };
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		const PlaneGeometry &g = geometry[p];
+		mips[p] = mip_count(g.tile_width, g.height);
+		VkImageCreateInfo image_info = {};
+		image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+		image_info.flags = layout == LAYOUT_CUBE ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0;
+		image_info.imageType = VK_IMAGE_TYPE_2D;
+		image_info.format = VK_FORMAT_R8_UNORM;
+		image_info.extent = { (uint32_t)g.tile_width, (uint32_t)g.height, 1 };
+		image_info.mipLevels = (uint32_t)mips[p];
+		image_info.arrayLayers = (uint32_t)layers;
+		image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+		image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+		image_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+		if (vk->copy_queue_family != vk->queue_family) {
+			image_info.sharingMode = VK_SHARING_MODE_CONCURRENT;
+			image_info.queueFamilyIndexCount = 2;
+			image_info.pQueueFamilyIndices = families;
+		} else {
+			image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+		}
+		image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+		if (vk->vkCreateImage(vk->device, &image_info, nullptr, &owned_images[p]) != VK_SUCCESS) {
+			owned_images[p] = VK_NULL_HANDLE;
+			owned_state.store(OWNED_FAILED);
+			return;
+		}
+		VkMemoryRequirements requirements = {};
+		vk->vkGetImageMemoryRequirements(vk->device, owned_images[p], &requirements);
+		const uint32_t memory_type = vk->find_memory_type(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0);
+		VkMemoryAllocateInfo alloc_info = {};
+		alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+		alloc_info.allocationSize = requirements.size;
+		alloc_info.memoryTypeIndex = memory_type;
+		if (memory_type == UINT32_MAX || vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &owned_memory[p]) != VK_SUCCESS) {
+			owned_memory[p] = VK_NULL_HANDLE;
+			owned_state.store(OWNED_FAILED);
+			return;
+		}
+		if (vk->vkBindImageMemory(vk->device, owned_images[p], owned_memory[p], 0) != VK_SUCCESS) {
+			owned_state.store(OWNED_FAILED);
+			return;
+		}
+	}
+	const Vector2i size = _scratch_size();
+	VkImageCreateInfo scratch_info = {};
+	scratch_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	scratch_info.imageType = VK_IMAGE_TYPE_2D;
+	scratch_info.format = VK_FORMAT_R8_UNORM;
+	scratch_info.extent = { (uint32_t)size.x, (uint32_t)size.y, 1 };
+	scratch_info.mipLevels = 1;
+	scratch_info.arrayLayers = 1;
+	scratch_info.samples = VK_SAMPLE_COUNT_1_BIT;
+	scratch_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+	scratch_info.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	if (vk->copy_queue_family != vk->queue_family) {
+		scratch_info.sharingMode = VK_SHARING_MODE_CONCURRENT;
+		scratch_info.queueFamilyIndexCount = 2;
+		scratch_info.pQueueFamilyIndices = families;
+	} else {
+		scratch_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	}
+	scratch_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	if (vk->vkCreateImage(vk->device, &scratch_info, nullptr, &scratch_image) != VK_SUCCESS) {
+		scratch_image = VK_NULL_HANDLE;
+		owned_state.store(OWNED_FAILED);
+		return;
+	}
+	VkMemoryRequirements requirements = {};
+	vk->vkGetImageMemoryRequirements(vk->device, scratch_image, &requirements);
+	const uint32_t memory_type = vk->find_memory_type(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0);
+	VkMemoryAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+	alloc_info.allocationSize = requirements.size;
+	alloc_info.memoryTypeIndex = memory_type;
+	if (memory_type == UINT32_MAX || vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &scratch_memory) != VK_SUCCESS) {
+		scratch_memory = VK_NULL_HANDLE;
+		owned_state.store(OWNED_FAILED);
+		return;
+	}
+	if (vk->vkBindImageMemory(vk->device, scratch_image, scratch_memory, 0) != VK_SUCCESS) {
+		owned_state.store(OWNED_FAILED);
+		return;
+	}
+	owned_state.store(OWNED_ALLOCATED);
+}
+
+Vector2i VPXPanorama::_scratch_size() const {
+	Vector2i size(1, 1);
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		size.x = std::max(size.x, level_extent(geometry[p].tile_width, 1));
+		size.y = std::max(size.y, geometry[p].height);
+	}
+	return size;
+}
+
+void VPXPanorama::_free_scratch() {
+	RenderingServer *rs = RenderingServer::get_singleton();
+	RD *rd = rs != nullptr ? rs->get_rendering_device() : nullptr;
+	if (scratch.is_valid() && rd != nullptr) {
+		rd->free_rid(scratch);
+	}
+	scratch = RID();
+	if (scratch_image != VK_NULL_HANDLE || scratch_memory != VK_NULL_HANDLE) {
+		vpx_retire_image(vk, scratch_image, scratch_memory);
+		scratch_image = VK_NULL_HANDLE;
+		scratch_memory = VK_NULL_HANDLE;
+	}
+}
+
+bool VPXPanorama::_import_owned_images() {
+	RD *rd = RenderingServer::get_singleton()->get_rendering_device();
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		const PlaneGeometry &g = geometry[p];
+		const int64_t usage = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_CAN_COPY_FROM_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+		const Variant imported = rd->call("texture_create_from_extension", layout == LAYOUT_CUBE ? RD::TEXTURE_TYPE_CUBE : RD::TEXTURE_TYPE_2D_ARRAY,
+				RD::DATA_FORMAT_R8_UNORM, RD::TEXTURE_SAMPLES_1, usage, (int64_t)(uint64_t)owned_images[p], g.tile_width, g.height, 1, layers, mips[p]);
+		rids[p] = imported;
+		if (!rids[p].is_valid()) {
+			return false;
+		}
+	}
+	const Vector2i size = _scratch_size();
+	scratch = rd->texture_create_from_extension(RD::TEXTURE_TYPE_2D, RD::DATA_FORMAT_R8_UNORM, RD::TEXTURE_SAMPLES_1,
+			RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT, (uint64_t)scratch_image, size.x, size.y, 1, 1);
+	return scratch.is_valid();
+}
+
+void VPXPanorama::_free_owned_images() {
+	RenderingServer *rs = RenderingServer::get_singleton();
+	RD *rd = rs != nullptr ? rs->get_rendering_device() : nullptr;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		if (owned_images[p] == VK_NULL_HANDLE && owned_memory[p] == VK_NULL_HANDLE) {
+			continue;
+		}
+		if (rids[p].is_valid() && rd != nullptr) {
+			rd->free_rid(rids[p]);
+		}
+		rids[p] = RID();
+		vpx_retire_image(vk, owned_images[p], owned_memory[p]);
+		owned_images[p] = VK_NULL_HANDLE;
+		owned_memory[p] = VK_NULL_HANDLE;
+	}
+}
+
+bool VPXPanorama::_submit_transfer() {
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		for (const LayerStore &store : stores[p]) {
+			if (store.pinned == nullptr) {
+				return false;
+			}
+		}
+	}
+	VkCommandPoolCreateInfo pool_info = {};
+	pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+	pool_info.queueFamilyIndex = vk->copy_queue_family;
+	if (vk->vkCreateCommandPool(vk->device, &pool_info, nullptr, &command_pool) != VK_SUCCESS) {
+		command_pool = VK_NULL_HANDLE;
+		return false;
+	}
+	VkCommandBufferAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+	alloc_info.commandPool = command_pool;
+	alloc_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+	alloc_info.commandBufferCount = 1;
+	VkFenceCreateInfo fence_info = {};
+	fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+	if (vk->vkAllocateCommandBuffers(vk->device, &alloc_info, &command_buffer) != VK_SUCCESS || vk->vkCreateFence(vk->device, &fence_info, nullptr, &fence) != VK_SUCCESS) {
+		return false;
+	}
+	VkCommandBufferBeginInfo begin_info = {};
+	begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+	begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+	if (vk->vkBeginCommandBuffer(command_buffer, &begin_info) != VK_SUCCESS) {
+		return false;
+	}
+	VkImageMemoryBarrier to_dst[PLANE_COUNT];
+	VkImageMemoryBarrier to_src[PLANE_COUNT];
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		VkImageMemoryBarrier &a = to_dst[p];
+		a = {};
+		a.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		a.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		a.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		a.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+		a.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		a.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		a.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		a.image = owned_images[p];
+		a.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, (uint32_t)mips[p], 0, (uint32_t)layers };
+		VkImageMemoryBarrier &b = to_src[p];
+		b = a;
+		b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	}
+	vk->vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, PLANE_COUNT, to_dst);
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		const PlaneGeometry &g = geometry[p];
+		for (int layer = 0; layer < layers; layer++) {
+			const LayerStore &store = stores[p][layer];
+			store.pinned->flush();
+			VkBufferImageCopy region = {};
+			region.bufferOffset = 0;
+			region.bufferRowLength = (uint32_t)store.width;
+			region.bufferImageHeight = 0;
+			region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, (uint32_t)layer, 1 };
+			region.imageOffset = { 0, 0, 0 };
+			region.imageExtent = { (uint32_t)g.tile_width, (uint32_t)g.height, 1 };
+			vk->vkCmdCopyBufferToImage(command_buffer, store.pinned->buffer, owned_images[p], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		}
+	}
+	async_mips = _record_async_mips();
+	if (!async_mips) {
+		vk->vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, PLANE_COUNT, to_src);
+	}
+	if (vk->vkEndCommandBuffer(command_buffer) != VK_SUCCESS) {
+		return false;
+	}
+	VkSubmitInfo submit = {};
+	submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+	submit.commandBufferCount = 1;
+	submit.pCommandBuffers = &command_buffer;
+	if (vk->vkQueueSubmit(vk->copy_queue, 1, &submit, fence) != VK_SUCCESS) {
+		return false;
+	}
+	transfer_in_flight = true;
+	used_dma = true;
+	transfer_submit_usec = panorama_usec();
+	return true;
+}
+
+bool VPXPanorama::_record_async_mips() {
+	PanoramaAsyncMips *async = ensure_async_mips(RenderingServer::get_singleton()->get_rendering_device(), vk);
+	if (async == nullptr || scratch_image == VK_NULL_HANDLE) {
+		return false;
+	}
+	std::vector<std::vector<VkImageView>> chains(PLANE_COUNT * layers);
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		for (int layer = 0; layer < layers; layer++) {
+			for (int level = 0; level < mips[p]; level++) {
+				VkImageViewCreateInfo view_info = {};
+				view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+				view_info.image = owned_images[p];
+				view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+				view_info.format = VK_FORMAT_R8_UNORM;
+				view_info.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, (uint32_t)level, 1, (uint32_t)layer, 1 };
+				VkImageView view = VK_NULL_HANDLE;
+				if (async->vkCreateImageView(vk->device, &view_info, nullptr, &view) != VK_SUCCESS) {
+					return false;
+				}
+				async_views.push_back(view);
+				chains[p * layers + layer].push_back(view);
+			}
+		}
+	}
+	VkImageViewCreateInfo scratch_view_info = {};
+	scratch_view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+	scratch_view_info.image = scratch_image;
+	scratch_view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+	scratch_view_info.format = VK_FORMAT_R8_UNORM;
+	scratch_view_info.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	VkImageView scratch_view = VK_NULL_HANDLE;
+	if (async->vkCreateImageView(vk->device, &scratch_view_info, nullptr, &scratch_view) != VK_SUCCESS) {
+		return false;
+	}
+	async_views.push_back(scratch_view);
+	uint32_t passes = 0;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		passes += (uint32_t)(mips[p] - 1) * layers * 2;
+	}
+	VkDescriptorPoolSize pool_size = { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, std::max(passes, 1u) * 2 };
+	VkDescriptorPoolCreateInfo pool_info = {};
+	pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+	pool_info.maxSets = std::max(passes, 1u);
+	pool_info.poolSizeCount = 1;
+	pool_info.pPoolSizes = &pool_size;
+	if (async->vkCreateDescriptorPool(vk->device, &pool_info, nullptr, &async_pool) != VK_SUCCESS) {
+		async_pool = VK_NULL_HANDLE;
+		return false;
+	}
+	std::vector<VkDescriptorSetLayout> set_layouts(passes, async->set_layout);
+	std::vector<VkDescriptorSet> sets(passes);
+	if (passes > 0) {
+		VkDescriptorSetAllocateInfo set_info = {};
+		set_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+		set_info.descriptorPool = async_pool;
+		set_info.descriptorSetCount = passes;
+		set_info.pSetLayouts = set_layouts.data();
+		if (async->vkAllocateDescriptorSets(vk->device, &set_info, sets.data()) != VK_SUCCESS) {
+			return false;
+		}
+	}
+
+	VkImageMemoryBarrier to_general[PLANE_COUNT + 1];
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		VkImageMemoryBarrier &b = to_general[p];
+		b = {};
+		b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+		b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+		b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.image = owned_images[p];
+		b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, (uint32_t)mips[p], 0, (uint32_t)layers };
+	}
+	VkImageMemoryBarrier &scratch_barrier = to_general[PLANE_COUNT];
+	scratch_barrier = to_general[0];
+	scratch_barrier.srcAccessMask = 0;
+	scratch_barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	scratch_barrier.image = scratch_image;
+	scratch_barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	vk->vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, PLANE_COUNT + 1, to_general);
+
+	async->vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, async->pipeline);
+	VkMemoryBarrier between = {};
+	between.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+	between.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+	between.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+	uint32_t next_set = 0;
+	const int max_mips = *std::max_element(mips, mips + PLANE_COUNT);
+	for (int level = 1; level < max_mips; level++) {
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			if (level >= mips[p]) {
+				continue;
+			}
+			const PlaneGeometry &g = geometry[p];
+			const Vector2i src(level_extent(g.tile_width, level - 1), level_extent(g.height, level - 1));
+			const Vector2i dst(level_extent(g.tile_width, level), level_extent(g.height, level));
+			const Vector2i half(dst.x, src.y);
+			for (int layer = 0; layer < layers; layer++) {
+				const std::vector<VkImageView> &chain = chains[p * layers + layer];
+				for (int pass = 0; pass < 2; pass++) {
+					const VkDescriptorSet set = sets[next_set++];
+					VkDescriptorImageInfo images[2] = {};
+					images[0].imageView = pass == 0 ? chain[level - 1] : scratch_view;
+					images[0].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+					images[1].imageView = pass == 0 ? scratch_view : chain[level];
+					images[1].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+					VkWriteDescriptorSet writes[2] = {};
+					for (int i = 0; i < 2; i++) {
+						writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+						writes[i].dstSet = set;
+						writes[i].dstBinding = i;
+						writes[i].descriptorCount = 1;
+						writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+						writes[i].pImageInfo = &images[i];
+					}
+					async->vkUpdateDescriptorSets(vk->device, 2, writes, 0, nullptr);
+					const Vector2i from = pass == 0 ? src : half;
+					const Vector2i to = pass == 0 ? half : dst;
+					const int32_t constants[8] = { from.x, from.y, to.x, to.y, pass, 0, 0, 0 };
+					async->vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, async->pipeline_layout, 0, 1, &set, 0, nullptr);
+					async->vkCmdPushConstants(command_buffer, async->pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
+					async->vkCmdDispatch(command_buffer, (to.x + 7) / 8, (to.y + 7) / 8, 1);
+					vk->vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &between, 0, nullptr, 0, nullptr);
+				}
+			}
+		}
+	}
+
+	VkImageMemoryBarrier to_tracked[PLANE_COUNT + 1];
+	for (int p = 0; p < PLANE_COUNT + 1; p++) {
+		VkImageMemoryBarrier &b = to_tracked[p];
+		b = to_general[p];
+		b.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+		b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		b.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+		b.newLayout = p < PLANE_COUNT ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	}
+	vk->vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr, 0, nullptr, PLANE_COUNT + 1, to_tracked);
+	return true;
+}
+
+void VPXPanorama::_free_async_mips() {
+	if (panorama_async == nullptr) {
+		async_views.clear();
+		async_pool = VK_NULL_HANDLE;
+		return;
+	}
+	for (VkImageView view : async_views) {
+		panorama_async->vkDestroyImageView(vk->device, view, nullptr);
+	}
+	async_views.clear();
+	if (async_pool != VK_NULL_HANDLE) {
+		panorama_async->vkDestroyDescriptorPool(vk->device, async_pool, nullptr);
+		async_pool = VK_NULL_HANDLE;
+	}
+}
+
+void VPXPanorama::_finish_transfer() {
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		for (LayerStore &store : stores[p]) {
+			_release_store(store);
+		}
+	}
+	_free_transfer(true);
+}
+
+bool VPXPanorama::_upload_staged() {
+	RD *rd = RenderingServer::get_singleton()->get_rendering_device();
+	const int64_t begin = panorama_usec();
+	Ref<RDTextureView> view;
+	view.instantiate();
+	std::vector<RID> transient;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		const PlaneGeometry &g = geometry[p];
+		Ref<RDTextureFormat> staging;
+		staging.instantiate();
+		staging->set_format(RD::DATA_FORMAT_R8_UNORM);
+		staging->set_texture_type(RD::TEXTURE_TYPE_2D);
+		staging->set_width(g.tile_width);
+		staging->set_height(g.height);
+		staging->set_depth(1);
+		staging->set_array_layers(1);
+		staging->set_mipmaps(1);
+		staging->set_usage_bits(RD::TEXTURE_USAGE_CAN_UPDATE_BIT | RD::TEXTURE_USAGE_CAN_COPY_FROM_BIT);
+		for (int layer = 0; layer < layers; layer++) {
+			LayerStore &store = stores[p][layer];
+			PackedByteArray bytes = store.bytes;
+			if (store.pinned != nullptr) {
+				bytes.resize(store.size);
+				memcpy(bytes.ptrw(), store.data, store.size);
+			}
+			TypedArray<PackedByteArray> initial;
+			initial.push_back(bytes);
+			const RID upload_rid = rd->texture_create(staging, view, initial);
+			_release_store(store);
+			if (!upload_rid.is_valid()) {
+				_fail("cannot upload panorama layer");
+				return false;
+			}
+			rd->texture_copy(upload_rid, rids[p], Vector3(), Vector3(), Vector3(g.tile_width, g.height, 1), 0, 0, 0, layer);
+			transient.push_back(upload_rid);
+		}
+	}
+	for (const RID &upload_rid : transient) {
+		rd->free_rid(upload_rid);
+	}
+	upload_cpu_usec = panorama_usec() - begin;
+	return true;
+}
+
+void VPXPanorama::_queue_mips() {
+	stage = STAGE_MIPS;
+	mip_start_usec = panorama_usec();
+	mip_jobs.clear();
+	next_mip_job = 0;
+	const int max_mips = *std::max_element(mips, mips + PLANE_COUNT);
+	for (int level = 1; level < max_mips; level++) {
+		for (int p = 0; p < PLANE_COUNT; p++) {
+			if (level >= mips[p]) {
+				continue;
+			}
+			const PlaneGeometry &g = geometry[p];
+			const int width = level_extent(g.tile_width, level);
+			const int band = std::max(8, (int)std::min<int64_t>(1 << 20, mip_budget / std::max<int64_t>((int64_t)width * MIP_TAPS, 1)));
+			for (int layer = 0; layer < layers; layer++) {
+				for (int pass = 0; pass < 2; pass++) {
+					const int rows = pass == 0 ? level_extent(g.height, level - 1) : level_extent(g.height, level);
+					for (int row = 0; row < rows; row += band) {
+						mip_jobs.push_back({ p, layer, level, pass, row, std::min(band, rows - row) });
+					}
+				}
+			}
+		}
+	}
+}
+
+static RID mip_uniform_set(RD *p_rd, const RID &p_shader, const RID &p_src, const RID &p_dst) {
+	Ref<RDUniform> src;
+	src.instantiate();
+	src->set_binding(0);
+	src->set_uniform_type(RD::UNIFORM_TYPE_IMAGE);
+	src->add_id(p_src);
+	Ref<RDUniform> dst;
+	dst.instantiate();
+	dst->set_binding(1);
+	dst->set_uniform_type(RD::UNIFORM_TYPE_IMAGE);
+	dst->add_id(p_dst);
+	TypedArray<RDUniform> uniforms;
+	uniforms.push_back(src);
+	uniforms.push_back(dst);
+	return p_rd->uniform_set_create(uniforms, p_shader, 0);
+}
+
+static PackedByteArray mip_push_constant(const Vector2i &p_src, const Vector2i &p_dst, int p_axis, int p_row) {
+	PackedByteArray bytes;
+	bytes.resize(32);
+	int32_t *values = reinterpret_cast<int32_t *>(bytes.ptrw());
+	values[0] = p_src.x;
+	values[1] = p_src.y;
+	values[2] = p_dst.x;
+	values[3] = p_dst.y;
+	values[4] = p_axis;
+	values[5] = p_row;
+	values[6] = 0;
+	values[7] = 0;
+	return bytes;
+}
+
+void VPXPanorama::_run_mips() {
+	if (next_mip_job >= mip_jobs.size()) {
+		return;
+	}
+	RD *rd = RenderingServer::get_singleton()->get_rendering_device();
+	std::vector<RID> sets;
+	Ref<RDTextureView> slice_view;
+	slice_view.instantiate();
+	const int64_t list = rd->compute_list_begin();
+	rd->compute_list_bind_compute_pipeline(list, panorama_mip->pipeline);
+	int64_t spent = 0;
+	while (next_mip_job < mip_jobs.size() && (spent == 0 || spent < mip_budget)) {
+		const MipJob &job = mip_jobs[next_mip_job++];
+		const PlaneGeometry &g = geometry[job.plane];
+		std::vector<RID> &chain = level_views[job.plane * layers + job.layer];
+		for (int level = job.level - 1; level <= job.level; level++) {
+			if (!chain[level].is_valid()) {
+				chain[level] = rd->texture_create_shared_from_slice(slice_view, rids[job.plane], job.layer, level, 1, RD::TEXTURE_SLICE_2D);
+			}
+		}
+		const Vector2i src(level_extent(g.tile_width, job.level - 1), level_extent(g.height, job.level - 1));
+		const Vector2i dst(level_extent(g.tile_width, job.level), level_extent(g.height, job.level));
+		const Vector2i half(dst.x, src.y);
+		const bool horizontal = job.pass == 0;
+		const RID set = horizontal ? mip_uniform_set(rd, panorama_mip->shader, chain[job.level - 1], scratch) : mip_uniform_set(rd, panorama_mip->shader, scratch, chain[job.level]);
+		sets.push_back(set);
+		rd->compute_list_bind_uniform_set(list, set, 0);
+		rd->compute_list_set_push_constant(list, horizontal ? mip_push_constant(src, half, 0, job.row) : mip_push_constant(half, dst, 1, job.row), 32);
+		rd->compute_list_dispatch(list, (half.x + 7) / 8, (job.rows + 7) / 8, 1);
+		rd->compute_list_add_barrier(list);
+		spent += (int64_t)half.x * job.rows * MIP_TAPS;
+	}
+	rd->compute_list_end();
+	for (const RID &set : sets) {
+		rd->free_rid(set);
+	}
+	mip_frames++;
+}
+
+void VPXPanorama::_finish() {
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		if (layout == LAYOUT_CUBE) {
+			Ref<TextureCubemapRD> texture;
+			texture.instantiate();
+			texture->set_texture_rd_rid(rids[p]);
+			textures[p] = texture;
+		} else {
+			Ref<Texture2DArrayRD> texture;
+			texture.instantiate();
+			texture->set_texture_rd_rid(rids[p]);
+			textures[p] = texture;
+		}
+		stores[p].clear();
+	}
+	_free_mip_resources();
+	ready_usec = panorama_usec();
+	stage = STAGE_READY;
+}
+
+void VPXPanorama::_free_transfer(bool p_release_stores) {
+	if (vk && transfer_in_flight && fence != VK_NULL_HANDLE) {
+		vk->vkWaitForFences(vk->device, 1, &fence, VK_TRUE, 2000000000ull);
+		transfer_in_flight = false;
+	}
+	if (vk) {
+		_free_async_mips();
+	}
+	for (int p = 0; p < PLANE_COUNT && p_release_stores; p++) {
+		for (LayerStore &store : stores[p]) {
+			_release_store(store);
+		}
+	}
+	if (vk && fence != VK_NULL_HANDLE) {
+		vk->vkDestroyFence(vk->device, fence, nullptr);
+		fence = VK_NULL_HANDLE;
+	}
+	if (vk && command_pool != VK_NULL_HANDLE) {
+		vk->vkDestroyCommandPool(vk->device, command_pool, nullptr);
+		command_pool = VK_NULL_HANDLE;
+		command_buffer = VK_NULL_HANDLE;
+	}
+}
+
+void VPXPanorama::_free_mip_resources() {
+	RenderingServer *rs = RenderingServer::get_singleton();
+	RD *rd = rs != nullptr ? rs->get_rendering_device() : nullptr;
+	if (rd == nullptr) {
+		return;
+	}
+	for (std::vector<RID> &chain : level_views) {
+		for (const RID &slice : chain) {
+			if (slice.is_valid()) {
+				rd->free_rid(slice);
+			}
+		}
+	}
+	level_views.clear();
+	_free_scratch();
+	mip_jobs.clear();
+}
+
+void VPXPanorama::_free_gpu() {
+	RenderingServer *rs = RenderingServer::get_singleton();
+	RD *rd = rs != nullptr ? rs->get_rendering_device() : nullptr;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		if (textures[p].is_valid()) {
+			Ref<TextureLayeredRD> layered = textures[p];
+			if (layered.is_valid()) {
+				layered->set_texture_rd_rid(RID());
+			}
+			textures[p].unref();
+		}
+	}
+	_free_owned_images();
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		if (rids[p].is_valid() && rd != nullptr) {
+			rd->free_rid(rids[p]);
+		}
+		rids[p] = RID();
+	}
+}
+
+Ref<Texture> VPXPanorama::get_plane(int p_plane) const {
+	ERR_FAIL_INDEX_V(p_plane, PLANE_COUNT, Ref<Texture>());
+	return textures[p_plane];
+}
+
+Dictionary VPXPanorama::get_info() {
+	Dictionary info;
+	info["layout"] = (int)layout;
+	info["width"] = image_width;
+	info["height"] = image_height;
+	info["face_size"] = face_size;
+	info["tiles"] = tiles;
+	info["layers"] = layers;
+	info["wrap"] = wrap;
+	info["rgb"] = rgb_planes;
+	info["scale_denom"] = scale_denom;
+	info["ready"] = stage == STAGE_READY;
+	info["stage"] = (int)stage;
+	info["dma"] = used_dma;
+	info["image_path"] = image_path;
+	info["async_mips"] = async_mips;
+	info["error"] = get_error();
+	Array planes;
+	int64_t bytes = 0;
+	for (int p = 0; p < PLANE_COUNT; p++) {
+		const PlaneGeometry &g = geometry[p];
+		Dictionary plane;
+		plane["width"] = g.width;
+		plane["height"] = g.height;
+		plane["tile_width"] = g.tile_width;
+		plane["core"] = g.core;
+		plane["gutter"] = g.gutter;
+		planes.push_back(plane);
+		bytes += (int64_t)g.tile_width * g.height * layers * 4 / 3;
+	}
+	info["planes"] = planes;
+	info["vram_bytes"] = bytes;
+	info["read_msec"] = read_usec.load() / 1000.0;
+	info["alloc_msec"] = alloc_usec.load() / 1000.0;
+	info["decode_msec"] = decode_usec.load() / 1000.0;
+	const int64_t decoded_at = decoded_at_usec.load();
+	info["decoded_msec"] = decoded_at > 0 ? (decoded_at - (int64_t)start_usec) / 1000.0 : -1.0;
+	info["transfer_msec"] = transfer_done_usec > 0 ? (transfer_done_usec - transfer_submit_usec) / 1000.0 : 0.0;
+	info["upload_msec"] = upload_cpu_usec / 1000.0;
+	info["mip_msec"] = ready_usec > 0 ? (ready_usec - mip_start_usec) / 1000.0 : 0.0;
+	info["mip_frames"] = mip_frames;
+	info["slowest_poll_msec"] = slowest_poll_usec / 1000.0;
+	info["slowest_poll_stage"] = slowest_poll_stage;
+	info["ready_msec"] = ready_usec > 0 ? (ready_usec - (int64_t)start_usec) / 1000.0 : -1.0;
+	return info;
+}
+
+void VPXPanorama::_bind_methods() {
+	ClassDB::bind_static_method("VPXPanorama", D_METHOD("probe", "path"), &VPXPanorama::probe);
+	ClassDB::bind_method(D_METHOD("start", "paths", "layout", "wrap"), &VPXPanorama::start);
+	ClassDB::bind_method(D_METHOD("poll"), &VPXPanorama::poll);
+	ClassDB::bind_method(D_METHOD("is_decoded"), &VPXPanorama::is_decoded);
+	ClassDB::bind_method(D_METHOD("get_error"), &VPXPanorama::get_error);
+	ClassDB::bind_method(D_METHOD("cancel"), &VPXPanorama::cancel);
+	ClassDB::bind_method(D_METHOD("abort"), &VPXPanorama::abort);
+	ClassDB::bind_method(D_METHOD("get_plane", "plane"), &VPXPanorama::get_plane);
+	ClassDB::bind_method(D_METHOD("get_info"), &VPXPanorama::get_info);
+	BIND_ENUM_CONSTANT(LAYOUT_TILED);
+	BIND_ENUM_CONSTANT(LAYOUT_CUBE);
+	BIND_ENUM_CONSTANT(STATUS_LOADING);
+	BIND_ENUM_CONSTANT(STATUS_READY);
+	BIND_ENUM_CONSTANT(STATUS_FAILED);
+}
+
+#endif // GDEXTENSION

