diff --git a/vpx_subtitles.cpp b/vpx_subtitles.cpp
new file mode 100644
index 0000000..9902003
--- /dev/null
+++ b/vpx_subtitles.cpp
@@ -0,0 +1,393 @@
+#ifdef GDEXTENSION
+
+#include "vpx_subtitles.h"
+
+#include <godot_cpp/classes/file_access.hpp>
+#include <godot_cpp/core/class_db.hpp>
+#include <godot_cpp/core/math.hpp>
+
+#include <algorithm>
+#include <cstring>
+
+extern "C" {
+#include "libavutil/mem.h"
+}
+
+namespace {
+
+const char32_t CP1252_HIGH[32] = {
+	0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
+	0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178
+};
+
+struct MemoryReader {
+	const uint8_t *data = nullptr;
+	int64_t size = 0;
+	int64_t position = 0;
+};
+
+int memory_read(void *p_opaque, uint8_t *p_buffer, int p_size) {
+	MemoryReader *reader = static_cast<MemoryReader *>(p_opaque);
+	const int64_t left = reader->size - reader->position;
+	if (left <= 0) {
+		return AVERROR_EOF;
+	}
+	const int count = (int)std::min<int64_t>(left, p_size);
+	memcpy(p_buffer, reader->data + reader->position, count);
+	reader->position += count;
+	return count;
+}
+
+int64_t memory_seek(void *p_opaque, int64_t p_offset, int p_whence) {
+	MemoryReader *reader = static_cast<MemoryReader *>(p_opaque);
+	if (p_whence == AVSEEK_SIZE) {
+		return reader->size;
+	}
+	int64_t target = 0;
+	switch (p_whence & ~AVSEEK_FORCE) {
+		case SEEK_SET:
+			target = p_offset;
+			break;
+		case SEEK_CUR:
+			target = reader->position + p_offset;
+			break;
+		case SEEK_END:
+			target = reader->size + p_offset;
+			break;
+		default:
+			return -1;
+	}
+	if (target < 0 || target > reader->size) {
+		return -1;
+	}
+	reader->position = target;
+	return target;
+}
+
+bool is_valid_utf8(const uint8_t *p_data, int64_t p_size) {
+	int64_t i = 0;
+	while (i < p_size) {
+		const uint8_t c = p_data[i];
+		int extra = 0;
+		if (c < 0x80) {
+			i++;
+			continue;
+		} else if ((c & 0xE0) == 0xC0 && c >= 0xC2) {
+			extra = 1;
+		} else if ((c & 0xF0) == 0xE0) {
+			extra = 2;
+		} else if ((c & 0xF8) == 0xF0 && c <= 0xF4) {
+			extra = 3;
+		} else {
+			return false;
+		}
+		if (i + extra >= p_size) {
+			return false;
+		}
+		for (int k = 1; k <= extra; k++) {
+			if ((p_data[i + k] & 0xC0) != 0x80) {
+				return false;
+			}
+		}
+		i += extra + 1;
+	}
+	return true;
+}
+
+String dialogue_text(const char *p_ass) {
+	const char *cursor = p_ass;
+	for (int commas = 0; commas < 8 && *cursor; cursor++) {
+		if (*cursor == ',') {
+			commas++;
+		}
+	}
+	return String::utf8(cursor);
+}
+
+Ref<Image> bitmap_image(const AVSubtitleRect *p_rect) {
+	if (p_rect->w <= 0 || p_rect->h <= 0 || p_rect->data[0] == nullptr || p_rect->data[1] == nullptr) {
+		return Ref<Image>();
+	}
+	const uint32_t *palette = reinterpret_cast<const uint32_t *>(p_rect->data[1]);
+	PackedByteArray pixels;
+	pixels.resize((int64_t)p_rect->w * p_rect->h * 4);
+	uint8_t *out = pixels.ptrw();
+	for (int y = 0; y < p_rect->h; y++) {
+		const uint8_t *row = p_rect->data[0] + (int64_t)y * p_rect->linesize[0];
+		for (int x = 0; x < p_rect->w; x++) {
+			const uint8_t index = row[x];
+			const uint32_t argb = index < p_rect->nb_colors ? palette[index] : 0;
+			*out++ = (argb >> 16) & 0xFF;
+			*out++ = (argb >> 8) & 0xFF;
+			*out++ = argb & 0xFF;
+			*out++ = (argb >> 24) & 0xFF;
+		}
+	}
+	return Image::create_from_data(p_rect->w, p_rect->h, false, Image::FORMAT_RGBA8, pixels);
+}
+
+}
+
+void VPXSubtitles::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("load_file", "path"), &VPXSubtitles::load_file);
+	ClassDB::bind_method(D_METHOD("get_active", "time_msec"), &VPXSubtitles::get_active);
+	ClassDB::bind_method(D_METHOD("get_events"), &VPXSubtitles::get_events);
+	ClassDB::bind_method(D_METHOD("get_event_count"), &VPXSubtitles::get_event_count);
+	ClassDB::bind_method(D_METHOD("get_codec_name"), &VPXSubtitles::get_codec_name);
+	ClassDB::bind_method(D_METHOD("get_error"), &VPXSubtitles::get_error);
+	ClassDB::bind_method(D_METHOD("clear"), &VPXSubtitles::clear);
+}
+
+void VPXSubtitles::clear() {
+	std::lock_guard<std::mutex> lock(mutex);
+	events.clear();
+}
+
+void VPXSubtitles::_close_open(double p_start) {
+	for (Event &event : events) {
+		if (event.end >= OPEN_END_MSEC && event.start < p_start) {
+			event.end = p_start;
+		}
+	}
+}
+
+void VPXSubtitles::_insert(Event &p_event) {
+	for (const Event &event : events) {
+		if (Math::abs(event.start - p_event.start) < 1.0 && event.text == p_event.text && event.rect == p_event.rect) {
+			return;
+		}
+	}
+	p_event.id = next_id++;
+	auto position = std::upper_bound(events.begin(), events.end(), p_event.start, [](double p_start, const Event &p_other) {
+		return p_start < p_other.start;
+	});
+	events.insert(position, p_event);
+}
+
+void VPXSubtitles::_prune_bitmaps(double p_clock) {
+	int bitmaps = 0;
+	for (const Event &event : events) {
+		bitmaps += event.image.is_valid() ? 1 : 0;
+	}
+	if (bitmaps <= MAX_BITMAP_EVENTS || p_clock < 0.0) {
+		return;
+	}
+	std::vector<double> distances;
+	for (const Event &event : events) {
+		if (event.image.is_valid()) {
+			distances.push_back(Math::abs(event.start - p_clock));
+		}
+	}
+	std::sort(distances.begin(), distances.end());
+	const double limit = distances[KEEP_BITMAP_EVENTS - 1];
+	events.erase(std::remove_if(events.begin(), events.end(), [&](const Event &p_event) {
+		return p_event.image.is_valid() && Math::abs(p_event.start - p_clock) > limit;
+	}),
+			events.end());
+}
+
+void VPXSubtitles::add_subtitle(const AVSubtitle &p_subtitle, double p_base_msec, int p_canvas_width, int p_canvas_height, double p_clock_msec) {
+	const double start = p_base_msec + p_subtitle.start_display_time;
+	const bool timed = p_subtitle.end_display_time > p_subtitle.start_display_time && p_subtitle.end_display_time != UINT32_MAX;
+	const double end = timed ? p_base_msec + p_subtitle.end_display_time : OPEN_END_MSEC;
+	std::lock_guard<std::mutex> lock(mutex);
+	_close_open(start);
+	for (unsigned i = 0; i < p_subtitle.num_rects; i++) {
+		const AVSubtitleRect *rect = p_subtitle.rects[i];
+		Event event;
+		event.start = start;
+		event.end = end;
+		if (rect->type == SUBTITLE_ASS && rect->ass != nullptr) {
+			event.text = dialogue_text(rect->ass);
+			event.ass = true;
+		} else if (rect->type == SUBTITLE_TEXT && rect->text != nullptr) {
+			event.text = String::utf8(rect->text);
+		} else if (rect->type == SUBTITLE_BITMAP) {
+			event.image = bitmap_image(rect);
+			if (event.image.is_null()) {
+				continue;
+			}
+			const double width = MAX(p_canvas_width, 1);
+			const double height = MAX(p_canvas_height, 1);
+			event.rect = Rect2(rect->x / width, rect->y / height, rect->w / width, rect->h / height);
+		} else {
+			continue;
+		}
+		if (event.image.is_null() && event.text.strip_edges().is_empty()) {
+			continue;
+		}
+		_insert(event);
+	}
+	_prune_bitmaps(p_clock_msec);
+}
+
+Dictionary VPXSubtitles::_to_dictionary(const Event &p_event) {
+	Dictionary result;
+	result["id"] = p_event.id;
+	result["start"] = p_event.start;
+	result["end"] = p_event.end;
+	result["text"] = p_event.text;
+	result["ass"] = p_event.ass;
+	if (p_event.image.is_valid()) {
+		result["image"] = p_event.image;
+		result["rect"] = p_event.rect;
+	}
+	return result;
+}
+
+Array VPXSubtitles::get_active(double p_time_msec) const {
+	Array result;
+	std::lock_guard<std::mutex> lock(mutex);
+	for (const Event &event : events) {
+		if (event.start > p_time_msec) {
+			break;
+		}
+		if (p_time_msec < event.end) {
+			result.push_back(_to_dictionary(event));
+		}
+	}
+	return result;
+}
+
+Array VPXSubtitles::get_events() const {
+	Array result;
+	std::lock_guard<std::mutex> lock(mutex);
+	for (const Event &event : events) {
+		Dictionary entry = _to_dictionary(event);
+		entry.erase("image");
+		result.push_back(entry);
+	}
+	return result;
+}
+
+int VPXSubtitles::get_event_count() const {
+	std::lock_guard<std::mutex> lock(mutex);
+	return (int)events.size();
+}
+
+PackedByteArray VPXSubtitles::normalize_text_encoding(const PackedByteArray &p_bytes) {
+	const int64_t size = p_bytes.size();
+	const uint8_t *data = p_bytes.ptr();
+	if (size >= 2 && ((data[0] == 0xFF && data[1] == 0xFE) || (data[0] == 0xFE && data[1] == 0xFF))) {
+		const bool big_endian = data[0] == 0xFE;
+		std::vector<char16_t> units;
+		units.reserve(size / 2);
+		for (int64_t i = 2; i + 1 < size; i += 2) {
+			units.push_back(big_endian ? char16_t((data[i] << 8) | data[i + 1]) : char16_t(data[i] | (data[i + 1] << 8)));
+		}
+		return String::utf16(units.data(), (int64_t)units.size()).to_utf8_buffer();
+	}
+	if (is_valid_utf8(data, size)) {
+		return p_bytes;
+	}
+	String text;
+	for (int64_t i = 0; i < size; i++) {
+		const uint8_t c = data[i];
+		text += c >= 0x80 && c < 0xA0 ? CP1252_HIGH[c - 0x80] : char32_t(c);
+	}
+	return text.to_utf8_buffer();
+}
+
+bool VPXSubtitles::load_file(const String &p_path) {
+	clear();
+	error = String();
+	PackedByteArray raw = FileAccess::get_file_as_bytes(p_path);
+	if (raw.is_empty()) {
+		error = "cannot read file";
+		return false;
+	}
+	const String extension = p_path.get_extension().to_lower();
+	PackedByteArray bytes = extension == "sup" ? raw : normalize_text_encoding(raw);
+	MemoryReader reader;
+	reader.data = bytes.ptr();
+	reader.size = bytes.size();
+	const int buffer_size = 64 * 1024;
+	uint8_t *buffer = (uint8_t *)av_malloc(buffer_size);
+	AVIOContext *io = avio_alloc_context(buffer, buffer_size, 0, &reader, &memory_read, nullptr, &memory_seek);
+	AVFormatContext *format = avformat_alloc_context();
+	format->pb = io;
+	format->flags |= AVFMT_FLAG_CUSTOM_IO;
+	AVCodecContext *codec_context = nullptr;
+	AVPacket *packet = av_packet_alloc();
+	bool ok = false;
+	int stream_index = -1;
+	const AVCodec *codec = nullptr;
+	if (avformat_open_input(&format, p_path.get_file().utf8().get_data(), nullptr, nullptr) < 0) {
+		error = "unrecognised subtitle format";
+		format = nullptr;
+		goto done;
+	}
+	avformat_find_stream_info(format, nullptr);
+	for (unsigned i = 0; i < format->nb_streams; i++) {
+		if (format->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_SUBTITLE) {
+			stream_index = i;
+			break;
+		}
+	}
+	if (stream_index < 0) {
+		error = "no subtitle stream";
+		goto done;
+	}
+	codec = avcodec_find_decoder(format->streams[stream_index]->codecpar->codec_id);
+	if (codec == nullptr) {
+		error = "no decoder";
+		goto done;
+	}
+	codec_context = avcodec_alloc_context3(codec);
+	avcodec_parameters_to_context(codec_context, format->streams[stream_index]->codecpar);
+	codec_context->pkt_timebase = format->streams[stream_index]->time_base;
+	if (avcodec_open2(codec_context, codec, nullptr) < 0) {
+		error = "cannot open decoder";
+		goto done;
+	}
+	codec_name = codec->name;
+	while (av_read_frame(format, packet) >= 0) {
+		if (packet->stream_index == stream_index) {
+			AVSubtitle subtitle;
+			int got = 0;
+			if (avcodec_decode_subtitle2(codec_context, &subtitle, &got, packet) >= 0 && got) {
+				const double base = subtitle.pts != AV_NOPTS_VALUE ? subtitle.pts / 1000.0 : packet->pts * av_q2d(format->streams[stream_index]->time_base) * 1000.0;
+				add_subtitle(subtitle, base, codec_context->width, codec_context->height, -1.0);
+				avsubtitle_free(&subtitle);
+			}
+		}
+		av_packet_unref(packet);
+	}
+	ok = true;
+done:
+	av_packet_free(&packet);
+	if (codec_context != nullptr) {
+		avcodec_free_context(&codec_context);
+	}
+	if (format != nullptr) {
+		avformat_close_input(&format);
+	} else {
+		avformat_free_context(format);
+	}
+	if (io != nullptr) {
+		av_freep(&io->buffer);
+		avio_context_free(&io);
+	}
+	return ok;
+}
+
+Dictionary VPXSubtitles::stream_info(const AVStream *p_stream) {
+	Dictionary info;
+	info["index"] = p_stream->index;
+	const AVDictionaryEntry *language = av_dict_get(p_stream->metadata, "language", nullptr, 0);
+	const AVDictionaryEntry *title = av_dict_get(p_stream->metadata, "title", nullptr, 0);
+	info["language"] = language ? String::utf8(language->value) : String();
+	info["title"] = title ? String::utf8(title->value) : String();
+	info["codec"] = String(avcodec_get_name(p_stream->codecpar->codec_id));
+	info["channels"] = p_stream->codecpar->ch_layout.nb_channels;
+	info["sample_rate"] = p_stream->codecpar->sample_rate;
+	info["default"] = (p_stream->disposition & AV_DISPOSITION_DEFAULT) != 0;
+	info["forced"] = (p_stream->disposition & AV_DISPOSITION_FORCED) != 0;
+	info["hearing_impaired"] = (p_stream->disposition & AV_DISPOSITION_HEARING_IMPAIRED) != 0;
+	info["commentary"] = (p_stream->disposition & AV_DISPOSITION_COMMENT) != 0;
+	const AVCodecDescriptor *descriptor = avcodec_descriptor_get(p_stream->codecpar->codec_id);
+	info["bitmap"] = descriptor != nullptr && (descriptor->props & AV_CODEC_PROP_BITMAP_SUB) != 0;
+	return info;
+}
+
+#endif
