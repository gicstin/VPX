+		int layer = 0;
+		int level = 0;
+		int pass = 0;
+		int row = 0;
+		int rows = 0;
+	};
+
+private:
+	enum OwnedState {
+		OWNED_PENDING,
+		OWNED_ALLOCATED,
+		OWNED_FAILED,
+	};
+
+	enum Stage {
+		STAGE_DECODING,
+		STAGE_TRANSFER,
+		STAGE_MIPS,
+		STAGE_READY,
+		STAGE_FAILED,
+	};
+
+	Layout layout = LAYOUT_TILED;
+	Stage stage = STAGE_DECODING;
+	bool wrap = true;
+	int max_size = 16384;
+	int64_t mip_budget = 0;
+	PackedStringArray paths;
+
+	std::vector<std::thread> workers;
+	std::atomic<int> running{ 0 };
+	std::atomic<bool> cancelled{ false };
+	std::atomic<bool> geometry_ready{ false };
+	std::atomic<int> owned_state{ OWNED_PENDING };
+	std::mutex mutex;
+	String error;
+
+	int layers = 0;
+	int tiles = 1;
+	int face_size = 0;
+	int image_width = 0;
+	int image_height = 0;
+	int scale_denom = 1;
+	bool rgb_planes = false;
+	bool image_path = false;
+	PlaneGeometry geometry[PLANE_COUNT];
+	std::vector<LayerStore> stores[PLANE_COUNT];
+	std::vector<Ref<Image>> images[PLANE_COUNT];
+	std::vector<Vector2i> face_sizes;
+	FaceTemp face_temps[CUBE_FACES][PLANE_COUNT];
+	int cube_target = 0;
+
+	std::shared_ptr<VpxVulkanDevice> vk;
+	PanoramaPinnedPool *pool = nullptr;
+	VkImage owned_images[PLANE_COUNT] = {};
+	VkDeviceMemory owned_memory[PLANE_COUNT] = {};
+	VkImage scratch_image = VK_NULL_HANDLE;
+	VkDeviceMemory scratch_memory = VK_NULL_HANDLE;
+	VkCommandPool command_pool = VK_NULL_HANDLE;
+	VkCommandBuffer command_buffer = VK_NULL_HANDLE;
+	VkFence fence = VK_NULL_HANDLE;
+	bool transfer_in_flight = false;
+	bool async_mips = false;
+	std::vector<VkImageView> async_views;
+	VkDescriptorPool async_pool = VK_NULL_HANDLE;
+	bool gpu_prepared = false;
+	uint64_t prime_frame = 0;
+
+	RID rids[PLANE_COUNT];
+	RID scratch;
+	int mips[PLANE_COUNT] = {};
+	std::vector<std::vector<RID>> level_views;
+	std::vector<MipJob> mip_jobs;
+	size_t next_mip_job = 0;
+	int mip_frames = 0;
+	Ref<Texture> textures[PLANE_COUNT];
+
+	uint64_t start_usec = 0;
+	std::atomic<int64_t> read_usec{ 0 };
+	std::atomic<int64_t> alloc_usec{ 0 };
+	std::atomic<int64_t> decode_usec{ 0 };
+	std::atomic<int64_t> decoded_at_usec{ 0 };
+	int64_t transfer_submit_usec = 0;
+	int64_t transfer_done_usec = 0;
+	int64_t upload_cpu_usec = 0;
+	int64_t mip_start_usec = 0;
+	int64_t ready_usec = 0;
+	bool used_dma = false;
+	int64_t slowest_poll_usec = 0;
+	int slowest_poll_stage = 0;
+
+	void _fail(const String &p_message);
+	void _decode_tiled();
+	void _launch_cube();
+	void _decode_face(int p_face);
+	void _finish_worker();
+	bool _decode_file(const String &p_path, int p_slot);
+	void _scatter_row(int p_plane, int p_slot, int p_row, const uint8_t *p_src);
+	void _prepare_tiles(int p_width, int p_height, const int p_ratio_x[PLANE_COUNT], const int p_ratio_y[PLANE_COUNT]);
+	void _prepare_face(int p_slot, int p_width, int p_height, const int p_ratio_x[PLANE_COUNT], const int p_ratio_y[PLANE_COUNT]);
+	void _allocate_store(LayerStore &r_store, int p_width, int p_height);
+	void _release_store(LayerStore &r_store);
+	void _fill_neutral_chroma(int p_slot);
+	void _build_images(int p_slot);
+	bool _create_image_textures();
+	void _join();
+
+	int _poll();
+	bool _prepare_gpu();
+	void _allocate_owned_images();
+	bool _import_owned_images();
+	Vector2i _scratch_size() const;
+	void _free_scratch();
+	void _free_owned_images();
+	bool _submit_transfer();
+	void _finish_transfer();
+	bool _record_async_mips();
+	void _free_async_mips();
+	bool _upload_staged();
+	void _queue_mips();
+	void _run_mips();
+	void _finish();
+	void _free_transfer(bool p_release_stores);
+	void _free_mip_resources();
+	void _free_gpu();
+
+protected:
+	static void _bind_methods();
+
+public:
+	static Dictionary probe(const String &p_path);
+
+	Error start(const PackedStringArray &p_paths, int p_layout, bool p_wrap);
+	int poll();
+	bool is_decoded() const;
+	String get_error();
+	void cancel();
+	void abort();
+	Ref<Texture> get_plane(int p_plane) const;
+	Dictionary get_info();
+
+	VPXPanorama();
+	~VPXPanorama();
+};
+
+VARIANT_ENUM_CAST(VPXPanorama::Layout);
+VARIANT_ENUM_CAST(VPXPanorama::Status);
