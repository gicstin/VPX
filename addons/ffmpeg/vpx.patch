+	void set_spatial(bool p_spatial);
+	void set_dialogue_boost(float p_amount) { dialogue = p_amount; }
+	void set_listener(const Basis &p_head_in_field) { listener = p_head_in_field.orthonormalized(); }
+	void note_seek();
+	int get_input_channels() const { return input_channels; }
+	int get_output_channels() const { return 2; }
+	bool is_ambisonic() const { return ambisonic; }
+	bool is_spatial_active() const { return mode == BINAURAL_SURROUND || mode == BINAURAL_AMBISONIC; }
