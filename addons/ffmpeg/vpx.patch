+void VideoDecoder::_seek_audio_only(double p_target_timestamp) {
+	_apply_stream_requests();
+	const double latest = latest_seek_msec.get();
+	if (Math::abs(latest - p_target_timestamp) > 1.0) {
+		return;
+	}
+	p_target_timestamp = latest;
+	if (has_audio && audio_codec_context != nullptr) {
+		avcodec_flush_buffers(audio_codec_context);
+	}
+	tempo_reset = true;
+	const int64_t start_ts = audio_stream != nullptr && audio_stream->start_time != AV_NOPTS_VALUE ? audio_stream->start_time : 0;
+	const int64_t target_ts = audio_stream != nullptr ? (int64_t)(p_target_timestamp / audio_time_base_in_seconds / 1000.0) + start_ts : 0;
+	playback_clock_msec.set(p_target_timestamp);
+	last_decoded_frame_time.set(p_target_timestamp);
+	audio_clock_msec = p_target_timestamp;
+	skip_output_until_time = -1.0;
+	int seek_result = -1;
+	if (sacd_file != nullptr && format_context->pb != nullptr && audio_stream != nullptr) {
+		const int channels = audio_stream->codecpar->ch_layout.nb_channels;
+		const int block_align = audio_stream->codecpar->block_align;
+		if (channels > 0 && block_align >= channels) {
+			const int64_t samples_per_packet = block_align / channels;
+			const int64_t relative_ts = MAX((int64_t)0, target_ts - start_ts);
+			const int64_t packet_index = relative_ts / samples_per_packet;
+			const int64_t byte_offset = 92 + packet_index * block_align;
+			if (avio_seek(format_context->pb, byte_offset, SEEK_SET) >= 0) {
+				avformat_flush(format_context);
+				seek_result = 0;
+			}
+		}
+	}
+	if (seek_result < 0 && audio_stream != nullptr) {
+		seek_result = av_seek_frame(format_context, audio_stream->index, target_ts, AVSEEK_FLAG_BACKWARD);
+	}
+	if (seek_result < 0) {
+		const int64_t clock_ts = (int64_t)(p_target_timestamp / 1000.0 * AV_TIME_BASE);
+		seek_result = av_seek_frame(format_context, -1, clock_ts, AVSEEK_FLAG_BACKWARD);
+	}
+	if (seek_result < 0) {
+		print_line(vformat("Audio seek failed: %s", ffmpeg_get_error_message(seek_result)));
+	}
+	audio_eof = false;
+	video_eof = true;
+	decoder_state = DecoderState::READY;
+	skip_current_outputs.clear();
+	_queue_poster(p_target_timestamp);
+}
