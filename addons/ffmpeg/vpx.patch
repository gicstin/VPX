+class PanoramaPinnedPool {
+	std::shared_ptr<VpxVulkanDevice> vk;
+	std::mutex mutex;
+	std::vector<VpxPinnedBuffer *> free_buffers;
+	int64_t free_bytes = 0;
+	uint32_t memory_type = UINT32_MAX;
+	bool coherent = true;
+
+	VpxPinnedBuffer *_allocate(VkDeviceSize p_size) {
+		VpxPinnedBuffer *buffer = new VpxPinnedBuffer();
+		buffer->vk = vk;
+		buffer->size = p_size;
+		buffer->coherent = coherent;
+		VkBufferCreateInfo buffer_info = {};
+		buffer_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+		buffer_info.size = p_size;
+		buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+		buffer_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+		if (vk->vkCreateBuffer(vk->device, &buffer_info, nullptr, &buffer->buffer) != VK_SUCCESS) {
+			buffer->buffer = VK_NULL_HANDLE;
+			delete buffer;
+			return nullptr;
+		}
+		VkMemoryRequirements requirements = {};
+		vk->vkGetBufferMemoryRequirements(vk->device, buffer->buffer, &requirements);
+		if (memory_type == UINT32_MAX || !(requirements.memoryTypeBits & (1u << memory_type))) {
+			delete buffer;
+			return nullptr;
+		}
+		VkMemoryAllocateInfo alloc_info = {};
+		alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+		alloc_info.allocationSize = requirements.size;
+		alloc_info.memoryTypeIndex = memory_type;
+		void *mapped = nullptr;
+		if (vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &buffer->memory) != VK_SUCCESS) {
+			buffer->memory = VK_NULL_HANDLE;
+			delete buffer;
+			return nullptr;
+		}
+		if (vk->vkBindBufferMemory(vk->device, buffer->buffer, buffer->memory, 0) != VK_SUCCESS || vk->vkMapMemory(vk->device, buffer->memory, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS) {
+			delete buffer;
+			return nullptr;
+		}
+		buffer->mapped = (uint8_t *)mapped;
+		return buffer;
+	}
+
+	static void _dispose(std::vector<VpxPinnedBuffer *> p_buffers) {
+		if (p_buffers.empty()) {
+			return;
+		}
+		std::thread([p_buffers]() {
+			for (VpxPinnedBuffer *buffer : p_buffers) {
+				delete buffer;
+			}
+		}).detach();
+	}
+
+public:
+	static const int64_t KEEP_BYTES = 3ll * 1024 * 1024 * 1024;
+
+	explicit PanoramaPinnedPool(const std::shared_ptr<VpxVulkanDevice> &p_vk) :
+			vk(p_vk) {
+		memory_type = vk->host_cached_memory_type;
+		VkPhysicalDeviceMemoryProperties properties = {};
+		vk->vkGetPhysicalDeviceMemoryProperties(vk->physical_device, &properties);
+		if (memory_type != UINT32_MAX) {
+			coherent = properties.memoryTypes[memory_type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+		}
+	}
+
+	~PanoramaPinnedPool() {
+		for (VpxPinnedBuffer *buffer : free_buffers) {
+			delete buffer;
+		}
+	}
+
+	bool matches(const std::shared_ptr<VpxVulkanDevice> &p_vk) const {
+		return vk == p_vk;
+	}
+
+	VpxPinnedBuffer *acquire(VkDeviceSize p_size) {
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			int best = -1;
+			for (int i = 0; i < (int)free_buffers.size(); i++) {
+				const VkDeviceSize size = free_buffers[i]->size;
+				if (size >= p_size && size <= p_size + p_size / 2 && (best < 0 || size < free_buffers[best]->size)) {
+					best = i;
+				}
+			}
+			if (best >= 0) {
+				VpxPinnedBuffer *buffer = free_buffers[best];
+				free_buffers.erase(free_buffers.begin() + best);
+				free_bytes -= (int64_t)buffer->size;
+				return buffer;
+			}
+		}
+		return _allocate(p_size);
+	}
+
+	void release(VpxPinnedBuffer *p_buffer) {
+		std::vector<VpxPinnedBuffer *> evicted;
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			free_buffers.push_back(p_buffer);
+			free_bytes += (int64_t)p_buffer->size;
+			while (free_bytes > KEEP_BYTES && !free_buffers.empty()) {
+				evicted.push_back(free_buffers.front());
+				free_bytes -= (int64_t)free_buffers.front()->size;
+				free_buffers.erase(free_buffers.begin());
+			}
+		}
+		_dispose(evicted);
+	}
+};
+
+static PanoramaPinnedPool *panorama_pool = nullptr;
