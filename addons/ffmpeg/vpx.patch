diff --git a/vpx_gpu_upload.cpp b/vpx_gpu_upload.cpp
new file mode 100644
index 0000000..b971e05
--- /dev/null
+++ b/vpx_gpu_upload.cpp
@@ -0,0 +1,278 @@
+#ifdef GDEXTENSION
+
+#include "vpx_gpu_upload.h"
+#include "gdextension_build/gdex_print.h"
+
+#include <godot_cpp/classes/engine.hpp>
+
+#include <mutex>
+#include <vector>
+
+VpxGpuUpload::VpxGpuUpload(const std::shared_ptr<VpxVulkanDevice> &p_vk, RenderingDevice *p_rd) :
+		vk(p_vk), rd(p_rd) {
+	if (!vk || rd == nullptr) {
+		failed = true;
+		return;
+	}
+	VkCommandPoolCreateInfo pool_info = {};
+	pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+	pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+	pool_info.queueFamilyIndex = vk->copy_queue_family;
+	if (vk->vkCreateCommandPool(vk->device, &pool_info, nullptr, &command_pool) != VK_SUCCESS) {
+		print_line("GPU upload disabled: command pool creation failed");
+		failed = true;
+		return;
+	}
+	VkCommandBufferAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+	alloc_info.commandPool = command_pool;
+	alloc_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+	alloc_info.commandBufferCount = SET_COUNT;
+	if (vk->vkAllocateCommandBuffers(vk->device, &alloc_info, command_buffers) != VK_SUCCESS) {
+		print_line("GPU upload disabled: command buffer allocation failed");
+		failed = true;
+		return;
+	}
+	for (int set = 0; set < SET_COUNT; set++) {
+		VkFenceCreateInfo fence_info = {};
+		fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+		if (vk->vkCreateFence(vk->device, &fence_info, nullptr, &fences[set]) != VK_SUCCESS) {
+			print_line("GPU upload disabled: fence creation failed");
+			failed = true;
+			return;
+		}
+	}
+}
+
+VpxGpuUpload::~VpxGpuUpload() {
+	if (!vk) {
+		return;
+	}
+	for (int set = 0; set < SET_COUNT; set++) {
+		wait(set);
+		for (int plane = 0; plane < PLANE_COUNT; plane++) {
+			_free_plane(planes[set][plane]);
+		}
+		if (fences[set] != VK_NULL_HANDLE) {
+			vk->vkDestroyFence(vk->device, fences[set], nullptr);
+		}
+	}
+	if (command_pool != VK_NULL_HANDLE) {
+		vk->vkDestroyCommandPool(vk->device, command_pool, nullptr);
+	}
+	vpx_purge_retired_images(false);
+}
+
+void VpxGpuUpload::_free_plane(ExternalPlane &p_plane) {
+	if (p_plane.rid.is_valid()) {
+		rd->free_rid(p_plane.rid);
+		p_plane.rid = RID();
+	}
+	if (p_plane.image != VK_NULL_HANDLE) {
+		vpx_retire_image(vk, p_plane.image, p_plane.memory);
+		p_plane.image = VK_NULL_HANDLE;
+		p_plane.memory = VK_NULL_HANDLE;
+	}
+	p_plane.size = Vector2i();
+	p_plane.format = VK_FORMAT_UNDEFINED;
+	p_plane.written = false;
+	p_plane.primed = false;
+}
+
+bool VpxGpuUpload::_ensure_plane(ExternalPlane &p_plane, const Vector2i &p_size, VkFormat p_format, RenderingDevice::DataFormat p_rd_format) {
+	if (p_plane.image != VK_NULL_HANDLE && p_plane.size == p_size && p_plane.format == p_format) {
+		return true;
+	}
+	_free_plane(p_plane);
+	vpx_purge_retired_images(false);
+
+	VkImageCreateInfo image_info = {};
+	image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	image_info.imageType = VK_IMAGE_TYPE_2D;
+	image_info.format = p_format;
+	image_info.extent = { (uint32_t)p_size.x, (uint32_t)p_size.y, 1 };
+	image_info.mipLevels = 1;
+	image_info.arrayLayers = 1;
+	image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+	image_info.tiling = vk->linear_format_supported(p_format) ? VK_IMAGE_TILING_LINEAR : VK_IMAGE_TILING_OPTIMAL;
+	image_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+	const uint32_t families[2] = { vk->queue_family, vk->copy_queue_family };
+	if (vk->copy_queue_family != vk->queue_family) {
+		image_info.sharingMode = VK_SHARING_MODE_CONCURRENT;
+		image_info.queueFamilyIndexCount = 2;
+		image_info.pQueueFamilyIndices = families;
+	} else {
+		image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	}
+	image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	if (vk->vkCreateImage(vk->device, &image_info, nullptr, &p_plane.image) != VK_SUCCESS) {
+		p_plane.image = VK_NULL_HANDLE;
+		print_line("GPU upload: image creation failed");
+		return false;
+	}
+	VkMemoryRequirements requirements = {};
+	vk->vkGetImageMemoryRequirements(vk->device, p_plane.image, &requirements);
+	const uint32_t memory_type = vk->find_memory_type(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0);
+	if (memory_type == UINT32_MAX) {
+		_free_plane(p_plane);
+		return false;
+	}
+	VkMemoryAllocateInfo alloc_info = {};
+	alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+	alloc_info.allocationSize = requirements.size;
+	alloc_info.memoryTypeIndex = memory_type;
+	if (vk->vkAllocateMemory(vk->device, &alloc_info, nullptr, &p_plane.memory) != VK_SUCCESS) {
+		p_plane.memory = VK_NULL_HANDLE;
+		_free_plane(p_plane);
+		print_line("GPU upload: image memory allocation failed");
+		return false;
+	}
+	if (vk->vkBindImageMemory(vk->device, p_plane.image, p_plane.memory, 0) != VK_SUCCESS) {
+		_free_plane(p_plane);
+		return false;
+	}
+	const uint64_t usage = RenderingDevice::TEXTURE_USAGE_SAMPLING_BIT | RenderingDevice::TEXTURE_USAGE_CAN_COPY_FROM_BIT;
+	p_plane.rid = rd->texture_create_from_extension(RenderingDevice::TEXTURE_TYPE_2D, p_rd_format, RenderingDevice::TEXTURE_SAMPLES_1, usage, (uint64_t)p_plane.image, p_size.x, p_size.y, 1, 1);
+	if (!p_plane.rid.is_valid()) {
+		_free_plane(p_plane);
+		print_line("GPU upload: texture_create_from_extension failed");
+		return false;
+	}
+	p_plane.size = p_size;
+	p_plane.format = p_format;
+	p_plane.written = false;
+	return true;
+}
+
+bool VpxGpuUpload::ensure_planes(int p_set, const Vector2i p_sizes[PLANE_COUNT], const VkFormat p_formats[PLANE_COUNT], const RenderingDevice::DataFormat p_rd_formats[PLANE_COUNT], const bool p_used[PLANE_COUNT]) {
+	if (!is_valid()) {
+		return false;
+	}
+	wait(p_set);
+	for (int plane = 0; plane < PLANE_COUNT; plane++) {
+		if (!p_used[plane]) {
+			continue;
+		}
+		if (!_ensure_plane(planes[p_set][plane], p_sizes[plane], p_formats[plane], p_rd_formats[plane])) {
+			failed = true;
+			return false;
+		}
+	}
+	return true;
+}
+
+bool VpxGpuUpload::submit_copy(int p_set, const VpxPlaneCopy p_copies[PLANE_COUNT], const bool p_used[PLANE_COUNT]) {
+	if (!is_valid() || in_flight[p_set]) {
+		return false;
+	}
+	VkCommandBuffer cb = command_buffers[p_set];
+	if (vk->vkResetCommandBuffer(cb, 0) != VK_SUCCESS) {
+		return false;
+	}
+	VkCommandBufferBeginInfo begin_info = {};
+	begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+	begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+	if (vk->vkBeginCommandBuffer(cb, &begin_info) != VK_SUCCESS) {
+		return false;
+	}
+
+	VkImageMemoryBarrier to_dst[PLANE_COUNT];
+	VkImageMemoryBarrier to_src[PLANE_COUNT];
+	int barrier_count = 0;
+	for (int plane = 0; plane < PLANE_COUNT; plane++) {
+		ExternalPlane &ext = planes[p_set][plane];
+		if (!p_used[plane] || ext.image == VK_NULL_HANDLE) {
+			continue;
+		}
+		VkImageMemoryBarrier &a = to_dst[barrier_count];
+		a = {};
+		a.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		a.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		a.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		a.oldLayout = ext.written ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED;
+		a.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		a.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		a.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		a.image = ext.image;
+		a.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+		VkImageMemoryBarrier &b = to_src[barrier_count];
+		b = a;
+		b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+		barrier_count++;
+	}
+	if (barrier_count == 0) {
+		vk->vkEndCommandBuffer(cb);
+		return false;
+	}
+	vk->vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, barrier_count, to_dst);
+	for (int plane = 0; plane < PLANE_COUNT; plane++) {
+		ExternalPlane &ext = planes[p_set][plane];
+		if (!p_used[plane] || ext.image == VK_NULL_HANDLE) {
+			continue;
+		}
+		const VpxPlaneCopy &copy = p_copies[plane];
+		VkBufferImageCopy region = {};
+		region.bufferOffset = copy.offset;
+		region.bufferRowLength = copy.row_length_texels;
+		region.bufferImageHeight = 0;
+		region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.imageOffset = { 0, 0, 0 };
+		region.imageExtent = { (uint32_t)ext.size.x, (uint32_t)MIN((int)copy.rows, ext.size.y), 1 };
+		vk->vkCmdCopyBufferToImage(cb, copy.buffer, ext.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		ext.written = true;
+	}
+	vk->vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, barrier_count, to_src);
+	if (vk->vkEndCommandBuffer(cb) != VK_SUCCESS) {
+		return false;
+	}
+	if (vk->vkResetFences(vk->device, 1, &fences[p_set]) != VK_SUCCESS) {
+		return false;
+	}
+	VkSubmitInfo submit = {};
+	submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+	submit.commandBufferCount = 1;
+	submit.pCommandBuffers = &cb;
+	if (vk->vkQueueSubmit(vk->copy_queue, 1, &submit, fences[p_set]) != VK_SUCCESS) {
+		print_line("GPU upload: queue submit failed, falling back to staged uploads");
+		failed = true;
+		return false;
+	}
+	in_flight[p_set] = true;
+	return true;
+}
+
+int VpxGpuUpload::acquire_slot(uint64_t p_frame) const {
+	for (int set = 0; set < SET_COUNT; set++) {
+		if (in_flight[set]) {
+			continue;
+		}
+		if (!published[set] || p_frame >= published_frame[set] + REUSE_FRAMES) {
+			return set;
+		}
+	}
+	return -1;
+}
+
+bool VpxGpuUpload::poll(int p_set) {
+	if (!in_flight[p_set]) {
+		return true;
+	}
+	if (vk->vkGetFenceStatus(vk->device, fences[p_set]) == VK_SUCCESS) {
+		in_flight[p_set] = false;
+		return true;
+	}
+	return false;
+}
+
+void VpxGpuUpload::wait(int p_set) {
+	if (!in_flight[p_set]) {
+		return;
+	}
+	vk->vkWaitForFences(vk->device, 1, &fences[p_set], VK_TRUE, 2000000000ull);
+	in_flight[p_set] = false;
+}
+
+#endif // GDEXTENSION
