@@ -0,0 +1,26 @@
+#include "vpx_dynlib.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+void *vpx_dynlib_open_vulkan() {
+	return (void *)LoadLibraryA("vulkan-1.dll");
+}
+
+void *vpx_dynlib_symbol(void *p_library, const char *p_name) {
+	return (void *)GetProcAddress((HMODULE)p_library, p_name);
+}
+#else
+#include <dlfcn.h>
+
+void *vpx_dynlib_open_vulkan() {
+	void *library = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+	return library != nullptr ? library : dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+}
+
+void *vpx_dynlib_symbol(void *p_library, const char *p_name) {
+	return dlsym(p_library, p_name);
+}
+#endif
