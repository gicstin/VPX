+static int _collect_sacd_entry(const sacd_vfs_entry_t *p_entry, void *p_userdata) {
+	if (p_entry->type != SACD_VFS_ENTRY_FILE) {
+		return 0;
+	}
+	Array *tracks = static_cast<Array *>(p_userdata);
+	tracks->push_back(String::utf8(p_entry->name));
+	return 0;
+}
 
