+Dictionary FFmpegVideoStream::get_sacd_info(const String &p_path) {
+	Dictionary result;
+	CharString iso_path = p_path.utf8();
+	sacd_vfs_ctx_t *ctx = sacd_vfs_create();
+	if (ctx == nullptr || sacd_vfs_open(ctx, iso_path.get_data()) != SACD_VFS_OK) {
+		if (ctx != nullptr) {
+			sacd_vfs_destroy(ctx);
+		}
+		result["ok"] = false;
+		result["error"] = "Could not read SACD ISO";
+		return result;
+	}
+	char album_name[512] = {};
+	sacd_vfs_get_album_name(ctx, album_name, sizeof(album_name));
+	String album = String::utf8(album_name);
+	Array stereo;
+	Array multichannel;
+	if (sacd_vfs_has_area(ctx, SACD_VFS_AREA_STEREO)) {
+		CharString dir = ("/" + album + "/Stereo").utf8();
+		sacd_vfs_readdir(ctx, dir.get_data(), _collect_sacd_entry, &stereo);
+	}
+	if (sacd_vfs_has_area(ctx, SACD_VFS_AREA_MULTICHANNEL)) {
+		CharString dir = ("/" + album + "/Multi-channel").utf8();
+		sacd_vfs_readdir(ctx, dir.get_data(), _collect_sacd_entry, &multichannel);
+	}
+	result["stereo"] = stereo;
+	result["multichannel"] = multichannel;
+	result["album"] = album;
+	result["ok"] = !stereo.is_empty() || !multichannel.is_empty();
+	if (stereo.is_empty() && multichannel.is_empty()) {
+		result["error"] = "No readable SACD tracks found";
+	}
+	sacd_vfs_close(ctx);
+	sacd_vfs_destroy(ctx);
+	return result;
+}
