+void VpxSpatialAudio::_bass_translate(float *p_out, int p_frames) {
+	const float target_amount = active.bass_translate;
+	const float from_amount = applied_translate;
+	applied_translate = target_amount;
+	const float attack = 1.0f - std::exp(-1.0f / (0.005f * (float)sample_rate));
+	const float release = 1.0f - std::exp(-1.0f / (0.05f * (float)sample_rate));
+	const float inverse_frames = 1.0f / (float)p_frames;
+	for (int i = 0; i < p_frames; i++) {
+		const float mid = (p_out[i * 2] + p_out[i * 2 + 1]) * 0.5f;
+		const float low = bass_low[0][1].run(bass_low[0][0].run(mid));
+		const float magnitude = std::fabs(low);
+		bass_envelope += (magnitude > bass_envelope ? attack : release) * (magnitude - bass_envelope);
+		if (bass_envelope < 1e-30f) {
+			bass_envelope = 0.0f;
+		}
+		float harmonics = 0.0f;
+		if (bass_envelope > 1e-4f) {
+			harmonics = bass_envelope * std::tanh(3.0f * low / bass_envelope);
+		}
+		harmonics = bass_band_low[1].run(bass_band_low[0].run(bass_band_high[1].run(bass_band_high[0].run(harmonics))));
+		const float amount = from_amount + (target_amount - from_amount) * (float)(i + 1) * inverse_frames;
+		const float add = harmonics * amount * BASS_TRANSLATE_GAIN;
+		for (int channel = 0; channel < 2; channel++) {
+			float v = p_out[i * 2 + channel] + add;
+			const float magnitude_out = std::fabs(v);
+			if (magnitude_out > 0.98f) {
+				const float soft = 0.98f + 0.02f * std::tanh((magnitude_out - 0.98f) / 0.02f);
+				v = v < 0.0f ? -soft : soft;
+			}
+			p_out[i * 2 + channel] = v;
+		}
+	}
+}
