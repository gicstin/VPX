+void VpxSpatialAudio::_process_stereo_speakers(const float *p_in, int p_frames, float *p_out) {
+	const Basis to_listener = active.stereo_tracked ? listener : Basis();
+	const Basis from_listener = active.stereo_tracked && listener_primed ? applied_listener : to_listener;
+	applied_listener = to_listener;
+	listener_primed = true;
+	const Basis from_inverse = from_listener.transposed();
+	const Basis to_inverse = to_listener.transposed();
+	const float angle_to = active.stereo_angle;
+	const float angle_from = stereo_primed ? stereo_applied_angle : angle_to;
+	stereo_applied_angle = angle_to;
+	stereo_primed = true;
+	struct Plan {
+		EarParams from[2];
+		EarParams to[2];
+		float back_from = 0.0f;
+		float back_to = 0.0f;
+	};
+	Plan plans[2];
+	for (int s = 0; s < 2; s++) {
+		const float sign = s == 0 ? 1.0f : -1.0f;
+		const Vector3 head_to = to_inverse.xform(_direction(sign * angle_to, 0.0f)).normalized();
+		const Vector3 head_from = from_inverse.xform(_direction(sign * angle_from, 0.0f)).normalized();
+		const float radius_to = head_radius;
+		head_radius = head_radius_from;
+		for (int ear = 0; ear < 2; ear++) {
+			plans[s].from[ear] = _ear_params(head_from, ear, true);
+		}
+		head_radius = radius_to;
+		for (int ear = 0; ear < 2; ear++) {
+			plans[s].to[ear] = _ear_params(head_to, ear, true);
+		}
+		plans[s].back_from = CLAMP((float)head_from.z, 0.0f, 1.0f);
+		plans[s].back_to = CLAMP((float)head_to.z, 0.0f, 1.0f);
+	}
+	const float amount_to = CLAMP(active.stereo_amount, 0.0f, 1.0f);
+	const float comp_position = CLAMP((angle_to - 20.0f) / 5.0f, 0.0f, 8.0f);
+	const int comp_index = std::min((int)comp_position, 7);
+	const float comp_db = STEREO_COMP_DB[comp_index] + (STEREO_COMP_DB[comp_index + 1] - STEREO_COMP_DB[comp_index]) * (comp_position - (float)comp_index);
+	const float scale_to = STEREO_SPEAKER_SCALE * std::pow(10.0f, comp_db / 20.0f);
+	const float amount_from = stereo_primed_gain ? applied_amount : amount_to;
+	const float scale_from = stereo_primed_gain ? applied_scale : scale_to;
+	applied_amount = amount_to;
+	applied_scale = scale_to;
+	stereo_primed_gain = true;
+	const float inverse_frames = 1.0f / (float)p_frames;
+	for (int i = 0; i < p_frames; i++) {
+		float input[2];
+		_stereo_condition(p_in, i, input[0], input[1]);
+		const float t = (float)(i + 1) * inverse_frames;
+		float wet_left = 0.0f;
+		float wet_right = 0.0f;
+		float aligned[2] = { 0.0f, 0.0f };
+		for (int s = 0; s < 2; s++) {
+			float ear_right = 0.0f;
+			float delayed[2] = { 0.0f, 0.0f };
+			wet_left += _render_source(sources[s], input[s], plans[s].from, plans[s].to, plans[s].back_from, plans[s].back_to, t, ear_right, delayed);
+			wet_right += ear_right;
+			aligned[s] = delayed[s];
+		}
+		const float amount = amount_from + (amount_to - amount_from) * t;
+		const float wet_scale = scale_from + (scale_to - scale_from) * t;
+		wet_left = body_eq[0].run(wet_left) * wet_scale;
+		wet_right = body_eq[1].run(wet_right) * wet_scale;
+		p_out[i * 2] = _stereo_finish(0, aligned[0] * (1.0f - amount) + wet_left * amount, t);
+		p_out[i * 2 + 1] = _stereo_finish(1, aligned[1] * (1.0f - amount) + wet_right * amount, t);
+	}
+	_apply_room(p_out, p_frames);
+	_stereo_limit(p_out, p_frames);
+	_stereo_settle();
+}
