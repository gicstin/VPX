+void VpxSpatialAudio::_process_stereo_crossfeed(const float *p_in, int p_frames, float *p_out) {
+	const float feed = std::pow(10.0f, active.crossfeed_db / 20.0f);
+	const float side_cut_to = 2.0f * feed / (1.0f + feed);
+	const float coefficient_to = 1.0f - std::exp(-2.0f * PI_F * active.crossfeed_hz / (float)sample_rate);
+	const float cut_from = stereo_primed_gain ? applied_cut : side_cut_to;
+	const float coefficient_from = stereo_primed_gain ? applied_coefficient : coefficient_to;
+	applied_cut = side_cut_to;
+	applied_coefficient = coefficient_to;
+	stereo_primed_gain = true;
+	const float inverse_frames = 1.0f / (float)p_frames;
+	const int delay = CLAMP((int)std::lround(CROSSFEED_DELAY * (float)sample_rate), 1, CROSSFEED_RING - 1);
+	for (int i = 0; i < p_frames; i++) {
+		float left;
+		float right;
+		_stereo_condition(p_in, i, left, right);
+		const float mid = (left + right) * 0.5f;
+		const float side = (left - right) * 0.5f;
+		cross_ring[cross_pos] = side;
+		const float t = (float)(i + 1) * inverse_frames;
+		const float side_cut = cut_from + (side_cut_to - cut_from) * t;
+		const float coefficient = coefficient_from + (coefficient_to - coefficient_from) * t;
+		cross_state += coefficient * (cross_ring[(cross_pos - delay + CROSSFEED_RING) % CROSSFEED_RING] - cross_state);
+		if (std::fabs(cross_state) < 1e-30f) {
+			cross_state = 0.0f;
+		}
+		cross_pos = (cross_pos + 1) % CROSSFEED_RING;
+		const float softened = side - side_cut * cross_state;
+		p_out[i * 2] = _stereo_finish(0, mid + softened, t);
+		p_out[i * 2 + 1] = _stereo_finish(1, mid - softened, t);
+	}
+	_apply_room(p_out, p_frames);
+	_stereo_limit(p_out, p_frames);
+	_stereo_settle();
+}
+
+void VpxSpatialAudio::_room_configure() {
+	room_size = std::max(64, (int)(0.045f * (float)sample_rate) + 8);
+	for (int channel = 0; channel < 2; channel++) {
+		room_ring[channel].assign((size_t)room_size, 0.0f);
+		for (int tap = 0; tap < ROOM_TAPS; tap++) {
+			const float milliseconds = channel == 0 ? ROOM_LEFT_MS[tap] : ROOM_RIGHT_MS[tap];
+			room_delay[channel][tap] = std::min(room_size - 1, std::max(1, (int)std::lround(milliseconds * 0.001f * (float)sample_rate)));
+			room_gain[channel][tap] = 0.5f * std::exp(-milliseconds / 17.0f);
+			const float cutoff = 9000.0f - 1000.0f * (float)tap;
+			room_coefficient[channel][tap] = 1.0f - std::exp(-2.0f * PI_F * cutoff / (float)sample_rate);
+			room_state[channel][tap] = 0.0f;
+		}
+	}
+	room_pos = 0;
+	applied_room = 0.0f;
+	room_bass[0] = room_bass[1] = 0.0f;
+	room_bass_coefficient = 1.0f - std::exp(-2.0f * PI_F * ROOM_HIGHPASS_HZ / (float)sample_rate);
+}
+
+void VpxSpatialAudio::_apply_room(float *p_out, int p_frames) {
+	const float target_room = CLAMP(active.room_amount + DISTANCE_ROOM * active.stereo_distance, 0.0f, 1.5f) * ROOM_LEVEL;
+	const float from_room = applied_room;
+	applied_room = target_room;
+	const bool silent = from_room < 1e-5f && target_room < 1e-5f;
+	const float inverse_frames = 1.0f / (float)p_frames;
+	for (int i = 0; i < p_frames; i++) {
+		room_ring[0][room_pos] = p_out[i * 2];
+		room_ring[1][room_pos] = p_out[i * 2 + 1];
+		if (!silent) {
+			const float amount = from_room + (target_room - from_room) * (float)(i + 1) * inverse_frames;
+			for (int channel = 0; channel < 2; channel++) {
+				float sum = 0.0f;
+				for (int tap = 0; tap < ROOM_TAPS; tap++) {
+					const int source = (tap + channel) % 2 == 0 ? 1 - channel : channel;
+					const float input = room_ring[source][(room_pos - room_delay[channel][tap] + room_size) % room_size];
+					float &state = room_state[channel][tap];
+					state += room_coefficient[channel][tap] * (input - state);
+					if (std::fabs(state) < 1e-30f) {
+						state = 0.0f;
+					}
+					sum += room_gain[channel][tap] * state;
+				}
+				room_bass[channel] += room_bass_coefficient * (sum - room_bass[channel]);
+				if (std::fabs(room_bass[channel]) < 1e-30f) {
+					room_bass[channel] = 0.0f;
+				}
+				p_out[i * 2 + channel] = (p_out[i * 2 + channel] + amount * (sum - room_bass[channel])) / (1.0f + ROOM_COMPENSATION * amount);
+			}
+		}
+		room_pos = (room_pos + 1) % room_size;
+	}
+}
