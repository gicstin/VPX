+void VideoDecoder::_collect_audio_metadata() {
+	if (!audio_only || format_context == nullptr || audio_stream == nullptr) {
+		return;
+	}
+	Dictionary tags;
+	for (AVDictionary *source : {format_context->metadata, audio_stream->metadata}) {
+		const AVDictionaryEntry *entry = nullptr;
+		while ((entry = av_dict_get(source, "", entry, AV_DICT_IGNORE_SUFFIX)) != nullptr) {
+			if (strlen(entry->value) <= 16384) {
+				tags[String::utf8(entry->key).to_lower()] = String::utf8(entry->value);
+			}
+		}
+	}
+	PackedByteArray artwork;
+	for (unsigned int i = 0; i < format_context->nb_streams; i++) {
+		const AVStream *track = format_context->streams[i];
+		if ((track->disposition & AV_DISPOSITION_ATTACHED_PIC) && track->attached_pic.data != nullptr && track->attached_pic.size > 0 && track->attached_pic.size <= 8 * 1024 * 1024) {
+			artwork.resize(track->attached_pic.size);
+			memcpy(artwork.ptrw(), track->attached_pic.data, track->attached_pic.size);
+			break;
+		}
+	}
+	metadata_mutex->lock();
+	stream_metadata["radio_tags"] = tags;
+	stream_metadata["artwork_data"] = artwork;
+	metadata_mutex->unlock();
+	format_context->event_flags &= ~AVFMT_EVENT_FLAG_METADATA_UPDATED;
+	audio_stream->event_flags &= ~AVSTREAM_EVENT_FLAG_METADATA_UPDATED;
 }
 
