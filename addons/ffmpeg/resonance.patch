+class VpxResonance {
+public:
+	static constexpr int BANDS = 48;
+	static constexpr int AZIMUTHS = 16;
+	static constexpr int ELEVATIONS = 3;
+	static constexpr int CELLS = AZIMUTHS * ELEVATIONS;
+	static constexpr int HOP = 256;
+	static constexpr int SHORT_FFT = 1024;
+	static constexpr int LONG_FFT = 4096;
+	struct Snapshot {
+		double time = 0.0;
+		float rms = 0.0f;
+		float onset = 0.0f;
+		float correlation = 1.0f;
+		float width = 0.0f;
+		float lfe = 0.0f;
+		int channels = 0;
+		bool ambisonic = false;
+		std::array<float, BANDS * (CELLS + 2)> spectrum{};
+		godot::Dictionary dictionary(bool p_stereo) const;
+	};
+	using Frame = std::shared_ptr<const Snapshot>;
+
+private:
+	struct Source {
+		int channel = -1;
+		godot::Vector3 direction;
+		bool lfe = false;
+		std::array<float, LONG_FFT> ring{};
+		std::array<float, BANDS> bands{};
+		std::array<float, BANDS> real{};
+		std::array<float, BANDS> imaginary{};
+		std::array<float, CELLS> weights{};
+	};
+	std::vector<Source> sources;
+	AVChannelLayout layout{};
+	AVTXContext *short_context = nullptr;
+	AVTXContext *long_context = nullptr;
+	av_tx_fn short_transform = nullptr;
+	av_tx_fn long_transform = nullptr;
+	std::array<float, LONG_FFT> input{};
+	std::array<AVComplexFloat, LONG_FFT / 2 + 1> output{};
+	std::array<float, SHORT_FFT> short_window{};
+	std::array<float, LONG_FFT> long_window{};
+	std::array<int, BANDS + 1> short_bins{};
+	std::array<int, BANDS + 1> long_bins{};
+	int rate = 0;
+	int channels = 0;
+	int position = 0;
+	uint64_t samples = 0;
+	int hop = 0;
+	int w = -1;
+	int x = -1;
+	int y = -1;
+	int z = -1;
+	double expected_time = -1.0;
+	double energy = 0.0;
+	double left_energy = 0.0;
+	double right_energy = 0.0;
+	double cross_energy = 0.0;
+	double lfe_energy = 0.0;
+	float envelope = 0.0f;
+	float onset = 0.0f;
+	std::shared_ptr<Snapshot> spectral;
+	void configure(const AVChannelLayout &p_layout, int p_rate);
+	void analyse(Source &p_source, bool p_long);
