+#include "vpx_resonance.h"
+
+#ifdef GDEXTENSION
+#include "vpx_spatial_audio.h"
+#include <godot_cpp/variant/packed_float32_array.hpp>
+#include <godot_cpp/variant/variant.hpp>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+using namespace godot;
+
+Dictionary VpxResonance::Snapshot::dictionary(bool p_stereo) const {
+	PackedFloat32Array data;
+	data.resize(spectrum.size());
+	float *values = data.ptrw();
+	for (size_t i = 0; i < spectrum.size(); i++) values[i] = std::clamp((20.0f * std::log10(std::max(spectrum[i], 0.000001f)) + 60.0f) / 60.0f, 0.0f, 1.0f);
+	if (p_stereo && channels > 2) {
+		for (int b = 0; b < BANDS; b++) {
+			const float left = spectrum[b];
+			const float right = spectrum[BANDS + b];
+			const float pan = (right * right - left * left) / std::max(1e-12f, left * left + right * right);
+			const Vector3 direction(pan, 0.0f, -std::sqrt(std::max(0.0f, 1.0f - pan * pan)));
+			for (int cell = 0; cell < CELLS; cell++) {
+				const float az = (cell % AZIMUTHS) * 6.28318530718f / AZIMUTHS;
+				const float el = (cell / AZIMUTHS - 1) * 0.78539816339f;
+				const Vector3 axis(std::sin(az) * std::cos(el), std::sin(el), -std::cos(az) * std::cos(el));
+				const float dot = std::max(0.0f, (float)axis.dot(direction));
+				const float square = dot * dot;
+				const float magnitude = std::max(left, right) * square * square * square * square * square;
+				values[(cell + 2) * BANDS + b] = std::clamp((20.0f * std::log10(std::max(magnitude, 0.000001f)) + 60.0f) / 60.0f, 0.0f, 1.0f);
+			}
+		}
+	}
+	Dictionary result;
+	result["time"] = time / 1000.0;
+	result["rms"] = rms;
+	result["onset"] = onset;
+	result["correlation"] = correlation;
+	result["width"] = width;
+	result["lfe"] = lfe;
+	result["channels"] = channels;
+	result["ambisonic"] = ambisonic;
+	result["spectrum"] = data;
+	return result;
+}
+
+VpxResonance::VpxResonance() {
+	const float scale = 1.0f;
+	av_tx_init(&short_context, &short_transform, AV_TX_FLOAT_RDFT, 0, SHORT_FFT, &scale, AV_TX_UNALIGNED);
+	av_tx_init(&long_context, &long_transform, AV_TX_FLOAT_RDFT, 0, LONG_FFT, &scale, AV_TX_UNALIGNED);
+	for (int i = 0; i < SHORT_FFT; i++) {
+		short_window[i] = 0.5f - 0.5f * std::cos(6.28318530718f * i / (SHORT_FFT - 1));
+	}
+	for (int i = 0; i < LONG_FFT; i++) {
+		long_window[i] = 0.5f - 0.5f * std::cos(6.28318530718f * i / (LONG_FFT - 1));
+	}
+}
+
+VpxResonance::~VpxResonance() {
+	av_tx_uninit(&short_context);
+	av_tx_uninit(&long_context);
+	av_channel_layout_uninit(&layout);
+}
+
+void VpxResonance::reset() {
+	position = samples = hop = 0;
+	energy = left_energy = right_energy = cross_energy = lfe_energy = 0.0;
+	envelope = onset = 0.0f;
+	expected_time = -1.0;
+	spectral.reset();
+	for (Source &source : sources) {
+		source.ring.fill(0.0f);
+		source.bands.fill(0.0f);
+		source.real.fill(0.0f);
+		source.imaginary.fill(0.0f);
+	}
+}
+
+void VpxResonance::configure(const AVChannelLayout &p_layout, int p_rate) {
+	av_channel_layout_uninit(&layout);
+	av_channel_layout_copy(&layout, &p_layout);
+	rate = p_rate;
+	channels = p_layout.nb_channels;
+	sources.clear();
+	w = x = y = z = -1;
+	for (int i = 0; i < channels; i++) {
+		const AVChannel channel = av_channel_layout_channel_from_index(&layout, i);
+		if (channel == AV_CHAN_AMBISONIC_BASE) w = i;
+		if (channel == AV_CHAN_AMBISONIC_BASE + 1) y = i;
+		if (channel == AV_CHAN_AMBISONIC_BASE + 2) z = i;
+		if (channel == AV_CHAN_AMBISONIC_BASE + 3) x = i;
+	}
+	const bool ambisonic = w >= 0 && x >= 0 && y >= 0 && z >= 0;
+	if (ambisonic) {
+		for (int i = 0; i < 8; i++) {
+			Source source;
+			source.direction = Vector3((i & 1) ? 1 : -1, (i & 2) ? 1 : -1, (i & 4) ? 1 : -1).normalized();
+			sources.push_back(source);
+		}
+	}
+	for (int i = 0; i < channels && sources.size() < 32; i++) {
+		const AVChannel channel = av_channel_layout_channel_from_index(&layout, i);
+		if (ambisonic && channel >= AV_CHAN_AMBISONIC_BASE && channel <= AV_CHAN_AMBISONIC_END) continue;
+		Source source;
+		source.channel = i;
+		float azimuth = 0.0f;
+		float elevation = 0.0f;
+		VpxSpatialAudio::analysis_channel_direction(channel, azimuth, elevation, source.lfe);
+		if (!ambisonic && channels == 2) azimuth = i == 0 ? 65.0f : -65.0f;
+		const float az = azimuth * 0.01745329252f;
+		const float el = elevation * 0.01745329252f;
+		source.direction = Vector3(-std::sin(az) * std::cos(el), std::sin(el), -std::cos(az) * std::cos(el));
+		sources.push_back(source);
+	}
+	for (Source &source : sources) {
+		for (int cell = 0; cell < CELLS; cell++) {
+			const float az = (cell % AZIMUTHS) * 6.28318530718f / AZIMUTHS;
+			const float el = (cell / AZIMUTHS - 1) * 0.78539816339f;
+			const Vector3 axis(std::sin(az) * std::cos(el), std::sin(el), -std::cos(az) * std::cos(el));
+			source.weights[cell] = source.lfe ? 0.0f : std::pow(std::max(0.0f, (float)axis.dot(source.direction)), 10.0f);
+		}
+	}
+	for (int b = 0; b <= BANDS; b++) {
+		const float frequency = 30.0f * std::pow(600.0f, (float)b / BANDS);
+		short_bins[b] = std::clamp((int)std::round(frequency * SHORT_FFT / rate), 1, SHORT_FFT / 2);
+		long_bins[b] = std::clamp((int)std::round(frequency * LONG_FFT / rate), 1, LONG_FFT / 2);
+	}
+	reset();
+}
+
+void VpxResonance::analyse(Source &p_source, bool p_long) {
+	const int size = p_long ? LONG_FFT : SHORT_FFT;
+	AVTXContext *context = p_long ? long_context : short_context;
+	av_tx_fn transform = p_long ? long_transform : short_transform;
+	if (!context || !transform) return;
+	for (int i = 0; i < size; i++) {
+		input[i] = p_source.ring[(position - size + i + LONG_FFT) % LONG_FFT] * (p_long ? long_window[i] : short_window[i]);
+	}
+	transform(context, output.data(), input.data(), sizeof(float));
+	const auto &bins = p_long ? long_bins : short_bins;
+	const float scale = 4.0f / size;
+	for (int b = 0; b < BANDS; b++) {
+		const bool low = 30.0f * std::pow(600.0f, (float)(b + 1) / BANDS) < 220.0f;
+		if (low != p_long && (samples >= LONG_FFT || p_long)) continue;
+		float power = 0.0f;
+		float real = 0.0f;
+		float imaginary = 0.0f;
+		const int end = std::min(size / 2 + 1, std::max(bins[b] + 1, bins[b + 1]));
+		for (int k = bins[b]; k < end; k++) {
+			real += output[k].re;
+			imaginary += output[k].im;
+			power += output[k].re * output[k].re + output[k].im * output[k].im;
+		}
+		p_source.bands[b] = std::sqrt(power) * scale;
+		p_source.real[b] = real;
+		p_source.imaginary[b] = imaginary;
+	}
+}
+
+std::shared_ptr<VpxResonance::Snapshot> VpxResonance::snapshot(double p_time) {
+	if (!spectral || samples % (HOP * 2) == 0) {
+		spectral = std::make_shared<Snapshot>();
+		for (Source &source : sources) {
+			if (samples >= SHORT_FFT) analyse(source, false);
+			if (samples >= LONG_FFT && samples % (HOP * 4) == 0) analyse(source, true);
+			const float left = std::sqrt(std::clamp((1.0f - (float)source.direction.x) * 0.5f, 0.0f, 1.0f));
+			const float right = std::sqrt(std::clamp((1.0f + (float)source.direction.x) * 0.5f, 0.0f, 1.0f));
+			for (int b = 0; b < BANDS; b++) {
+				const float magnitude = source.bands[b];
+				if (source.lfe) continue;
+				const bool stereo = channels == 2 && w < 0;
+				spectral->spectrum[b] += magnitude * (stereo ? (source.channel == 0 ? 1.0f : 0.0f) : left);
+				spectral->spectrum[BANDS + b] += magnitude * (stereo ? (source.channel == 1 ? 1.0f : 0.0f) : right);
+				for (int cell = 0; cell < CELLS; cell++) spectral->spectrum[(cell + 2) * BANDS + b] += magnitude * source.weights[cell];
+			}
+		}
+		if (channels == 2 && w < 0 && sources.size() == 2) {
+			for (int b = 0; b < BANDS; b++) {
+				const float left = sources[0].bands[b];
+				const float right = sources[1].bands[b];
+				const float pan = (right * right - left * left) / std::max(1e-12f, right * right + left * left);
+				const Vector3 direction(pan, 0.0f, -std::sqrt(std::max(0.0f, 1.0f - pan * pan)));
+				const float lr = sources[0].real[b] * sources[1].real[b] + sources[0].imaginary[b] * sources[1].imaginary[b];
+				const float norm = std::sqrt((sources[0].real[b] * sources[0].real[b] + sources[0].imaginary[b] * sources[0].imaginary[b]) * (sources[1].real[b] * sources[1].real[b] + sources[1].imaginary[b] * sources[1].imaginary[b]));
+				const float correlation = norm > 1e-12f ? std::clamp(lr / norm, -1.0f, 1.0f) : 1.0f;
+				const float diffuse = (1.0f - correlation) * 0.35f;
+				for (int cell = 0; cell < CELLS; cell++) {
+					const float az = (cell % AZIMUTHS) * 6.28318530718f / AZIMUTHS;
+					const float el = (cell / AZIMUTHS - 1) * 0.78539816339f;
+					const Vector3 axis(std::sin(az) * std::cos(el), std::sin(el), -std::cos(az) * std::cos(el));
+					const float dot = std::max(0.0f, (float)axis.dot(direction));
+					const float square = dot * dot;
+					const float weight = square * square * square * square * square * (1.0f - diffuse) + square * diffuse;
+					spectral->spectrum[(cell + 2) * BANDS + b] = std::max(left, right) * weight;
+				}
+			}
+		}
+	}
+	auto result = std::make_shared<Snapshot>(*spectral);
+	result->time = p_time;
+	result->channels = channels;
+	result->ambisonic = w >= 0;
+	result->rms = std::sqrt(energy / HOP);
+	result->lfe = std::sqrt(lfe_energy / HOP);
+	result->correlation = left_energy * right_energy > 1e-12 ? std::clamp((float)(cross_energy / std::sqrt(left_energy * right_energy)), -1.0f, 1.0f) : 1.0f;
+	result->width = std::sqrt(std::clamp((float)((left_energy + right_energy - 2.0 * cross_energy) / std::max(1e-12, 2.0 * (left_energy + right_energy))), 0.0f, 1.0f));
+	const float novelty = std::max(0.0f, result->rms - envelope * 1.15f);
+	onset = std::max(novelty, onset * 0.88f);
+	result->onset = onset;
+	envelope += (result->rms - envelope) * (result->rms > envelope ? 0.2f : 0.025f);
+	energy = left_energy = right_energy = cross_energy = lfe_energy = 0.0;
+	return result;
+}
+
+void VpxResonance::process(const float *p_samples, int p_count, const AVChannelLayout &p_layout, int p_rate, double p_time, double p_speed, std::vector<Frame> &r_frames) {
+	if (p_count <= 0 || p_rate <= 0 || p_layout.nb_channels < 1) return;
+	if (rate != p_rate || av_channel_layout_compare(&layout, &p_layout) != 0) configure(p_layout, p_rate);
+	if (expected_time >= 0.0 && std::fabs(p_time - expected_time) > 30.0) reset();
+	const double step = 1000.0 * p_speed / rate;
+	for (int i = 0; i < p_count; i++) {
+		const float *frame = p_samples + (int64_t)i * channels;
+		float total = 0.0f;
+		float lfe_total = 0.0f;
+		for (Source &source : sources) {
+			float value = source.channel >= 0 ? frame[source.channel] : (frame[w] + 1.5f * (float)source.direction.dot(Vector3(-frame[y], frame[z], -frame[x]))) * 0.25f;
+			if (!std::isfinite(value)) value = 0.0f;
+			source.ring[position] = value;
+			if (source.lfe) lfe_total += value * value;
+			else total += value * value;
+		}
+		energy += total / std::max(1, (int)sources.size());
+		lfe_energy += lfe_total;
+		const float left = std::isfinite(frame[0]) ? frame[0] : 0.0f;
+		const float right = channels > 1 && std::isfinite(frame[1]) ? frame[1] : left;
+		left_energy += left * left;
+		right_energy += right * right;
+		cross_energy += left * right;
+		position = (position + 1) % LONG_FFT;
+		samples++;
+		if (++hop == HOP) {
+			hop = 0;
+			r_frames.push_back(snapshot(p_time + (i + 1) * step));
+		}
+	}
+	expected_time = p_time + p_count * step;
+}
+#endif
