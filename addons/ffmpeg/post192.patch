+#ifndef VPX_FILE_OPS_H
+#define VPX_FILE_OPS_H
+#ifdef GDEXTENSION
+#include <godot_cpp/classes/ref_counted.hpp>
+#include <godot_cpp/variant/string.hpp>
+using namespace godot;
+class VPXFileOps : public RefCounted {
+	GDCLASS(VPXFileOps, RefCounted);
+protected:
+	static void _bind_methods();
+public:
+	static Error rename_no_replace(const String &p_from, const String &p_to);
+};
+#endif
