+++ b/vpx_file_ops.cpp
@@ -0,0 +1,61 @@
+#include "vpx_file_ops.h"
+#ifdef GDEXTENSION
+#include <godot_cpp/core/class_db.hpp>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+Error VPXFileOps::rename_no_replace(const String &p_from, const String &p_to) {
+	if (p_from.is_empty() || p_to.is_empty()) {
+		return ERR_INVALID_PARAMETER;
+	}
+	for (const String *path : { &p_from, &p_to }) {
+		for (int i = 0; i < path->length(); i++) {
+			if ((*path)[i] == 0) {
+				return ERR_INVALID_PARAMETER;
+			}
+		}
+	}
+#ifdef _WIN32
+	const Char16String from = p_from.utf16();
+	const Char16String to = p_to.utf16();
+	if (from.length() >= 3 && from[1] == u':') {
+		wchar_t root[4] = { (wchar_t)from[0], L':', L'\\', 0 };
+		if (GetDriveTypeW(root) == DRIVE_REMOTE) {
+			return ERR_UNAVAILABLE;
+		}
+	}
+	const DWORD attrs = GetFileAttributesW((const wchar_t *)from.get_data());
+	if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) {
+		return ERR_FILE_BAD_PATH;
+	}
+	if (MoveFileExW((const wchar_t *)from.get_data(), (const wchar_t *)to.get_data(), MOVEFILE_WRITE_THROUGH)) {
+		return OK;
+	}
+	const DWORD error = GetLastError();
+	return error == ERROR_FILE_EXISTS || error == ERROR_ALREADY_EXISTS ? ERR_ALREADY_EXISTS : ERR_FILE_CANT_WRITE;
+#elif defined(__linux__) && defined(SYS_renameat2)
+	struct stat info;
+	if (lstat(p_from.utf8().get_data(), &info) != 0 || !S_ISREG(info.st_mode)) {
+		return ERR_FILE_BAD_PATH;
+	}
+	if (syscall(SYS_renameat2, AT_FDCWD, p_from.utf8().get_data(), AT_FDCWD, p_to.utf8().get_data(), 1) == 0) {
+		return OK;
+	}
+	return errno == EEXIST ? ERR_ALREADY_EXISTS : ERR_FILE_CANT_WRITE;
+#else
+	return ERR_UNAVAILABLE;
+#endif
+}
+
+void VPXFileOps::_bind_methods() {
+	ClassDB::bind_static_method("VPXFileOps", D_METHOD("rename_no_replace", "from", "to"), &VPXFileOps::rename_no_replace);
+}
+#endif
