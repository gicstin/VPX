+		_push_audio_samples((const float *)tempo_frame->data[0], tempo_frame->nb_samples, output_ch_layout.nb_channels, time);
+		tempo_samples_out += tempo_frame->nb_samples;
+		av_frame_unref(tempo_frame);
+	}
+}
