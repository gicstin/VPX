+void VideoDecoder::_drain_tempo() {
+	if (tempo_graph == nullptr || tempo_frame == nullptr) {
+		return;
+	}
+	const int result = av_buffersrc_add_frame_flags(tempo_source, nullptr, 0);
+	if (result < 0 && result != AVERROR_EOF) {
+		return;
+	}
+	while (av_buffersink_get_frame(tempo_sink, tempo_frame) >= 0) {
