+	VpxSpatialAudio::Params params;
+	const auto number = [&p_params](const char *p_key, float p_default, float p_min, float p_max) {
+		const Variant value = p_params.get(String(p_key), p_default);
+		if (value.get_type() != Variant::FLOAT && value.get_type() != Variant::INT) {
+			return p_default;
+		}
+		const float parsed = value;
+		return std::isfinite(parsed) ? CLAMP(parsed, p_min, p_max) : p_default;
+	};
+	const auto flag = [&p_params](const char *p_key, bool p_default) {
+		const Variant value = p_params.get(String(p_key), p_default);
+		return value.get_type() == Variant::BOOL || value.get_type() == Variant::INT ? (bool)value : p_default;
+	};
+	params.lfe_gain = number("lfe_gain", params.lfe_gain, 0.0f, 2.0f);
+	params.bass_db = number("bass_db", params.bass_db, -12.0f, 18.0f);
