+void VpxSpatialAudio::Biquad::set_lowshelf(float p_frequency, float p_rate, float p_gain_db) {
+	const float amplitude = std::pow(10.0f, p_gain_db / 40.0f);
+	const float w = 2.0f * PI_F * p_frequency / p_rate;
+	const float alpha = std::sin(w) / (2.0f * BASS_SHELF_Q);
+	const float cosw = std::cos(w);
+	const float root = 2.0f * std::sqrt(amplitude) * alpha;
+	const float a0 = (amplitude + 1.0f) + (amplitude - 1.0f) * cosw + root;
+	b0 = amplitude * ((amplitude + 1.0f) - (amplitude - 1.0f) * cosw + root) / a0;
+	b1 = 2.0f * amplitude * ((amplitude - 1.0f) - (amplitude + 1.0f) * cosw) / a0;
+	b2 = amplitude * ((amplitude + 1.0f) - (amplitude - 1.0f) * cosw - root) / a0;
+	a1 = -2.0f * ((amplitude - 1.0f) + (amplitude + 1.0f) * cosw) / a0;
+	a2 = ((amplitude + 1.0f) + (amplitude - 1.0f) * cosw - root) / a0;
+}
