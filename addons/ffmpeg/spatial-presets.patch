+static float slew_value(float p_from, float p_to) {
+	const float delta = p_to - p_from;
+	return std::fabs(delta) <= 1e-4f * (1.0f + std::fabs(p_to)) ? p_to : p_from + delta * PARAM_SLEW;
+}
