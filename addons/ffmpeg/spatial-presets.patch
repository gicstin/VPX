+void VpxSpatialAudio::_advance_params() {
+	if (!params_warm) {
+		active = target;
+		params_warm = true;
+	} else {
+		active.lfe_gain = slew_value(active.lfe_gain, target.lfe_gain);
+		active.bass_db = slew_value(active.bass_db, target.bass_db);
+		active.bass_hz = slew_value(active.bass_hz, target.bass_hz);
+		active.surround_level = slew_value(active.surround_level, target.surround_level);
+		active.shadow_strength = slew_value(active.shadow_strength, target.shadow_strength);
+		active.itd_scale = slew_value(active.itd_scale, target.itd_scale);
+		active.rear_depth = slew_value(active.rear_depth, target.rear_depth);
+		active.rear_cutoff = slew_value(active.rear_cutoff, target.rear_cutoff);
+		active.ild = slew_value(active.ild, target.ild);
+		active.classic_shadow = target.classic_shadow;
+		active.linear_delay = target.linear_delay;
+		active.normalize_downmix = target.normalize_downmix;
+	}
+	rear_coefficient = 1.0f - std::exp(-2.0f * PI_F * active.rear_cutoff / (float)sample_rate);
+	const bool shelf_active = std::fabs(active.bass_db) > 0.01f;
+	if (shelf_active && (!bass_on || active.bass_db != bass_applied_db || active.bass_hz != bass_applied_hz)) {
+		if (!bass_on) {
+			bass_shelf[0].reset();
+			bass_shelf[1].reset();
+		}
+		for (int i = 0; i < 2; i++) {
+			bass_shelf[i].set_lowshelf(active.bass_hz, (float)sample_rate, active.bass_db);
+		}
+		bass_applied_db = active.bass_db;
+		bass_applied_hz = active.bass_hz;
+	}
+	bass_on = shelf_active;
+}
