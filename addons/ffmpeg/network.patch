+int VideoDecoder::_interrupt_callback(void *p_opaque) {
+	VideoDecoder *decoder = static_cast<VideoDecoder *>(p_opaque);
+	if (decoder->io_cancelled.load() || decoder->thread_abort.is_set()) {
+		return 1;
+	}
+	const uint64_t deadline = decoder->io_deadline_usec.load();
+	if (deadline != 0 && vpx_ticks_usec() >= deadline) {
+		decoder->io_error.store(AVERROR(ETIMEDOUT));
+		return 1;
+	}
+	return 0;
+}
