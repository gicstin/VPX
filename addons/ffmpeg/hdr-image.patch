+};
+
+static String parse_radiance_header(const uint8_t *p_bytes, size_t p_size, RadianceHeader &r_header) {
+	if (!is_radiance_magic(p_bytes, p_size)) {
+		return "not a Radiance file";
+	}
+	size_t pos = 0;
+	bool blank = false;
+	while (pos < p_size) {
+		size_t end = pos;
+		while (end < p_size && p_bytes[end] != '\n') {
+			end++;
+		}
+		if (end >= p_size) {
+			return "truncated Radiance header";
+		}
+		const std::string line((const char *)p_bytes + pos, end - pos);
+		pos = end + 1;
+		if (blank) {
+			char y_sign = 0, x_sign = 0, y_axis = 0, x_axis = 0;
+			int height = 0, width = 0;
+			if (sscanf(line.c_str(), "%c%c %d %c%c %d", &y_sign, &y_axis, &height, &x_sign, &x_axis, &width) != 6 || y_axis != 'Y' || x_axis != 'X' || x_sign != '+' || (y_sign != '-' && y_sign != '+')) {
+				return "unsupported Radiance orientation: " + String(line.c_str());
+			}
+			if (width <= 0 || height <= 0) {
+				return "invalid Radiance size";
+			}
+			r_header.width = width;
+			r_header.height = height;
+			r_header.flip = y_sign == '+';
+			r_header.data = pos;
+			return String();
+		}
+		if (line.empty()) {
+			blank = true;
+		} else if (line.rfind("FORMAT=", 0) == 0) {
+			if (line.find("32-bit_rle_xyze") != std::string::npos) {
+				r_header.xyz = true;
+			} else if (line.find("32-bit_rle_rgbe") == std::string::npos) {
+				return "unsupported Radiance format: " + String(line.c_str());
+			}
+		}
+	}
+	return "truncated Radiance header";
+}
+
+bool vpx_hdr_size(const String &p_path, int &r_width, int &r_height) {
+	uint8_t head[4096] = {};
+	size_t got = 0;
+	if (!read_head(p_path, head, sizeof(head), got)) {
+		return false;
+	}
+	if (is_radiance_magic(head, got)) {
+		RadianceHeader header;
+		if (!parse_radiance_header(head, got, header).is_empty()) {
+			return false;
+		}
+		r_width = header.width;
+		r_height = header.height;
+		return true;
+	}
+	if (!is_exr_magic(head, got)) {
+		return false;
+	}
+	ExrReader reader;
+	exr_attr_box2i_t window;
+	if (reader.open(p_path) != EXR_ERR_SUCCESS || exr_get_data_window(reader.context, 0, &window) != EXR_ERR_SUCCESS) {
+		return false;
+	}
+	r_width = window.max.x - window.min.x + 1;
+	r_height = window.max.y - window.min.y + 1;
+	return r_width > 0 && r_height > 0;
+}
+
+static void run_jobs(int p_threads, int p_jobs, const std::function<void(std::atomic<int> &)> &p_work) {
+	std::atomic<int> next{ 0 };
+	const int count = std::max(1, std::min(p_threads, p_jobs));
+	std::vector<std::thread> threads;
+	for (int t = 1; t < count; t++) {
+		threads.emplace_back([&]() { p_work(next); });
+	}
+	p_work(next);
+	for (std::thread &thread : threads) {
+		thread.join();
+	}
+}
+
+static int exr_channel_rank(const char *p_name, char p_want) {
+	const char *dot = strrchr(p_name, '.');
+	const char *last = dot != nullptr ? dot + 1 : p_name;
+	if (last[1] != 0 || (last[0] != p_want && last[0] != p_want + ('a' - 'A'))) {
+		return -1;
+	}
+	return dot == nullptr ? 0 : (int)(dot - p_name) + 1;
+}
+
+static String decode_exr(const String &p_path, VpxHdrSink &p_sink, int p_threads) {
+	ExrReader reader;
+	if (reader.open(p_path) != EXR_ERR_SUCCESS) {
+		return "cannot open EXR";
+	}
+	exr_context_t ctx = reader.context;
+	exr_storage_t storage;
+	exr_attr_box2i_t window;
+	const exr_attr_chlist_t *channels = nullptr;
+	if (exr_get_storage(ctx, 0, &storage) != EXR_ERR_SUCCESS || exr_get_data_window(ctx, 0, &window) != EXR_ERR_SUCCESS || exr_get_channels(ctx, 0, &channels) != EXR_ERR_SUCCESS) {
+		return "invalid EXR header";
+	}
+	if (storage != EXR_STORAGE_SCANLINE && storage != EXR_STORAGE_TILED) {
+		return "deep EXR images are not supported";
+	}
+	const int width = window.max.x - window.min.x + 1;
+	const int height = window.max.y - window.min.y + 1;
+	if (width <= 0 || height <= 0) {
+		return "empty EXR data window";
+	}
+	const char wanted[4] = { 'R', 'G', 'B', 'Y' };
+	int picked[4] = { -1, -1, -1, -1 };
+	int ranks[4] = { 1 << 30, 1 << 30, 1 << 30, 1 << 30 };
+	for (int c = 0; c < channels->num_channels; c++) {
+		const exr_attr_chlist_entry_t &entry = channels->entries[c];
+		if (entry.x_sampling != 1 || entry.y_sampling != 1) {
+			continue;
+		}
+		for (int k = 0; k < 4; k++) {
+			const int rank = exr_channel_rank(entry.name.str, wanted[k]);
+			if (rank >= 0 && rank < ranks[k]) {
+				ranks[k] = rank;
+				picked[k] = c;
+			}
+		}
+	}
+	const bool rgb = picked[0] >= 0 && picked[1] >= 0 && picked[2] >= 0;
+	if (!rgb && picked[3] < 0) {
+		return "EXR has no full-resolution R/G/B or Y channels";
+	}
+	int band = 0;
+	int jobs = 0;
+	uint32_t tile_x = 0, tile_y = 0;
+	int32_t tiles_across = 0;
+	if (storage == EXR_STORAGE_SCANLINE) {
+		int32_t lines = 0;
+		if (exr_get_scanlines_per_chunk(ctx, 0, &lines) != EXR_ERR_SUCCESS || lines <= 0) {
+			return "invalid EXR chunk layout";
+		}
+		band = lines;
+		jobs = (height + lines - 1) / lines;
+	} else {
+		exr_tile_level_mode_t level_mode;
+		exr_tile_round_mode_t round_mode;
+		int32_t tiles_down = 0;
+		if (exr_get_tile_descriptor(ctx, 0, &tile_x, &tile_y, &level_mode, &round_mode) != EXR_ERR_SUCCESS || exr_get_tile_counts(ctx, 0, 0, 0, &tiles_across, &tiles_down) != EXR_ERR_SUCCESS) {
+			return "invalid EXR tile layout";
+		}
+		band = (int)tile_y;
+		jobs = tiles_down;
+	}
+	const String begun = p_sink.begin(width, height);
+	if (!begun.is_empty()) {
+		return begun;
+	}
+	std::mutex error_mutex;
+	String error;
+	run_jobs(p_threads, jobs, [&](std::atomic<int> &p_next) {
+		const int planes = rgb ? 3 : 1;
+		std::vector<uint16_t> buffer((size_t)width * band * planes);
+		exr_decode_pipeline_t decoder = EXR_DECODE_PIPELINE_INITIALIZER;
+		bool ready = false;
+		auto decode_chunk = [&](const exr_chunk_info_t &p_info, int p_x, int p_y) -> bool {
+			exr_result_t result = ready ? exr_decoding_update(ctx, 0, &p_info, &decoder) : exr_decoding_initialize(ctx, 0, &p_info, &decoder);
+			if (result != EXR_ERR_SUCCESS) {
+				return false;
+			}
+			for (int c = 0; c < decoder.channel_count; c++) {
+				exr_coding_channel_info_t &channel = decoder.channels[c];
+				channel.decode_to_ptr = nullptr;
+				for (int k = 0; k < 4; k++) {
+					if (rgb == (k == 3) || strcmp(channel.channel_name, channels->entries[picked[k]].name.str) != 0) {
+						continue;
+					}
+					const int plane = rgb ? k : 0;
+					channel.decode_to_ptr = reinterpret_cast<uint8_t *>(buffer.data() + (size_t)plane * width * band + (size_t)p_y * width + p_x);
+					channel.user_pixel_stride = sizeof(uint16_t);
+					channel.user_line_stride = width * (int)sizeof(uint16_t);
+					channel.user_bytes_per_element = sizeof(uint16_t);
+					channel.user_data_type = EXR_PIXEL_HALF;
+				}
+			}
+			if (!ready) {
+				if (exr_decoding_choose_default_routines(ctx, 0, &decoder) != EXR_ERR_SUCCESS) {
+					return false;
+				}
+				ready = true;
+			}
+			return exr_decoding_run(ctx, 0, &decoder) == EXR_ERR_SUCCESS;
+		};
+		while (!p_sink.is_cancelled()) {
+			const int job = p_next.fetch_add(1);
+			if (job >= jobs) {
+				break;
+			}
+			const int first = job * band;
+			const int rows = std::min(band, height - first);
+			bool ok = true;
+			if (storage == EXR_STORAGE_SCANLINE) {
+				exr_chunk_info_t info;
+				ok = exr_read_scanline_chunk_info(ctx, 0, window.min.y + first, &info) == EXR_ERR_SUCCESS && decode_chunk(info, 0, 0);
+			} else {
+				for (int t = 0; t < tiles_across && ok; t++) {
+					exr_chunk_info_t info;
+					ok = exr_read_tile_chunk_info(ctx, 0, t, job, 0, 0, &info) == EXR_ERR_SUCCESS && decode_chunk(info, t * (int)tile_x, 0);
+				}
+			}
+			if (!ok) {
+				std::lock_guard<std::mutex> lock(error_mutex);
+				if (error.is_empty()) {
+					error = vformat("corrupt EXR data near row %d", first);
+				}
+				if (p_sink.cancelled != nullptr) {
+					p_sink.cancelled->store(true);
+				}
+				break;
+			}
+			for (uint16_t &value : buffer) {
+				value = clean_half(value);
+			}
+			for (int r = 0; r < rows; r++) {
+				const uint16_t *line = buffer.data() + (size_t)r * width;
+				if (rgb) {
+					p_sink.row(first + r, line, line + (size_t)width * band, line + (size_t)2 * width * band);
+				} else {
+					p_sink.row(first + r, line, line, line);
+				}
+			}
+		}
+		exr_decoding_destroy(ctx, &decoder);
+	});
+	return error;
+}
+
+static bool radiance_scanline(const uint8_t *p_bytes, size_t p_size, size_t &r_pos, int p_width, uint8_t *r_rgbe) {
+	size_t pos = r_pos;
+	if (p_width >= 8 && p_width < 0x8000 && pos + 4 <= p_size && p_bytes[pos] == 2 && p_bytes[pos + 1] == 2 && !(p_bytes[pos + 2] & 0x80)) {
+		if (((int)p_bytes[pos + 2] << 8 | p_bytes[pos + 3]) != p_width) {
+			return false;
+		}
+		pos += 4;
+		for (int c = 0; c < 4; c++) {
+			int x = 0;
+			while (x < p_width) {
+				if (pos >= p_size) {
+					return false;
+				}
+				int count = p_bytes[pos++];
+				if (count > 128) {
+					count -= 128;
+					if (count > p_width - x || pos >= p_size) {
+						return false;
+					}
+					if (r_rgbe != nullptr) {
+						const uint8_t value = p_bytes[pos];
+						for (int i = 0; i < count; i++) {
+							r_rgbe[(x + i) * 4 + c] = value;
+						}
+					}
+					pos++;
+				} else {
+					if (count == 0 || count > p_width - x || pos + count > p_size) {
+						return false;
+					}
+					if (r_rgbe != nullptr) {
+						for (int i = 0; i < count; i++) {
+							r_rgbe[(x + i) * 4 + c] = p_bytes[pos + i];
+						}
+					}
+					pos += count;
+				}
+				x += count;
+			}
+		}
+		r_pos = pos;
+		return true;
+	}
+	int x = 0;
+	int shift = 0;
+	while (x < p_width) {
+		if (pos + 4 > p_size) {
+			return false;
+		}
+		const uint8_t *pixel = p_bytes + pos;
+		pos += 4;
+		if (pixel[0] == 1 && pixel[1] == 1 && pixel[2] == 1) {
+			if (x == 0) {
+				return false;
+			}
+			const int count = std::min((int)pixel[3] << shift, p_width - x);
+			if (r_rgbe != nullptr) {
+				for (int i = 0; i < count; i++) {
+					memcpy(r_rgbe + (x + i) * 4, r_rgbe + (x - 1) * 4, 4);
+				}
+			}
+			x += count;
+			shift += 8;
+		} else {
+			if (r_rgbe != nullptr) {
+				memcpy(r_rgbe + x * 4, pixel, 4);
+			}
+			x++;
+			shift = 0;
+		}
+	}
+	r_pos = pos;
+	return true;
+}
+
+static bool read_all(const String &p_path, std::vector<uint8_t> &r_bytes) {
+	FILE *file = open_hdr_file(p_path);
+	if (file == nullptr) {
+		return false;
+	}
+	fseek(file, 0, SEEK_END);
+	const long long size = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	if (size <= 0) {
+		fclose(file);
+		return false;
+	}
+	r_bytes.resize((size_t)size);
+	const size_t got = fread(r_bytes.data(), 1, (size_t)size, file);
+	fclose(file);
+	return got == (size_t)size;
+}
+
+static String decode_radiance(const String &p_path, VpxHdrSink &p_sink, int p_threads, int64_t *r_read_usec) {
+	const int64_t begin = hdr_usec();
+	std::vector<uint8_t> bytes;
+	if (!read_all(p_path, bytes)) {
+		return "cannot read file";
+	}
+	if (r_read_usec != nullptr) {
+		*r_read_usec = hdr_usec() - begin;
+	}
+	RadianceHeader header;
+	const String parsed = parse_radiance_header(bytes.data(), bytes.size(), header);
+	if (!parsed.is_empty()) {
+		return parsed;
+	}
+	const int width = header.width;
+	const int height = header.height;
+	std::vector<size_t> offsets((size_t)height + 1);
+	size_t pos = header.data;
+	for (int y = 0; y < height; y++) {
+		offsets[y] = pos;
+		if (!radiance_scanline(bytes.data(), bytes.size(), pos, width, nullptr)) {
+			return vformat("corrupt Radiance data at row %d", y);
+		}
+	}
+	const String begun = p_sink.begin(width, height);
+	if (!begun.is_empty()) {
+		return begun;
+	}
+	float scales[256];
+	for (int e = 0; e < 256; e++) {
+		scales[e] = e == 0 ? 0.0f : std::ldexp(1.0f, e - 136);
+	}
+	const int jobs = (height + RADIANCE_BAND - 1) / RADIANCE_BAND;
+	run_jobs(p_threads, jobs, [&](std::atomic<int> &p_next) {
+		std::vector<uint8_t> rgbe((size_t)width * 4);
+		std::vector<float> planes((size_t)width * 3);
+		std::vector<uint16_t> halves((size_t)width * 3);
+		float *r = planes.data();
+		float *g = r + width;
+		float *b = g + width;
+		while (!p_sink.is_cancelled()) {
+			const int job = p_next.fetch_add(1);
+			if (job >= jobs) {
+				break;
+			}
+			const int last = std::min(height, (job + 1) * RADIANCE_BAND);
+			for (int y = job * RADIANCE_BAND; y < last; y++) {
+				size_t at = offsets[y];
+				radiance_scanline(bytes.data(), bytes.size(), at, width, rgbe.data());
+				for (int x = 0; x < width; x++) {
+					const uint8_t *p = rgbe.data() + (size_t)x * 4;
+					const float scale = scales[p[3]];
+					r[x] = p[0] * scale;
+					g[x] = p[1] * scale;
+					b[x] = p[2] * scale;
+				}
+				if (header.xyz) {
+					for (int x = 0; x < width; x++) {
+						const float cx = r[x], cy = g[x], cz = b[x];
+						r[x] = 3.2404542f * cx - 1.5371385f * cy - 0.4985314f * cz;
+						g[x] = -0.9692660f * cx + 1.8760108f * cy + 0.0415560f * cz;
+						b[x] = 0.0556434f * cx - 0.2040259f * cy + 1.0572252f * cz;
+					}
+				}
+				for (size_t i = 0; i < halves.size(); i++) {
+					halves[i] = vpx_half_from_float(planes[i]);
+				}
+				p_sink.row(header.flip ? height - 1 - y : y, halves.data(), halves.data() + width, halves.data() + (size_t)2 * width);
+			}
+		}
+	});
+	return String();
+}
+
+String vpx_decode_hdr(const String &p_path, VpxHdrSink &p_sink, int p_threads, int64_t *r_read_usec) {
+	uint8_t head[4] = {};
+	size_t got = 0;
+	if (!read_head(p_path, head, sizeof(head), got)) {
+		return "cannot read file";
+	}
+	if (is_exr_magic(head, got)) {
+		return decode_exr(p_path, p_sink, p_threads);
+	}
+	if (is_radiance_magic(head, got)) {
+		return decode_radiance(p_path, p_sink, p_threads, r_read_usec);
+	}
+	return "not an EXR or Radiance HDR file";
+}
+
+class PreviewSink : public VpxHdrSink {
+public:
+	int target_width = 0;
+	int source_width = 0;
+	int source_height = 0;
+	int factor = 1;
+	int width = 0;
+	int height = 0;
+	std::vector<float> sums;
+	std::mutex locks[PREVIEW_LOCKS];
+
+	String begin(int p_width, int p_height) override {
+		source_width = p_width;
+		source_height = p_height;
+		factor = std::max(1, (p_width + target_width - 1) / target_width);
+		width = (p_width + factor - 1) / factor;
+		height = (p_height + factor - 1) / factor;
+		sums.assign((size_t)width * height * 3, 0.0f);
+		return String();
+	}
+
+	void row(int p_y, const uint16_t *p_r, const uint16_t *p_g, const uint16_t *p_b) override {
+		const int y = p_y / factor;
+		const uint16_t *values[3] = { p_r, p_g, p_b };
+		std::vector<float> line((size_t)width * 3, 0.0f);
+		for (int x = 0; x < width; x++) {
+			const int last = std::min((x + 1) * factor, source_width);
+			for (int s = x * factor; s < last; s++) {
+				for (int c = 0; c < 3; c++) {
+					line[(size_t)x * 3 + c] += vpx_float_from_half(values[c][s]);
+				}
+			}
+		}
+		std::lock_guard<std::mutex> lock(locks[y % PREVIEW_LOCKS]);
+		float *dst = sums.data() + (size_t)y * width * 3;
+		for (int i = 0; i < width * 3; i++) {
+			dst[i] += line[i];
+		}
+	}
+};
+
+String vpx_write_hdr_preview(const String &p_path, const String &p_output, int p_width, float p_exposure) {
+	PreviewSink sink;
+	sink.target_width = std::max(p_width, 16);
+	const int threads = std::clamp((int)std::thread::hardware_concurrency() / 4, 1, PREVIEW_THREADS);
+	const String error = vpx_decode_hdr(p_path, sink, threads, nullptr);
+	if (!error.is_empty()) {
+		return error;
+	}
+	PackedByteArray pixels;
+	pixels.resize((int64_t)sink.width * sink.height * 3);
+	uint8_t *out = pixels.ptrw();
+	for (int y = 0; y < sink.height; y++) {
+		const int rows = std::min(sink.factor, sink.source_height - y * sink.factor);
+		for (int x = 0; x < sink.width; x++) {
+			const int cols = std::min(sink.factor, sink.source_width - x * sink.factor);
+			const float *sum = sink.sums.data() + ((size_t)y * sink.width + x) * 3;
+			const float norm = 1.0f / (float)(rows * cols);
+			float r = sum[0] * norm, g = sum[1] * norm, b = sum[2] * norm;
+			vpx_hdr_tonemap(r, g, b, p_exposure);
+			const float values[3] = { r, g, b };
+			for (int c = 0; c < 3; c++) {
+				const float v = values[c];
+				const float encoded = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.0f / 2.4f) - 0.055f;
+				out[((size_t)y * sink.width + x) * 3 + c] = (uint8_t)std::clamp((int)std::lround(encoded * 255.0f), 0, 255);
+			}
+		}
+	}
+	Ref<Image> image = Image::create_from_data(sink.width, sink.height, false, Image::FORMAT_RGB8, pixels);
+	if (image.is_null()) {
+		return "cannot build preview";
+	}
+	return image->save_jpg(p_output, 0.9f) == OK ? String() : String("cannot save preview");
+}
