+
+static const float HALF_MAX = 65504.0f;
+static const int RADIANCE_BAND = 32;
+static const int PREVIEW_LOCKS = 64;
+static const int PREVIEW_THREADS = 4;
+
+static inline int64_t hdr_usec() {
+	return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static inline uint32_t float_bits(float p_value) {
+	uint32_t bits;
+	memcpy(&bits, &p_value, 4);
+	return bits;
+}
+
+static inline float bits_float(uint32_t p_bits) {
+	float value;
+	memcpy(&value, &p_bits, 4);
+	return value;
+}
+
+uint16_t vpx_half_from_float(float p_value) {
+	float v = p_value > 0.0f ? p_value : 0.0f;
+	v = v < HALF_MAX ? v : HALF_MAX;
+	uint32_t f = float_bits(v);
+	if (f < (113u << 23)) {
+		const float magic = bits_float(((127 - 15) + (23 - 10) + 1) << 23);
+		return (uint16_t)(float_bits(bits_float(f) + magic) - float_bits(magic));
+	}
+	const uint32_t odd = (f >> 13) & 1;
+	f += ((uint32_t)(15 - 127) << 23) + 0xfff;
+	f += odd;
+	return (uint16_t)(f >> 13);
+}
+
+static inline uint16_t clean_half(uint16_t p_half) {
+	if (p_half & 0x8000) {
+		return 0;
+	}
+	if ((p_half & 0x7c00) == 0x7c00) {
+		return (p_half & 0x3ff) ? 0 : 0x7bff;
+	}
+	return p_half;
+}
+
+float vpx_float_from_half(uint16_t p_half) {
+	const uint32_t shifted = 0x7c00u << 13;
+	uint32_t o = (uint32_t)(p_half & 0x7fff) << 13;
+	const uint32_t exponent = shifted & o;
+	o += (uint32_t)(127 - 15) << 23;
+	if (exponent == shifted) {
+		o += (uint32_t)(128 - 16) << 23;
+	} else if (exponent == 0) {
+		o += 1u << 23;
+		o = float_bits(bits_float(o) - bits_float(113u << 23));
+	}
+	o |= (uint32_t)(p_half & 0x8000) << 16;
+	return bits_float(o);
+}
+
+void vpx_hdr_tonemap(float &r_r, float &r_g, float &r_b, float p_exposure) {
+	const float wr = 0.2126f, wg = 0.7152f, wb = 0.0722f;
+	float r = std::max(r_r, 0.0f) * p_exposure;
+	float g = std::max(r_g, 0.0f) * p_exposure;
+	float b = std::max(r_b, 0.0f) * p_exposure;
+	const float luma = r * wr + g * wg + b * wb;
+	const float mapped = luma * (1.0f + luma / 36.0f) / (1.0f + luma);
+	const float scale = mapped / std::max(luma, 1e-6f);
+	r *= scale;
+	g *= scale;
+	b *= scale;
+	const float peak = std::max(r, std::max(g, b));
+	if (peak > 1.0f) {
+		r /= peak;
+		g /= peak;
+		b /= peak;
+		const float lost = std::min(mapped, 1.0f) - (r * wr + g * wg + b * wb);
+		const float room = (1.0f - r) * wr + (1.0f - g) * wg + (1.0f - b) * wb;
+		const float t = room > 1e-6f ? std::clamp(lost / room, 0.0f, 1.0f) : 0.0f;
+		r += (1.0f - r) * t;
+		g += (1.0f - g) * t;
+		b += (1.0f - b) * t;
+	}
+	r_r = std::min(r, 1.0f);
+	r_g = std::min(g, 1.0f);
+	r_b = std::min(b, 1.0f);
+}
+
+static FILE *open_hdr_file(const String &p_path) {
+#ifdef _WIN32
+	return _wfopen(reinterpret_cast<const wchar_t *>(p_path.utf16().get_data()), L"rb");
+#else
+	return fopen(p_path.utf8().get_data(), "rb");
+#endif
+}
+
+static bool read_head(const String &p_path, uint8_t *r_bytes, size_t p_size, size_t &r_got) {
+	FILE *file = open_hdr_file(p_path);
+	if (file == nullptr) {
+		return false;
+	}
+	r_got = fread(r_bytes, 1, p_size, file);
+	fclose(file);
+	return true;
+}
+
+static bool is_exr_magic(const uint8_t *p_bytes, size_t p_size) {
+	return p_size >= 4 && p_bytes[0] == 0x76 && p_bytes[1] == 0x2f && p_bytes[2] == 0x31 && p_bytes[3] == 0x01;
+}
+
+static bool is_radiance_magic(const uint8_t *p_bytes, size_t p_size) {
+	return p_size >= 2 && p_bytes[0] == '#' && p_bytes[1] == '?';
+}
+
+bool vpx_is_hdr_path(const String &p_path) {
+	uint8_t head[4] = {};
+	size_t got = 0;
+	return read_head(p_path, head, sizeof(head), got) && (is_exr_magic(head, got) || is_radiance_magic(head, got));
+}
+
+static void exr_quiet(exr_const_context_t, exr_result_t, const char *) {
+}
+
+struct ExrReader {
+	exr_context_t context = nullptr;
+
+	~ExrReader() {
+		if (context != nullptr) {
+			exr_finish(&context);
+		}
+	}
+
+	exr_result_t open(const String &p_path) {
+		exr_context_initializer_t init = EXR_DEFAULT_CONTEXT_INITIALIZER;
+		init.error_handler_fn = exr_quiet;
+		return exr_start_read(&context, p_path.utf8().get_data(), &init);
+	}
+};
