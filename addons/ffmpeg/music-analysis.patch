+	ClassDB::bind_method(D_METHOD("is_done"), &VPXMusicAnalysis::is_done);
+	ClassDB::bind_method(D_METHOD("get_progress"), &VPXMusicAnalysis::get_progress);
+	ClassDB::bind_method(D_METHOD("get_error"), &VPXMusicAnalysis::get_error);
+	ClassDB::bind_method(D_METHOD("get_result"), &VPXMusicAnalysis::get_result);
+	ClassDB::bind_method(D_METHOD("analyze_samples", "samples", "rate"), &VPXMusicAnalysis::analyze_samples);
+	ClassDB::bind_method(D_METHOD("get_version"), &VPXMusicAnalysis::get_version);
+}
+
+static PackedFloat32Array packed(const std::vector<float> &p_values) {
+	PackedFloat32Array result;
+	result.resize((int64_t)p_values.size());
+	if (!p_values.empty()) {
+		memcpy(result.ptrw(), p_values.data(), p_values.size() * sizeof(float));
+	}
+	return result;
+}
+
+Dictionary VPXMusicAnalysis::to_dictionary(const VPXMusicMap &p_map) {
+	Dictionary result;
+	result["version"] = VERSION;
+	result["rate"] = p_map.rate;
+	result["duration"] = p_map.duration;
+	result["analysed"] = p_map.analysed;
+	result["tempo"] = p_map.tempo;
+	result["beats"] = packed(p_map.beats);
+	result["beat_strength"] = packed(p_map.beat_strength);
+	result["downbeats"] = packed(p_map.downbeats);
+	result["sections"] = packed(p_map.sections);
+	result["section_energy"] = packed(p_map.section_energy);
+	result["section_group"] = packed(p_map.section_group);
+	result["drops"] = packed(p_map.drops);
+	result["build_starts"] = packed(p_map.build_starts);
+	result["loudness"] = packed(p_map.loudness);
+	result["bass"] = packed(p_map.bass);
+	result["percussive"] = packed(p_map.percussive);
+	result["harmonic"] = packed(p_map.harmonic);
+	result["brightness"] = packed(p_map.brightness);
+	result["onset"] = packed(p_map.onset);
+	result["intensity"] = packed(p_map.intensity);
+	result["novelty"] = packed(p_map.novelty);
+	return result;
+}
+
+bool VPXMusicAnalysis::analyse_file(const std::string &p_path, VPXMusicMap &r_map, std::atomic<bool> *p_cancel, std::atomic<float> *p_progress, std::string &r_error) {
+	Extractor extractor;
+	if (!vpx_music_decode(p_path, extractor, p_cancel, p_progress, r_error)) {
+		return false;
+	}
+	if (!vpx_music_build(extractor, r_map, p_cancel, p_progress)) {
+		r_error = "cancelled";
+		return false;
+	}
+	return true;
+}
+
+bool VPXMusicAnalysis::analyse(const std::vector<float> &p_samples, VPXMusicMap &r_map, std::atomic<bool> *p_cancel, std::atomic<float> *p_progress) {
+	Extractor extractor;
+	extractor.push(p_samples.data(), p_samples.size());
+	return vpx_music_build(extractor, r_map, p_cancel, p_progress);
+}
+
+void VPXMusicAnalysis::_run(std::string p_path) {
+	VPXMusicMap result;
+	std::string failure;
+	const bool ok = analyse_file(p_path, result, &cancelled, &progress, failure);
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		if (ok) {
+			map = std::move(result);
+			has_map = true;
+		} else {
+			error = failure;
+		}
+	}
+	running.store(false);
+	finished.store(true);
+}
+
+void VPXMusicAnalysis::_join() {
+	if (worker.joinable()) {
+		worker.join();
+	}
+}
+
+bool VPXMusicAnalysis::start(const String &p_path) {
+	if (running.load()) {
+		return false;
+	}
+	_join();
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		error.clear();
+		map = VPXMusicMap();
+		has_map = false;
+	}
+	cancelled.store(false);
+	finished.store(false);
+	progress.store(0.0f);
+	running.store(true);
+	worker = std::thread(&VPXMusicAnalysis::_run, this, std::string(p_path.utf8().get_data()));
+	return true;
+}
+
+void VPXMusicAnalysis::cancel() {
+	cancelled.store(true);
+	_join();
+}
+
+void VPXMusicAnalysis::stop() {
+	cancelled.store(true);
+}
+
+String VPXMusicAnalysis::get_error() const {
+	std::lock_guard<std::mutex> lock(mutex);
+	return String::utf8(error.c_str());
+}
+
+Dictionary VPXMusicAnalysis::get_result() const {
+	std::lock_guard<std::mutex> lock(mutex);
+	return has_map ? to_dictionary(map) : Dictionary();
+}
+
+Dictionary VPXMusicAnalysis::analyze_samples(const PackedFloat32Array &p_samples, int p_rate) {
+	std::vector<float> samples(p_samples.ptr(), p_samples.ptr() + p_samples.size());
+	if (p_rate != SAMPLE_RATE && p_rate > 0 && !samples.empty()) {
+		std::vector<float> resampled((size_t)((double)samples.size() * SAMPLE_RATE / p_rate));
+		for (size_t i = 0; i < resampled.size(); i++) {
+			const double position = (double)i * p_rate / SAMPLE_RATE;
+			const size_t index = std::min(samples.size() - 1, (size_t)position);
+			const size_t next = std::min(samples.size() - 1, index + 1);
+			resampled[i] = samples[index] + (samples[next] - samples[index]) * (float)(position - index);
+		}
+		samples.swap(resampled);
+	}
+	VPXMusicMap result;
+	if (!analyse(samples, result, nullptr, nullptr)) {
+		return Dictionary();
+	}
+	return to_dictionary(result);
+}
+
+VPXMusicAnalysis::~VPXMusicAnalysis() {
+	cancelled.store(true);
+	_join();
+}
