+void VPXMusicAnalysis::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("start", "path"), &VPXMusicAnalysis::start);
+	ClassDB::bind_method(D_METHOD("cancel"), &VPXMusicAnalysis::cancel);
+	ClassDB::bind_method(D_METHOD("stop"), &VPXMusicAnalysis::stop);
