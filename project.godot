; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VPX"
config/description="Video Player XR"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Log="*res://scripts/log.gd"
Settings="*res://scripts/settings.gd"
Library="*res://scripts/library.gd"
MediaInfo="*res://scripts/media_info.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[gui]

theme/default_font_size=22

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
rendering_device/staging_buffer/block_size_kb=16384
rendering_device/staging_buffer/max_size_mb=256
rendering_device/staging_buffer/texture_upload_region_size_px=2048
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/environment_blend_mode=2
openxr/foveation_level=0
shaders/enabled=true
